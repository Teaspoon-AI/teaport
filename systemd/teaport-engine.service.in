# teaport-engine — Voxtral STT + Kokoro TTS inference engine (the closed binary).
# Rendered by install.sh: @USER@/@PREFIX@/@ETC@ are substituted at install time;
# ${VARS} are read from @ETC@/engine.env (EnvironmentFile) at runtime.
[Unit]
Description=teaport engine (Voxtral STT + Kokoro TTS)
After=network-online.target
Wants=network-online.target
# Engine stops propagate to the brain (its Requires= on this unit), but nothing
# restarted it afterwards — an engine deploy/build --stop-service left the box
# voice-dead until a manual start (observed live 2026-07-21). Upholds= keeps the
# brain running while the engine is active, restarting it when found stopped.
Upholds=teaport-brain.service

[Service]
Type=simple
User=@USER@
EnvironmentFile=@ETC@/engine.env
# --reprime 1500: each segment after a final starts from the last one's tail
# (teagram-engine#88, teaport#154); engine 1.5 or later.
ExecStart=@PREFIX@/bin/voxtral -d @PREFIX@/models/voxtral --serve ${ENGINE_PORT} --delay ${ENGINE_DELAY} --tts-ctx ${TTS_CTX} --tts-model @PREFIX@/models/kokoro/Kokoro_espeak_F16.gguf --vad --vad-mode 1 --vad-commit hard --reprime 1500
Restart=on-failure
RestartSec=5
# Under memory pressure the kernel kills the process with the highest OOM score, and the
# engine's GPU buffers (~4.3 GB, unswappable) make it the biggest process on an 8 GB box:
# unadjusted it scores close to the OpenClaw gateway, so a growing agent could get the
# engine killed and the box would go silent. -500 puts the voice path (engine, brain, SIP
# gateway, local audio) behind everything else. The offset is half of RAM+swap (11.75 GB
# with the appliance's 16 GB swap file, more than its RAM), so in practice these go only
# once nothing else is left to kill, a leak of their own included. -1000 would exempt them
# outright; nothing needs that.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
