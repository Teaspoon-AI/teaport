# teaport-brain — the Pipecat voice brain (STT->LLM->TTS): the /talk WebSocket on
# :${BRAIN_PORT} and the SIP gateway's phone calls, one process, one session arbiter.
# Rendered by install.sh; ${VARS} come from @ETC@/brain.env. Secrets (the LLM key, the
# OpenClaw token) are read by the brain from ~/.config/teaport at call time, never here.
[Unit]
Description=teaport brain (voice pipeline gateway)
After=network-online.target teaport-engine.service
Wants=network-online.target
Requires=teaport-engine.service

[Service]
Type=simple
User=@USER@
# The SIP gateway's socket (teaport-sip.service's RuntimeDirectory): the brain's SIP
# front-end looks for it and connects whenever the gateway is up. A default box has no
# gateway, and the front-end just waits. brain.env may override it (empty: SIP off).
Environment=TEAPORT_SIP_SOCKET=@SIP_UDS@
# No variable values in a logged traceback (loguru's "diagnose"): a caller id held in
# a local would be printed into the journal. The brain also sets it on its own handler
# (privacy.py); this covers anything that logs before it is installed.
Environment=LOGURU_DIAGNOSE=no
# The XVF3800's LED ring, the phone busy lamp (install.sh install_busy_lamp: the udev rule
# and the group, which exists before this unit is rendered).
SupplementaryGroups=teaport-hw
EnvironmentFile=@ETC@/brain.env
ExecStart=@PREFIX@/venv/bin/teaport-brain --port ${BRAIN_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
