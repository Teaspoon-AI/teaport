# teaport-sip-brain — the SIP brain client (opt-in). Runs the SAME shared voice pipeline
# as teaport-brain (agent_session.build_agent_session), but over the teaport-sip AF_UNIX
# socket instead of the OpenClaw WebSocket. BindsTo the gateway: it exists only to serve a
# live gateway and is stopped with it. Gated on the same @SIP_CONF@ as the gateway, so a
# default box never starts it and a reboot brings it up ONLY if telephony was configured.
# Rendered by install.sh (@USER@/@PREFIX@/@ETC@/@SIP_CONF@/@SIP_UDS@); ${VARS} and secrets
# (the LLM key, the OpenClaw token) come from @ETC@/brain.env + ~/.config/teaport.
[Unit]
Description=teaport SIP brain (voice pipeline over the SIP gateway)
After=teaport-sip.service teaport-engine.service
# BindsTo + the gateway's Upholds= and PartOf= on us: stopped with it, started with it,
# restarted with it — and it with us, including when Restart= below brings us back
# from a crash. Never relaunched on our own under a running gateway (see teaport-sip.service).
BindsTo=teaport-sip.service
ConditionPathExists=@SIP_CONF@

[Service]
Type=simple
User=@USER@
EnvironmentFile=@ETC@/brain.env
# Full-duplex: the gateway's AEC cancels line echo, so the half-duplex input gate (the
# diagnostic that drops caller audio while the bot speaks) stays OFF and barge-in works.
Environment=SIP_HALF_DUPLEX=0
# @SIP_UDS@ is in the gateway unit's RuntimeDirectory (/run/teaport, mode 0750, owned by
# @USER@ — NOT world-writable /tmp). BindsTo the gateway guarantees that dir/socket exists
# while we run; connect_seqpacket also verifies the peer's uid (SO_PEERCRED) as a backstop.
# After= only orders us behind the gateway's fork, not its bind — the brain itself waits
# (bounded) for the socket to appear, so this start does not race PJSUA2's init.
# -u: stdout unbuffered, so the brain's own print()s reach journald as they happen
# rather than in 4 KiB blocks after the fact.
ExecStart=@PREFIX@/venv/bin/python -u -m teaport_brain.sip_server --socket @SIP_UDS@
Restart=always
# PartOf=/Upholds= on the gateway unit (teaport-sip.service) propagate every restart
# job we run into a forced gateway restart+re-REGISTER — that propagation bypasses the
# gateway's OWN Restart=/RestartSec= backoff entirely, since it is a directly-triggered
# job, not routed through it (man systemd.unit). So our own crash-loop cadence is what
# throttles the pair against the SBC's rate limiter; it must match the gateway's floor,
# not race ahead of it with a flat 5 s. Same RestartSec=/RestartSteps=/RestartMaxDelaySec=
# as teaport-sip.service, for the same reason.
RestartSec=15
RestartSteps=6
RestartMaxDelaySec=120

[Install]
WantedBy=multi-user.target
