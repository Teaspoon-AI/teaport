# teaport-sip — SIP telephony gateway (opt-in). The GPL C++/PJSIP binary (separate
# teaport-sip repo, NOT installed by this repo) that bridges a SIP trunk/registrar to
# the brain over an AF_UNIX socket. install.sh lays this unit down but leaves it INERT:
# ConditionPathExists gates it on @SIP_CONF@ — the credentials .conf that
# `teaport sip configure` writes (mode 600) only after a successful test-register — so a
# default (unconfigured) box never binds a SIP port, and a reboot auto-starts telephony
# ONLY if it was configured. Rendered by install.sh (@USER@/@SIP_GATEWAY@/@SIP_CONF@).
#
# This unit, not a hand launch, is what keeps the phone line up: the appliance ran the
# gateway and the SIP brain from a shell script against a .conf in /tmp, and every
# reboot silently took the line offline until someone noticed and re-ran it (#41).
[Unit]
Description=teaport SIP gateway (PJSIP trunk -> brain over UDS)
After=network-online.target teaport-engine.service
Wants=network-online.target
# Opt-in gate: no config, no telephony. `teaport sip configure` writes it + enables us.
ConditionPathExists=@SIP_CONF@
# The gateway auto-answers, so a gateway without a brain answers calls into dead air.
# Upholds= starts the brain whenever this unit is up and finds it inactive or failed —
# the same tie the engine unit keeps on teaport-brain. The brain's own BindsTo= on this
# unit closes the loop the other way (it stops with us), and a `systemctl restart`
# here propagates to it, so the pair always restarts TOGETHER: the echo canceller
# references the brain's playout, and a brain relaunched under a running gateway left
# the canceller eating the caller's speech (STT decoded 0 chars, live 2026-09-03).
Upholds=teaport-sip-brain.service

[Service]
Type=simple
User=@USER@
# The gateway<->brain rendezvous socket lives HERE, not in world-writable /tmp: systemd
# creates /run/teaport owned by @USER@ at mode 0750 before ExecStart, so no other local
# user can pre-bind (squat) the socket to hijack a call. Removed when the unit stops
# (default preserve=no), so each start gets a clean dir and the gateway binds fresh. The
# brain unit connects to the same path — it runs as the same @USER@, so it traverses 0750.
RuntimeDirectory=teaport
RuntimeDirectoryMode=0750
ExecStart=@SIP_GATEWAY@ @SIP_CONF@
Restart=always
# A crash loop must not hammer the registrar: every start is a REGISTER, and an SBC
# that sees one every 5 s can rate-limit the trunk. Back off 5 s -> 2 min over six
# restarts (RestartSteps=/RestartMaxDelaySec= need systemd 254; older ones log an
# "unknown lvalue" warning and keep the flat 5 s).
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=120

[Install]
WantedBy=multi-user.target
