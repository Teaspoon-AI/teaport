#!/bin/sh
# sudoers-sync [RUN_USER] -- the run user's root helpers: the sudoers lines that name them,
# and the Wi-Fi setup polkit rule narrowed to what is left to it (#60).
#
# The config page writes /etc/teaport/*.env and restarts teaport-* units, as root, through
# one script and nothing else: /usr/lib/teaport/config_apply.py. Wi-Fi setup and the config
# page change the box's Wi-Fi through another, /usr/lib/teaport/wifi_apply.py. Both are
# root-owned and run by the SYSTEM python, never the venv's interpreter. The lines name the
# run user, who the package does not know: it is the User= of the rendered teaport-brain
# unit, or the argument (install.sh passes it right after it renders the unit, on a first
# install where the unit did not exist yet when the package was configured).
#
# The polkit rule (/etc/polkit-1/rules.d/50-teaport-wifi-setup.rules, rendered by install.sh
# where the box has Wi-Fi setup) once gave that user NetworkManager's network-control and
# settings.modify.system; wifi_apply.py does that work now. A rule that is there is
# rewritten from the package's template (wifi.scan only) once the lines are in, never
# before: without them the Wi-Fi could not be changed at all.
#
# Run by postinst and by install.sh; one writer, so the helper paths in the lines, in
# config_ui.APPLY_HELPER and in wifi.HELPER change together with the package. Lines that
# do not pass visudo are not installed: a malformed sudoers.d entry locks sudo for
# everyone, which on a headless box is a reinstall.
set -eu
f=/etc/sudoers.d/teaport-config
helper=/usr/lib/teaport/config_apply.py
wifi=/usr/lib/teaport/wifi_apply.py
rules=/etc/polkit-1/rules.d/50-teaport-wifi-setup.rules
rules_tpl=/usr/lib/teaport/50-teaport-wifi-setup.rules.in
user="${1:-}"
if [ -z "$user" ]; then
  user="$(systemctl show -p User --value teaport-brain.service 2>/dev/null || true)"
fi
# No unit yet, or a root brain: nothing to grant (root needs no line).
if [ -z "$user" ] || [ "$user" = root ]; then exit 0; fi
case "$user" in
  *[!A-Za-z0-9._-]*|-*) echo "sudoers-sync: refusing the user name '$user'" >&2; exit 1 ;;
esac
for h in "$helper" "$wifi"; do
  [ -f "$h" ] || { echo "sudoers-sync: $h is missing" >&2; exit 1; }
done
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
printf '%s\n' \
  "# teaport: the config page writes /etc/teaport/*.env and restarts teaport-* units" \
  "# through this one root-owned script and nothing else. See config_apply.py." \
  "$user ALL=(root) NOPASSWD: /usr/bin/python3 $helper *" \
  "# teaport: Wi-Fi setup and the config page change the Wi-Fi through this one, which" \
  "# takes Wi-Fi requests only. See wifi_apply.py." \
  "$user ALL=(root) NOPASSWD: /usr/bin/python3 $wifi *" > "$tmp"
if ! { [ -f "$f" ] && cmp -s "$tmp" "$f"; }; then
  visudo -cf "$tmp" >/dev/null || { echo "sudoers-sync: the generated lines do not pass visudo; $f left as it was" >&2; exit 1; }
  install -m 0440 -o root -g root "$tmp" "$f"
fi
if [ -f "$rules" ] && [ -f "$rules_tpl" ]; then
  sed -e "s#@USER@#$user#g" "$rules_tpl" > "$tmp"
  cmp -s "$tmp" "$rules" || install -m 0644 -o root -g root "$tmp" "$rules"
fi
