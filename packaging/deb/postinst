#!/bin/sh
# postinst for teaport-brain (#60). `configure` runs after every install and upgrade,
# and on a downgrade (a rollback is `apt install` of the kept .deb).
#
#  1. The sudoers line the config page needs (sudoers-sync).
#  2. /opt/teaport/venv, the path units rendered before this package name, becomes a link
#     to /opt/teaport/brain, so such a unit keeps working until install.sh re-renders it.
#     A real directory there (the pre-uv venv) is left alone.
#  3. (wifi-setup is restarted with the others: it runs this package's code, and a module
#     imported late from a replaced tree would fail. An onboarding session in progress ends.)
#     The brain comes up on the new files: its units are restarted if they are loaded. The
#     brain unit is Type=notify, so `systemctl restart` returns only when the new brain
#     has bound its port (or fails, after TimeoutStartSec), and a failure fails this
#     script: dpkg leaves the package half-configured, which install.sh reads as "roll
#     back to the .deb that was installed before". The SIP gateway is not restarted: the
#     brain reconnects to it, and a call in progress is replayed to it (teaport-sip#3).
set -e
[ "$1" = configure ] || exit 0

# A line that cannot be written (no visudo, a user name sudoers would reject) is the config
# page's problem, not the brain's: it must not leave new files unpacked under a brain that
# was never restarted, so it is said and the script goes on. install.sh says it again.
/usr/lib/teaport/sudoers-sync || echo "teaport-brain: the config page's sudoers line was not written (/usr/lib/teaport/sudoers-sync)" >&2

if [ ! -e /opt/teaport/venv ] || [ -L /opt/teaport/venv ]; then
  if [ -d /opt/teaport ]; then ln -sfn /opt/teaport/brain /opt/teaport/venv; fi
fi

# The pre-package installer's CLI, if it is still there, comes before /usr/bin/teaport on
# PATH and reads this package's brain as one of its own old venvs, so `teaport doctor`
# would misreport it. install.sh retires it; a plain apt install does not. Said, not removed:
# it may be the operator's own wrapper.
if [ -e /usr/local/bin/teaport ]; then
  echo "teaport-brain: /usr/local/bin/teaport shadows the package's /usr/bin/teaport. If it is the old installer's CLI, run ./install.sh --only brain from a checkout, or remove it" >&2
fi

# Not under systemd (a container, a chroot, an image build): nothing to restart.
[ -d /run/systemd/system ] || exit 0
for unit in teaport-brain.service teaport-local-audio.service teaport-wifi-setup.service; do
  # try-restart: only a unit that is running. The wifi unit is on demand and the audio
  # bridge is optional; a brain that is enabled but stopped is the operator's to start.
  systemctl cat "$unit" >/dev/null 2>&1 || continue
  systemctl try-restart "$unit"
done
