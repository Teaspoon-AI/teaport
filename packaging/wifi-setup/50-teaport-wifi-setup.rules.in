// teaport Wi-Fi setup: lets the teaport run user scan for Wi-Fi networks (a fresh scan
// needs NetworkManager's wifi.scan), and nothing else. Rendered by install.sh, and
// rewritten by the teaport-brain package (packaging/deb/sudoers-sync) on a box where an
// earlier one granted more.
//
// Every change to the box's networking — the setup network, joining and saving a Wi-Fi
// network, putting the old one back — goes through /usr/lib/teaport/wifi_apply.py as root,
// behind the sudoers line sudoers-sync writes, which takes Wi-Fi requests only and checks
// them (brain/teaport_brain/wifi_apply.py). The run user is the one the agent runs as:
// this rule once also gave it network-control and settings.modify.system, that is every
// system profile (Ethernet, DNS, routes, proxies, VPN), the secrets saved in them, and
// every device up or down. polkit sees a user, not a unit, so whatever is granted here
// is the agent's too.
polkit.addRule(function(action, subject) {
    if (subject.user == "@USER@" &&
            action.id == "org.freedesktop.NetworkManager.wifi.scan") {
        return polkit.Result.YES;
    }
});
