# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
build/
dist/

# Node (plugin)
node_modules/
*.tsbuildinfo

# Local env / secrets — never commit
.env
*.local
*.key

# Downloaded artifacts (the installer fetches these; never in git)
models/
*.gguf
*.safetensors

# Generated at runtime, not shipped: thinking_sound synthesizes its typing bed on first
# use and caches it next to the module. Any test that builds an agent session creates
# it, so it would otherwise land in someone's commit as a 288 KB binary.
brain/teaport_brain/assets/

# OS
.DS_Store
