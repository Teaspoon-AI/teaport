#!/usr/bin/env bash
#
# teaport — operator CLI for a teaport appliance.
#
#   teaport status                three services + ports + memory at a glance
#   teaport doctor [--fix]        health sweep with fix hints (--fix restarts dead units)
#   teaport update [--check]      diff installed vs the release manifest; apply what changed
#   teaport logs [engine|brain|sip|sip-brain]   journalctl wrapper (defaults to brain; passes -f/-n through)
#   teaport sip <cmd>             opt-in SIP telephony: configure | status | aec | restart | disable
#
# Thin wrapper over systemd + the release manifest, reading the layout install.sh
# produces: /opt/teaport (bin/models/venv/manifest.json), /etc/teaport/*.env,
# ~/.config/teaport (secrets).
#
set -euo pipefail

PREFIX="${TEAPORT_PREFIX:-/opt/teaport}"
ETC="${TEAPORT_ETC:-/etc/teaport}"
SECRETS="${TEAPORT_SECRETS_DIR:-$HOME/.config/teaport}"
MANIFEST_URL="${TEAPORT_MANIFEST_URL:-https://get.teaspoon.tech/manifest/stable.json}"
ENGINE_PORT="${TEAPORT_ENGINE_PORT:-8000}"
BRAIN_PORT="${TEAPORT_BRAIN_PORT:-7861}"
# SIP telephony (opt-in). The credentials .conf the wizard writes + the two units gate on
# (ConditionPathExists); the GPL gateway binary (separate teaport-sip repo); the AF_UNIX
# socket the gateway and SIP brain meet on — in the units' RuntimeDirectory (/run/teaport,
# mode 0750), NOT world-writable /tmp, so no other local user can squat it. All overridable.
SIP_CONF="${TEAPORT_SIP_CONF:-$SECRETS/teaport-sip.conf}"
SIP_GATEWAY="${TEAPORT_SIP_GATEWAY:-$HOME/teaport-sip/build/teaport-sip}"
SIP_UDS="${TEAPORT_SIP_UDS:-/run/teaport/teaport-sip.sock}"

GREEN='1;32'; RED='1;31'; YEL='1;33'
c()    { printf '\033[%sm%s\033[0m' "$1" "$2"; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
SUDO() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi; }

active()    { local s; s="$(systemctl is-active "$1.service" 2>/dev/null || true)"; printf '%s' "${s:-unknown}"; }
sip_enabled() { systemctl is-enabled --quiet teaport-sip.service 2>/dev/null; }   # telephony turned on
installed() { systemctl cat "$1.service" >/dev/null 2>&1; }
listening() { ss -ltn 2>/dev/null | grep -q ":$1 "; }
envval()    { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1; }   # envval <file> <KEY>
# confval <file> <key> — the gateway .conf. Its parser takes `key=value` AND `key = value`
# (a hand-written conf uses the spaced form), so read it the same way, or `sip status`
# shows `?` for a registrar that is plainly there. LAST match, like the parser (config.h
# overwrites top to bottom): an adopted conf with a duplicated key must show the value
# the gateway is actually running on, not the one it skipped. And cut at the first `#`,
# also like the parser, so `aec = true   # A/B` reads `true` and a `password= # fill in`
# reads empty (and fails the adopt-time key check) instead of passing as a value.
confval()   { sed -nE "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" 2>/dev/null | sed -E 's/#.*$//; s/[[:space:]]+$//' | tail -1; }

fetch() {  # fetch <url-or-path> <dest>
  case "$1" in
    /*|file://*) cp "${1#file://}" "$2" ;;
    *) curl -fsSL --retry 3 -o "$2" "$1" || die "cannot fetch manifest: $1" ;;
  esac
  python3 -c "import json;json.load(open('$2'))" 2>/dev/null || die "manifest is not valid JSON: $1"
}

# ---- status ----------------------------------------------------------------
svc_line()  { local st; st="$(active "$1")"; local col="$RED"; [ "$st" = active ] && col="$GREEN"; printf '  %-28s %s\n' "$1" "$(c "$col" "$st")"; }
port_line() { if listening "$1"; then printf '  %-28s %s\n' "port :$1 ($2)" "$(c "$GREEN" listening)"; else printf '  %-28s %s\n' "port :$1 ($2)" "$(c "$RED" 'not listening')"; fi; }
cmd_status() {
  echo "teaport — status"
  svc_line teaport-engine
  svc_line teaport-brain
  installed teaport-sandbox-recover && svc_line teaport-sandbox-recover
  # The phone line is part of the box once it is turned on; a status that omits it is
  # how "the box is fine" and "nobody can call in" were both true at once (#41). Keyed
  # on the unit being ENABLED, not on the conf: `sip disable` keeps the conf on purpose.
  if sip_enabled; then svc_line teaport-sip; svc_line teaport-sip-brain; fi
  port_line "$ENGINE_PORT" engine
  port_line "$BRAIN_PORT" "brain /talk"
  have free && printf '  %-28s %s\n' memory "$(free -h | awk 'NR==2{print $3" used, "$7" avail / "$2" total"}')"
  printf '  %-28s %s\n' load "$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null || echo n/a)"
}

# ---- doctor ----------------------------------------------------------------
# brain_lock_check — is the live brain venv still the set brain/uv.lock installed?
# install.sh builds every venv with `uv sync --locked` and records what it held
# (teaport-build.json); this diffs the venv against that record. Drift is a hand
# `pip install` into the venv, and it is the failure that used to accumulate unseen for
# weeks: CI tests the lock, the box runs something else. A venv with no record predates
# the uv installer (pip-built) and has never had the lock applied at all.
# Uses doctor's ok/warnc (dynamically scoped from cmd_doctor).
brain_lock_check() {
  local venv="$PREFIX/venv" rec out
  rec="$venv/teaport-build.json"
  [ -x "$venv/bin/python" ] || return 0
  if [ ! -f "$rec" ]; then
    warnc "brain venv has no build record, so brain/uv.lock was never applied to it (a pre-uv pip venv, or a hand build) — rebuild it: install.sh --only brain"
    return 0
  fi
  # -I (isolated) so the venv's python imports its own teaport_brain — not one from a
  # PYTHONPATH the operator has exported, not the cwd. The diff
  # lives in the brain package (teaport_brain.lockcheck), next to the code that wrote
  # the record, so writer and reader cannot normalize names differently.
  # stdout only: the three lines below are parsed by position, and a warning the venv's
  # interpreter prints on stderr would shift them into a false drift report.
  local err; err="$(mktemp)"
  if ! out="$("$venv/bin/python" -I -m teaport_brain.lockcheck diff "$rec" 2>"$err")"; then
    warnc "brain venv: cannot read its build record ($rec): $(tail -n 1 "$err")"
    rm -f "$err"; return 0
  fi
  rm -f "$err"
  local what n detail
  { IFS= read -r what; IFS= read -r n; IFS= read -r detail || true; } <<<"$out"
  if [ "$n" = 0 ]; then ok "brain venv matches its uv.lock build ($what)"
  else warnc "brain venv has drifted from its uv.lock build ($what) — $n change(s): $detail — rebuild: install.sh --only brain"; fi
}

cmd_doctor() {
  local fix=0; [ "${1:-}" = --fix ] && fix=1
  local RC=0
  ok()    { printf '  %s %s\n' "$(c "$GREEN" ✓)" "$*"; }
  warnc() { printf '  %s %s\n' "$(c "$YEL" !)" "$*"; }
  failc() { printf '  %s %s\n' "$(c "$RED" ✗)" "$*"; RC=1; }
  echo "teaport — doctor"
  [ -d "$PREFIX" ] && ok "install root $PREFIX" || failc "not installed — $PREFIX missing (run install.sh)"
  [ -x "$PREFIX/bin/voxtral" ] && ok "engine binary" || failc "engine binary missing ($PREFIX/bin/voxtral)"
  [ -f "$PREFIX/models/voxtral/consolidated.safetensors" ] && ok "STT model" || failc "STT model missing ($PREFIX/models/voxtral)"
  [ -f "$PREFIX/models/kokoro/Kokoro_espeak_F16.gguf" ] && ok "Kokoro TTS model" || failc "Kokoro model missing ($PREFIX/models/kokoro)"
  [ -f "$PREFIX/THIRD_PARTY_NOTICES.txt" ] && ok "engine third-party notices" || failc "engine third-party notices missing ($PREFIX/THIRD_PARTY_NOTICES.txt — re-run install.sh)"
  [ -x "$PREFIX/venv/bin/teaport-brain" ] && ok "brain (teaport-brain)" || failc "brain not installed in $PREFIX/venv"
  brain_lock_check
  have espeak-ng && ok "espeak-ng (engine G2P dep)" || failc "espeak-ng missing — apt install espeak-ng"
  local fpt; fpt="$(envval "$ETC/engine.env" KOKORO_RESERVE_FPT)"
  if [ -z "$fpt" ]; then failc "KOKORO_RESERVE_FPT unset in $ETC/engine.env — the code default (50) OOMs an 8GB box"
  elif [[ "$fpt" =~ ^[0-9]+$ ]] && [ "$fpt" -ge 40 ]; then warnc "KOKORO_RESERVE_FPT=$fpt is high (OOM risk on 8GB; expect 6 or 12)"
  else ok "KOKORO_RESERVE_FPT=$fpt"; fi
  [ -n "$(envval "$ETC/brain.env" LLM_BASE_URL)" ] && ok "LLM_BASE_URL set" || failc "LLM_BASE_URL unset in $ETC/brain.env"
  [ -n "$(envval "$ETC/brain.env" GATEWAY_TOKEN)" ] && ok "GATEWAY_TOKEN set" || warnc "GATEWAY_TOKEN unset — /talk is unauthenticated"
  if [ -f "$SECRETS/llm_key" ] || [ -n "${LLM_API_KEY:-}" ]; then ok "LLM API key present"; else warnc "no LLM key — set LLM_API_KEY or write $SECRETS/llm_key"; fi
  local u st
  for u in teaport-engine teaport-brain; do
    st="$(active "$u")"
    if [ "$st" = active ]; then ok "$u active"
    else
      failc "$u is $st"
      if [ "$fix" = 1 ]; then warnc "  --fix: systemctl restart $u"; SUDO systemctl restart "$u.service" || true; fi
    fi
  done
  listening "$ENGINE_PORT" && ok "engine :$ENGINE_PORT listening" || failc "engine :$ENGINE_PORT not listening (allow ~1min after start)"
  listening "$BRAIN_PORT"  && ok "brain :$BRAIN_PORT listening"  || failc "brain :$BRAIN_PORT not listening"
  # SIP: only once it is turned ON (the unit is enabled) — an unconfigured box has no
  # line to check, and `sip disable` without --purge keeps the conf while the operator
  # means the line to be off, so "conf present" alone must NOT make --fix bring it back.
  # Both units must be up, AND the trunk must be registered: a gateway that is "active"
  # but never got its 200 OK is up-but-unreachable, and that is the state that has
  # actually cost nights (#32). --fix restarts the GATEWAY only: the brain is bound to
  # it and restarts with it, which is the only safe way to restart either.
  if [ -f "$SIP_CONF" ] && ! installed teaport-sip; then
    failc "SIP configured ($SIP_CONF) but the units are not installed — re-run install.sh"
  elif [ -f "$SIP_CONF" ] && ! sip_enabled; then
    ok "SIP telephony off by choice (conf kept, units disabled — teaport sip configure turns it on)"
  elif sip_enabled; then
    [ -x "$SIP_GATEWAY" ] && ok "SIP gateway binary" || failc "SIP gateway binary missing ($SIP_GATEWAY)"
    [ -f "$SIP_CONF" ] || failc "SIP units enabled but $SIP_CONF is missing — the units will not start (teaport sip configure)"
    local sipdown=0
    for u in teaport-sip teaport-sip-brain; do
      st="$(active "$u")"
      if [ "$st" = active ]; then ok "$u active"; else failc "$u is $st"; sipdown=1; fi
    done
    local reg note; reg="$(sip_last_reg)"
    if [ "$sipdown" = 0 ] && sip_reg_ok "$reg"; then ok "SIP trunk registered (${reg#*\[reg\] })"
    elif [ "$sipdown" = 0 ] && [ -z "$reg" ] && ! note="$(sip_journal_note)"; then warnc "SIP trunk: cannot read the registration — $note"
    elif [ "$sipdown" = 0 ] && [ -z "$reg" ]; then warnc "SIP trunk: no registration logged yet this run (allow ~10s after start)"
    elif [ "$sipdown" = 0 ]; then failc "SIP trunk NOT registered — last: ${reg#*\[reg\] }"; sipdown=1
    fi
    if [ "$sipdown" = 1 ] && [ "$fix" = 1 ]; then
      warnc "  --fix: systemctl restart teaport-sip (the SIP brain restarts with it)"
      SUDO systemctl restart teaport-sip.service || true
    fi
  fi
  local nc="$HOME/.local/bin/nemoclaw"; have nemoclaw && nc="$(command -v nemoclaw)"
  if [ -x "$nc" ] && [ -f "$HOME/.nemoclaw/sandboxes.json" ]; then
    local sb; sb="$(python3 -c "import json;d=json.load(open('$HOME/.nemoclaw/sandboxes.json'));print(d.get('defaultSandbox') or '')" 2>/dev/null || true)"
    [ -n "$sb" ] && ok "NemoClaw sandbox: $sb (deeper check: nemoclaw $sb doctor)"
  fi
  echo
  [ "$RC" = 0 ] && c "$GREEN" "doctor: all good"$'\n' || c "$YEL" "doctor: issues above"$'\n'
  return "$RC"
}

# ---- update ----------------------------------------------------------------
cmd_update() {
  local check_only=0; [ "${1:-}" = --check ] && check_only=1
  local local_mf="$PREFIX/manifest.json"
  [ -f "$local_mf" ] || die "not installed: $local_mf missing (run install.sh first)"
  local remote; remote="$(mktemp)"; fetch "$MANIFEST_URL" "$remote"
  echo "teaport — update  (installed  ->  $MANIFEST_URL)"
  local changed
  changed="$(python3 - "$local_mf" "$remote" <<'PY'
import json, sys
a = json.load(open(sys.argv[1])); b = json.load(open(sys.argv[2]))
comp = {"version": (a.get("version"), b.get("version")),
        "engine":  (a.get("engine", {}).get("release"), b.get("engine", {}).get("release")),
        "brain":   (a.get("brain", {}).get("tag"), b.get("brain", {}).get("tag")),
        "plugin":  (a.get("plugin", {}).get("version"), b.get("plugin", {}).get("version"))}
ch = []
for k, (x, y) in comp.items():
    print(f"  {k:8} {x}  {'->' if x != y else '=='}  {y}", file=sys.stderr)
    if x != y: ch.append(k)
print(",".join(ch))
PY
)"
  if [ -z "$changed" ]; then echo "  up to date."; return 0; fi
  echo "  changed: $changed"
  [ "$check_only" = 1 ] && { echo "  (--check) not applying."; return 0; }
  # Applying swaps only changed artifacts + restarts only affected units — the same
  # idempotent, sha-verifying path install.sh runs. Wire it in once get.teaspoon.tech hosts
  # real artifacts; until then, install.sh is the update path — and for the brain alone,
  # `install.sh --only brain` rebuilds just its venv from uv.lock, without the engine.
  die "apply not wired yet — for a brain change run: install.sh --only brain (the brain's venv from uv.lock, nothing else); for anything else re-run install.sh (idempotent; downloads only changed artifacts)."
}

# ---- logs ------------------------------------------------------------------
cmd_logs() {
  local unit=teaport-brain
  case "${1:-}" in
    engine)    unit=teaport-engine;    shift ;;
    brain)     unit=teaport-brain;     shift ;;
    sip)       unit=teaport-sip;       shift ;;
    sip-brain) unit=teaport-sip-brain; shift ;;
  esac
  exec journalctl -u "$unit.service" "$@"
}

# ---- sip --------------------------------------------------------------------
# Opt-in SIP telephony, mirroring the Discord bridge precedent: the units ship inert
# (ConditionPathExists on $SIP_CONF) and this wizard is what turns telephony on. It
# gathers the trunk credentials, test-registers with a THROWAWAY sip_port (never :5060,
# so a live gateway is untouched), and only on a 200 OK writes the real .conf (mode 600)
# and enables the units. `configure --conf FILE` adopts a gateway .conf that already
# exists (a box that ran the gateway by hand, or a conf carried over from another box)
# through the same test-register, so the hand-launch era ends without retyping a
# password into a wizard.
#
# Everything after configure goes through the UNITS — `aec`, `restart`, `doctor --fix`
# all restart teaport-sip and let the bound brain restart with it. The gateway's echo
# canceller references the brain's playout; a brain relaunched under a running gateway
# left it cancelling against a stale reference and eating the caller's speech (STT
# decoded 0 chars, live 2026-09-03). So there is deliberately no "restart the brain
# only" here.

# sip_emit_conf <dest> <sip_port> <uds> <host> <domain> <user> <pass>
# Write a full teaport-sip gateway .conf (key=value). mode 600 — it holds the SIP password.
sip_emit_conf() {
  local dest="$1" port="$2" uds="$3" h="$4" d="$5" u="$6" p="$7"
  ( umask 077
    cat > "$dest" <<EOF
# teaport-sip gateway config — written by 'teaport sip configure'. Keep mode 600.
bind_addr=0.0.0.0
sip_port=$port
id_uri=sip:$u@$d
register=true
registrar_uri=sip:$h
realm=*
username=$u
password=$p
reg_timeout=300
uds_path=$uds
auto_answer=true
aec=true
aec_tail_ms=256
log_level=3
app_log_level=3
EOF
  )
  chmod 600 "$dest"
}

# sip_conf_stage <dest> — the sibling temp both conf writers fill and then rename over
# <dest> (sip_conf_set, sip_adopt_conf); prints its path. A rename installs the TEMP's
# inode, so the temp is given dest's owner, group, mode and ACLs first (`cp --preserve=
# mode` carries the ACLs; the filler's `>` truncates and keeps them): a bare mktemp is
# 0600 and owned by whoever runs this, and a `sudo -E teaport sip aec off` or `sudo -E
# teaport sip configure --conf` left a root:root conf the User= gateway could not open
# at the next restart, and a group member's edit of a 0660 conf left it 0600 and theirs.
# cp does not report an owner it could not keep (a non-root user cannot give a file
# away; exit 0 all the same), so the result is compared, and a conf this user cannot
# rewrite as its owner is refused rather than installed unreadable. A NEW conf is
# mktemp's: 0600 and the invoker's.
sip_conf_stage() {
  local dest="$1" tmp owner
  tmp="$(mktemp "$dest.XXXXXX")" || return 1
  [ -e "$dest" ] || { printf '%s' "$tmp"; return 0; }
  cp --attributes-only --preserve=mode,ownership "$dest" "$tmp" 2>/dev/null || true
  if [ "$(stat -c %u:%g:%a "$tmp")" != "$(stat -c %u:%g:%a "$dest")" ]; then
    rm -f "$tmp"; owner="$(stat -c %U "$dest")"
    printf 'note: %s is %s; a copy written by %s could not keep that — run this as %s or with sudo -E\n' \
      "$dest" "$(stat -c '%U:%G %a' "$dest")" "$(id -un)" "$owner" >&2
    return 1
  fi
  printf '%s' "$tmp"
}

# sip_conf_set <file> <key> <value> — set one key in a gateway .conf. The gateway's
# parser is LAST-wins (config.h reads top to bottom and overwrites), so the LAST
# `key = …` line (spaced or not) is the one rewritten, in place, and any earlier
# duplicates are dropped — rewriting the first would print the change and change
# nothing. Everything else — comments, order, the other keys — is kept byte for byte,
# and a missing key is appended. Written to a sibling temp and renamed over the conf,
# so the conf is either the old bytes or the new ones: writing THROUGH the conf opened
# it O_TRUNC first, and a write that then failed (full filesystem, quota) left a
# 0..N-byte conf with no password while the caller reported it unchanged — and
# ConditionPathExists still saw a file, so the units came up on it at the next boot.
# Returns 1 when the rewrite fails (read-only conf or directory, full filesystem, an
# owner sip_conf_stage cannot keep): under set -e that stops the caller before it
# prints "aec: true -> false" over a file that still says true.
# A rename lands on the LINK when the conf is a symlink (a conf kept in a secrets
# store, say): the CLI's path became a regular file with the new value while the
# target — the copy the operator keeps — still said the old one. Rewrite the target.
sip_conf_target() { readlink -f "$1" 2>/dev/null || printf '%s' "$1"; }
sip_conf_set() {
  local f k="$2" v="$3" tmp n
  f="$(sip_conf_target "$1")"
  [ -w "$f" ] || return 1
  n="$(grep -cE "^[[:space:]]*${k}[[:space:]]*=" "$f" 2>/dev/null || true)"; n="${n:-0}"
  tmp="$(sip_conf_stage "$f")" || return 1
  awk -v k="$k" -v v="$v" -v n="$n" '
    $0 ~ ("^[ \t]*" k "[ \t]*=") { if (++seen == n) print k "=" v; next }
    { print }
    END { if (n == 0) print k "=" v }' "$f" > "$tmp" && mv -f "$tmp" "$f" || { rm -f "$tmp"; return 1; }
}

# The gateway's last registration line ([reg] REGISTERED code=200 OK, or the failure)
# from its CURRENT run only: a 200 from before the last restart says nothing about the
# trunk now. Empty when the unit has never run, has not logged one yet, or the journal
# is not readable by this user (sip_journal_note tells those apart). Newest-first with
# the first match: sip_wait_registered calls this every 0.5 s, and a run at log_level=5
# has thousands of lines that a forward scan re-formats on every tick.
# The default scope, NOT --system: the gateway is a system unit but runs as User=, and
# on a persistent journal journald (SplitMode=uid, the default) files a regular uid's
# lines in user-<uid>.journal whatever unit wrote them — a file --system never opens,
# so every registered trunk read as "not registered yet", for root too. On a volatile
# journal (the box) there is no split and the lines are in the system journal; the
# default scope reads both. Checked on a persistent host (systemd 255): a system unit
# run as a regular uid logged a [reg] 200 that --system showed to nobody, root
# included, and the default scope showed to root, to adm, and to that uid itself.
sip_last_reg() {
  local inv; inv="$(systemctl show -p InvocationID --value teaport-sip.service 2>/dev/null || true)"
  [ -n "$inv" ] || return 0
  journalctl -q "_SYSTEMD_INVOCATION_ID=$inv" -r -o short --no-pager 2>/dev/null | grep -m1 -aE '\[reg\]' || true
}
# Why sip_last_reg may be empty on a running gateway: this user cannot read the file the
# gateway's lines land in. The default scope exits 0 on whatever it could open and only
# hints on stderr, in words that change between versions, so "cannot read" looks
# exactly like "nothing logged yet". Two tests, neither needing this run to have logged
# anything (sip_wait_registered asks right after the restart):
#  - the SYSTEM journal alone opens: adm, systemd-journal, root — they read every file.
#    With none readable journalctl exits non-zero (journal-util.c: -EACCES when no file
#    could be opened); checked on the box (systemd 255) as a user without access.
#  - lines from the gateway's User= uid are visible: on a persistent journal they sit in
#    user-<uid>.journal, which carries a read ACL for that uid, so the operator the units
#    run as reads their own gateway without any group — and that file already holds
#    their login from long before the gateway's first line. On a volatile journal
#    nothing is split out, and a non-member sees none of that uid.
# Prints the remedy (and returns 1) when both fail, so the callers say "cannot read"
# rather than polling for 20 s and reporting a healthy trunk as not registered.
sip_journal_note() {
  local uid
  journalctl --system -q -n 1 -o cat >/dev/null 2>&1 && return 0
  uid="$(id -u "$(systemctl show -p User --value teaport-sip.service 2>/dev/null || true)" 2>/dev/null || true)"
  [ -n "$uid" ] && [ -n "$(journalctl -q -n 1 -o short "_UID=$uid" 2>/dev/null || true)" ] && return 0
  printf 'journal not readable by %s — add them to systemd-journal (sudo usermod -aG systemd-journal %s; re-login) or run: sudo teaport sip status' "$(id -un)" "$(id -un)"
  return 1
}
# Only the gateway's own `[reg] REGISTERED code=200` — case matters: a trunk that
# logs out writes `[reg] unregistered code=200 OK` (call.cpp onRegState), and a loose
# `200 OK` match read that as still registered.
sip_reg_ok() { [ -n "$1" ] && printf '%s' "$1" | grep -qE 'REGISTERED.*code=200'; }

# A TERMINAL rejection, as opposed to the routine 401/Unauthorized digest challenge
# every authenticated REGISTER gets before it re-sends with credentials and lands a
# 200 OK (see sip_probe_register). Without this, a healthy trunk's intermediate 401
# line reads as failure well before the 200 OK a moment later logs it as registered.
# The 403 is anchored to the gateway's own `[reg] unregistered code=403` (call.cpp
# onRegState) or the `SIP/2.0 403` status line: a bare `\b403\b` also matched pjsua's
# log timestamps (HH:MM:SS.403 — the `.` is a word boundary), so a working trunk
# failed the probe on any run where a PJSIP line landed on that millisecond.
SIP_REG_FAIL_RE='code=403\b|SIP/2\.0 403\b|forbidden|registration failed|register failed'
sip_reg_failed() { [ -n "$1" ] && printf '%s' "$1" | grep -qiE "$SIP_REG_FAIL_RE"; }

# Poll sip_last_reg for a 200 for up to $1 seconds. Returns 0 once registered, 1 on
# a logged terminal failure or the timeout. An intermediate line that is neither (e.g.
# a 401 digest challenge) is not a verdict — keep polling for the 200 OK that follows.
sip_wait_registered() {
  local secs="${1:-20}" i reg note
  if ! note="$(sip_journal_note)"; then printf '  %s %s\n' "$(c "$YEL" 'cannot confirm registration:')" "$note"; return 1; fi
  for i in $(seq 1 "$((secs * 2))"); do
    reg="$(sip_last_reg)"
    if sip_reg_ok "$reg"; then printf '  %s %s\n' "$(c "$GREEN" registered)" "${reg#*\[reg\] }"; return 0; fi
    if sip_reg_failed "$reg"; then printf '  %s %s\n' "$(c "$RED" 'NOT registered')" "${reg#*\[reg\] }"; return 1; fi
    sleep 0.5
  done
  printf '  %s no registration logged within %ss — check: teaport logs sip\n' "$(c "$YEL" 'timeout')" "$secs"
  return 1
}

# Run the gateway against a throwaway conf (a test port + socket, never the live :5060)
# and confirm it registers (200 OK). Returns 0 on success; on failure prints the
# gateway's output and returns 1. Owns the end of the throwaway files' life: the conf
# (it holds the password), the socket and the output capture are all removed here, on
# every path, so there is one place that can forget the rm — not one per caller.
sip_probe_register() {
  local testconf="$1" testuds="$2" label="$3" out
  out="$(mktemp)"
  printf 'test-registering %s (throwaway port %s — :5060 untouched)...\n' "$label" "$(confval "$testconf" sip_port)"
  "$SIP_GATEWAY" "$testconf" >"$out" 2>&1 &
  local gpid=$! ok=0 i
  # Ctrl-C during the ~8 s probe: bash starts a background command with SIGINT ignored,
  # so the gateway would outlive this script on :5062, and the conf (with the password)
  # would sit in /tmp. Kill and remove on any exit; INT/TERM leave through the EXIT
  # trap. The CLI sets no other traps, and the normal path clears these once it has
  # cleaned up itself. `|| true` on the kill: set -e applies inside the trap, and a
  # gateway that has already exited (bash reaps it at once — a probe that could not
  # bind :5062 dies within the loop's sleep) makes kill fail, which ended the trap
  # before the rm -f and turned the exit status into 1.
  # shellcheck disable=SC2064  # expanded NOW on purpose: the pid and paths of this probe
  trap "kill $gpid 2>/dev/null || true; rm -f $(printf '%q %q %q' "$testconf" "$testuds" "$out")" EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  for i in $(seq 1 16); do              # ~8s: 16 * 0.5s
    kill -0 "$gpid" 2>/dev/null || break                                  # binary exited early
    if grep -Eiq 'REGISTERED.*200|registration success|200 *OK' "$out"; then ok=1; break; fi
    # Fast-fail ONLY on a terminal rejection (403 Forbidden or an explicit failure line).
    # NOT 401/Unauthorized: that is the routine digest challenge every authenticated
    # REGISTER receives before the client re-sends with credentials and gets 200 OK —
    # matching it here reported a working (digest-auth) trunk as FAILED, which is what
    # essentially every real registrar uses. A genuinely bad credential that never 403s
    # just never logs 200 and falls through to the ~8s timeout below (slower, but correct).
    if grep -Eiq "$SIP_REG_FAIL_RE" "$out"; then break; fi
    sleep 0.5
  done
  kill "$gpid" 2>/dev/null || true; wait "$gpid" 2>/dev/null || true
  rm -f "$testconf" "$testuds"
  if [ "$ok" != 1 ]; then
    printf '%s\n' "$(c "$RED" 'registration FAILED')" >&2
    echo "  the gateway did not report a 200 OK registration within ~8s. Output tail:" >&2
    tail -n 15 "$out" | sed 's/^/    /' >&2
  else
    printf '%s\n' "$(c "$GREEN" 'registration OK (200)')"
  fi
  rm -f "$out"; trap - EXIT INT TERM
  [ "$ok" = 1 ]
}

# A gateway or SIP brain that systemd did not start — the hand launch this CLI
# replaces — holds :5060 and the socket, so the unit we are about to enable would
# fail to bind and sit in a restart loop while the old one keeps answering. Say so
# and stop, rather than kill processes an operator started by hand.
# "Ours" is decided per process from its cgroup, not from `is-active`: right after a
# `sip restart`/`sip aec`, or while `sip disable` is stopping the unit, is-active says
# activating/deactivating and a bare process-name match found the UNIT's own gateway,
# told the operator to pkill it, and aborted configure. Only the SYSTEM units count:
# a gateway under a `systemctl --user` unit of the same name (the dev-era setup the
# unit files were verified with) sits in user.slice/…/teaport-sip.service and holds
# :5060 exactly like a hand launch, so here it is one — an unanchored
# `teaport-sip.service` waved it through and enabled a system unit that could not
# bind. A pid whose cgroup file is gone exited between pgrep and the read (the
# teardown window this check exists for) and is nobody's stray — so the file is read
# ONCE and the match runs on what was read: a `[ -r ]` followed by a separate grep
# let a pid vanish in between, and the failed grep counted it as a stray.
sip_pid_is_unit() { printf '%s\n' "$1" | grep -qE '^[0-9]+:[^:]*:/system\.slice/teaport-sip(-brain)?\.service$'; }
sip_stray_pids() {
  local p cg out=""
  for p in $(pgrep "$@" 2>/dev/null || true); do
    cg="$(cat "/proc/$p/cgroup" 2>/dev/null)" || continue
    sip_pid_is_unit "$cg" || out="$out$p "
  done
  printf '%s' "$out"
}
# The unit name when a cgroup places the process under a `systemctl --user` manager
# (user.slice/user-N.slice/user@N.service/…/<unit>.service), else nothing: a shell's
# hand launch sits in a session-N.scope and does not match.
sip_user_unit_of() { printf '%s\n' "$1" | sed -nE 's#^[0-9]+:[^:]*:/user\.slice/user-[0-9]+\.slice/user@[0-9]+\.service/.*/([^/]+)\.service$#\1#p' | head -1; }
# The remedy names the stray pids and nothing else: this runs while the unit's own
# gateway may be alive, and a `pkill -x teaport-sip` here would take it down mid-call
# and cost a re-REGISTER (the SBC rate limiter the units document). And it has to fit
# the stray: `kill` on a user unit's gateway is undone by its Restart= within seconds
# (configure then refused again with a new pid, forever) — name the unit to disable;
# on a pid that is not ours it is EPERM — say sudo.
sip_refuse_hand_launched() {
  local pids bpids all p cg u owner units="" hint
  pids="$(sip_stray_pids -x teaport-sip)"
  bpids="$(sip_stray_pids -f 'teaport_brain\.sip_server')"
  all="$pids$bpids"; all="${all% }"
  [ -z "$all" ] && return 0
  hint="kill $all"
  for p in $all; do
    cg="$(cat "/proc/$p/cgroup" 2>/dev/null || true)"
    u="$(sip_user_unit_of "$cg")"
    if [ -n "$u" ]; then case " $units " in *" $u "*) ;; *) units="$units $u" ;; esac; fi
    owner="$(stat -c %u "/proc/$p" 2>/dev/null || true)"
    [ -z "$owner" ] || [ "$owner" = "$(id -u)" ] || hint="sudo kill $all"
  done
  [ -n "$units" ] && hint="systemctl --user disable --now$units"
  printf '%s a hand-launched SIP path is running outside systemd:' "$(c "$RED" 'error:')" >&2
  [ -n "$pids" ] && printf ' teaport-sip pid %s' "${pids% }" >&2
  [ -n "$bpids" ] && printf ' sip_server pid %s' "${bpids% }" >&2
  printf '\n  stop it first — %s — then retry.\n' "$hint" >&2
  exit 1
}

# Both probes check the binary BEFORE writing a throwaway conf: it holds the password,
# and a die() on a missing gateway would exit past the rm -f below and leave it in /tmp.
sip_require_gateway() {
  [ -x "$SIP_GATEWAY" ] || die "SIP gateway binary not found/executable: $SIP_GATEWAY (set TEAPORT_SIP_GATEWAY)"
}

# The wizard's probe: emit a throwaway conf from the four answers and run it.
sip_test_register() {
  local host="$1" domain="$2" user="$3" pass="$4" testconf testuds
  sip_require_gateway
  testconf="$(mktemp)"
  testuds="$(mktemp -u --tmpdir teaport-sip-testreg.XXXXXX.sock)"
  sip_emit_conf "$testconf" 5062 "$testuds" "$host" "$domain" "$user" "$pass"
  sip_probe_register "$testconf" "$testuds" "as $user@$domain via $host"
}

# The adopt path's probe: the SAME conf the operator handed us, with only the keys the
# units own swapped (sip_adopt_conf's three) — so what is tested is what will be installed.
sip_test_register_conf() {
  local src="$1" testconf testuds
  sip_require_gateway
  testconf="$(mktemp)"
  testuds="$(mktemp -u --tmpdir teaport-sip-testreg.XXXXXX.sock)"
  # A copy that cannot be prepared (a full or read-only TMPDIR) is not a registration
  # failure: returned as one, the caller told the operator to fix a conf that was never
  # tried.
  { cat "$src" > "$testconf" && sip_adopt_conf_keys "$testconf" 5062 "$testuds"; } \
    || { rm -f "$testconf"; die "could not write the probe copy of $src in ${TMPDIR:-/tmp} — no REGISTER attempted, nothing installed"; }
  sip_probe_register "$testconf" "$testuds" "$(confval "$src" id_uri) via $(confval "$src" registrar_uri)"
}

sip_configure() {
  local host="" domain="" user="" pass="" yes=0 pass_set=0 conf=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --host)     host="${2:-}"; shift 2 ;;
      --domain)   domain="${2:-}"; shift 2 ;;
      --user)     user="${2:-}"; shift 2 ;;
      --password) pass="${2:-}"; pass_set=1; shift 2 ;;
      --conf)     conf="${2:-}"; shift 2 ;;
      --yes|-y)   yes=1; shift ;;
      -h|--help)  echo "usage: teaport sip configure [--host H --domain D --user U --password P] [--yes]"
                  echo "       teaport sip configure --conf FILE     adopt an existing gateway .conf"; return 0 ;;
      *) die "unknown flag: $1 (see: teaport sip configure --help)" ;;
    esac
  done
  if [ -n "$conf" ]; then sip_adopt_conf "$conf"; return; fi
  # Prompt for anything still missing; --yes forbids prompting (headless/CI).
  if [ -z "$host" ]; then [ "$yes" = 1 ] && die "--host is required with --yes"; read -r -p 'SIP registrar / SBC host: ' host; fi
  if [ -z "$domain" ]; then
    if [ "$yes" = 1 ]; then domain="$host"; else read -r -p "SIP domain [$host]: " domain; [ -z "$domain" ] && domain="$host"; fi
  fi
  if [ -z "$user" ]; then [ "$yes" = 1 ] && die "--user is required with --yes"; read -r -p 'SIP username: ' user; fi
  if [ "$pass_set" = 0 ]; then [ "$yes" = 1 ] && die "--password is required with --yes"; read -r -s -p 'SIP password: ' pass; echo; fi
  [ -n "$host" ] && [ -n "$user" ] && [ -n "$domain" ] || die "host, domain and user are all required"
  sip_refuse_hand_launched

  # Test-register FIRST: write nothing / leave the units disabled if it fails.
  sip_test_register "$host" "$domain" "$user" "$pass" \
    || die "SIP registration failed — config not written, units left disabled. Fix the credentials/registrar and retry."

  mkdir -p "$SECRETS"; chmod 700 "$SECRETS" 2>/dev/null || true
  sip_emit_conf "$SIP_CONF" 5060 "$SIP_UDS" "$host" "$domain" "$user" "$pass"
  printf 'wrote %s (mode 600)\n' "$SIP_CONF"
  sip_turn_on
  printf '%s — telephony is on. Check: teaport sip status\n' "$(c "$GREEN" 'SIP enabled')"
  sip_wait_registered 20 || true
}

# Enable the pair and (re)start it. `enable --now` is a no-op on a unit that is already
# running, so a configure re-run — a password rotation, a new registrar — wrote the conf
# and then read the OLD invocation's 200 OK as success while the gateway stayed on the
# old credentials until the next reboot. `restart` starts a stopped unit and restarts a
# running one, so it is right in both cases, and it gives sip_wait_registered a fresh
# invocation to read.
sip_turn_on() {
  SUDO systemctl daemon-reload
  SUDO systemctl enable teaport-sip.service teaport-sip-brain.service
  if [ "$(active teaport-sip)" = active ]; then echo "restarting the running gateway + SIP brain onto the new config..."; fi
  SUDO systemctl restart teaport-sip.service teaport-sip-brain.service
}

# The keys the units own, forced onto an adopted conf (and onto its probe copy, so what
# is tested is what is installed): sip_port (5060 — the live port, not whatever the hand
# launch used), uds_path (the socket the sip-brain unit passes as --socket; a mismatch
# is a brain that connects to nothing) and register=true — the gateway's parser default
# is false (config.h doRegister) and the shipped sample says `register = false`, so a
# conf derived from either silently never REGISTERs and the probe blamed the trunk.
sip_adopt_conf_keys() {
  local f="$1" port="$2" uds="$3"
  sip_conf_set "$f" sip_port "$port" && sip_conf_set "$f" uds_path "$uds" && sip_conf_set "$f" register true
}

# sip_adopt_conf <file> — `configure --conf`. The file is the gateway's own key=value
# format; it must at least name the trunk. It is installed as-is but for the keys in
# sip_adopt_conf_keys. Test-registered first, exactly like the wizard, so a stale
# password is caught here and not on the next inbound call.
sip_adopt_conf() {
  local src="$1" k missing=""
  [ -r "$src" ] || die "cannot read $src"
  for k in id_uri registrar_uri username password; do
    [ -n "$(confval "$src" "$k")" ] || missing="$missing $k"
  done
  [ -z "$missing" ] || die "$src is missing:$missing — a gateway .conf needs id_uri, registrar_uri, username, password"
  sip_refuse_hand_launched
  local uds; uds="$(confval "$src" uds_path)"
  [ -n "$uds" ] && [ "$uds" != "$SIP_UDS" ] && printf 'note: uds_path %s -> %s (the socket the units use)\n' "$uds" "$SIP_UDS"
  # Truthy as the gateway's asBool reads it (config.h: 1|true|yes|on), or a conf that
  # says `register = yes` gets a note claiming the trunk was not being registered.
  local regv; regv="$(confval "$src" register)"
  case "$regv" in 1|true|yes|on) ;; *) printf 'note: register=%s -> true (the units register the trunk)\n' "${regv:-unset}" ;; esac
  sip_test_register_conf "$src" \
    || die "SIP registration failed — nothing installed, units left disabled. Fix $src and retry."

  mkdir -p "$SECRETS"; chmod 700 "$SECRETS" 2>/dev/null || true
  # Staged as a sibling of the conf (mktemp: 0600), completed there, renamed into place:
  # the installed conf is either the old one or the finished new one. `cat "$src" >
  # "$SIP_CONF"` truncated the target before reading it, and "re-test the conf I just
  # edited in place" — `--conf` pointed at $SIP_CONF itself, or a symlink to it — is a
  # natural thing to run: it passed the probe (that copies to a temp) and installed an
  # empty conf. And rewriting the keys AFTER the copy was installed left, when that
  # rewrite failed, the operator's raw conf — register=false, the hand launch's port and
  # socket — under a pair that a re-adopt (a password rotation) finds already enabled,
  # while the die said "nothing enabled". The target of a symlinked conf, and its owner
  # and mode kept, as sip_conf_set.
  local dest staged; dest="$(sip_conf_target "$SIP_CONF")"
  staged="$(sip_conf_stage "$dest")" || die "cannot stage a new conf next to $dest — nothing installed"
  { cat "$src" > "$staged" && sip_adopt_conf_keys "$staged" 5060 "$SIP_UDS" && mv -f "$staged" "$dest"; } \
    || { rm -f "$staged"; die "could not write $dest — the installed conf, if any, is unchanged"; }
  printf 'installed %s -> %s (%s)\n' "$src" "$SIP_CONF" "$(stat -c '%U:%G mode %a' "$dest")"
  sip_turn_on
  printf '%s — telephony is on.\n' "$(c "$GREEN" 'SIP enabled')"
  sip_wait_registered 20 || true
}

# teaport sip restart — the gateway AND the brain, together, in order. The brain is
# BindsTo the gateway and the gateway Upholds the brain, so restarting the gateway
# alone would do it; both are named so the intent is explicit in the journal.
# What a restart needs: a conf, the units, and the line switched on. `systemctl
# restart` STARTS a stopped unit, so on a line turned off with `sip disable` it would
# bring it back — while status/doctor, keyed on enabled, still called it off.
sip_require_on() {
  [ -f "$SIP_CONF" ] || die "no $SIP_CONF — telephony is not configured (teaport sip configure)"
  installed teaport-sip || die "SIP units not installed — re-run install.sh"
  sip_enabled || die "telephony is off (teaport sip disable) — turn it on with: teaport sip configure"
}
sip_restart() {
  sip_require_on
  echo "restarting teaport-sip + teaport-sip-brain together..."
  SUDO systemctl restart teaport-sip.service teaport-sip-brain.service
  sip_wait_registered 20 || true
}

# teaport sip aec [on|off] — the gateway's echo canceller A/B toggle. Flips the one key
# in the conf and restarts the pair; with no argument, shows the current setting. The
# restart's preconditions are checked BEFORE the conf is touched: checked after, a box
# without the units had its aec flipped on disk and then died at sip_restart, and the
# next install.sh brought the line up with AEC off without anyone choosing it then.
sip_aec() {
  [ -f "$SIP_CONF" ] || die "no $SIP_CONF — telephony is not configured (teaport sip configure)"
  local cur val; cur="$(confval "$SIP_CONF" aec)"
  case "${1:-}" in on|true|1|off|false|0) sip_require_on ;; esac
  case "${1:-}" in
    "")          printf 'aec=%s  aec_tail_ms=%s  (%s)\n' "${cur:-unset}" "$(confval "$SIP_CONF" aec_tail_ms)" "$SIP_CONF"; return 0 ;;
    on|true|1)   val=true ;;
    off|false|0) val=false ;;
    -h|--help)   echo "usage: teaport sip aec [on|off]   (no argument: show the current setting)"; return 0 ;;
    *) die "usage: teaport sip aec [on|off]" ;;
  esac
  sip_conf_set "$SIP_CONF" aec "$val" || die "could not rewrite $SIP_CONF — aec left at ${cur:-unset}"
  printf 'aec: %s -> %s in %s\n' "${cur:-unset}" "$val" "$SIP_CONF"
  sip_restart
}

sip_status() {
  echo "teaport — sip status"
  svc_line teaport-sip
  svc_line teaport-sip-brain
  if [ -f "$SIP_CONF" ]; then
    printf '  %-28s %s\n' "config" "$(c "$GREEN" present) ($SIP_CONF)"
    local reg user; reg="$(confval "$SIP_CONF" registrar_uri)"; user="$(confval "$SIP_CONF" username)"
    printf '  %-28s %s\n' "registrar" "${reg:-?}  (user ${user:-?})"
    printf '  %-28s %s\n' "aec" "$(confval "$SIP_CONF" aec)  (tail $(confval "$SIP_CONF" aec_tail_ms) ms)"
  else
    printf '  %-28s %s\n' "config" "$(c "$YEL" absent) — run: teaport sip configure"
  fi
  # This run's registration, which is the health signal: an active gateway that never
  # logged its 200 is up but unreachable, and inbound calls just do not arrive.
  local last note; last="$(sip_last_reg)"
  if sip_reg_ok "$last"; then printf '  %-28s %s %s\n' "registration" "$(c "$GREEN" ok)" "${last#*\[reg\] }"
  elif [ -n "$last" ]; then printf '  %-28s %s %s\n' "registration" "$(c "$RED" FAILED)" "${last#*\[reg\] }"
  elif [ "$(active teaport-sip)" = active ]; then
    if note="$(sip_journal_note)"; then printf '  %-28s %s\n' "registration" "$(c "$YEL" 'none logged yet this run')"
    else printf '  %-28s %s %s\n' "registration" "$(c "$YEL" unknown)" "$note"; fi
  fi
}

sip_disable() {
  local purge=0; [ "${1:-}" = --purge ] && purge=1
  SUDO systemctl disable --now teaport-sip-brain.service teaport-sip.service 2>/dev/null || true
  echo "SIP units disabled + stopped."
  if [ "$purge" = 1 ]; then
    rm -f "$SIP_CONF" && echo "removed $SIP_CONF"
  elif [ -f "$SIP_CONF" ]; then
    echo "config kept at $SIP_CONF (use --purge to remove)"
  fi
}

cmd_sip() {
  local sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    configure) sip_configure "$@" ;;
    status)    sip_status "$@" ;;
    aec)       sip_aec "$@" ;;
    restart)   sip_restart "$@" ;;
    disable)   sip_disable "$@" ;;
    ""|-h|--help|help)
      cat <<'EOF'
teaport sip — opt-in SIP telephony (off by default)

  teaport sip configure    wizard: registrar/SBC host, domain, user, password; test-registers,
                           then writes ~/.config/teaport/teaport-sip.conf (600) and enables the units.
                           headless: --host H --domain D --user U --password P --yes
                           --conf FILE: adopt an existing gateway .conf instead (test-registered too)
  teaport sip status       service states + config + this run's registration
  teaport sip aec [on|off] the gateway echo canceller A/B toggle (restarts the pair); no arg = show
  teaport sip restart      restart the gateway and the SIP brain together (never one alone)
  teaport sip disable      stop + disable both SIP units (--purge also removes the config)
EOF
      ;;
    *) die "unknown sip subcommand: $sub (try: configure | status | aec | restart | disable)" ;;
  esac
}

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }

cmd="${1:-}"; shift || true
case "$cmd" in
  status) cmd_status "$@" ;;
  doctor) cmd_doctor "$@" ;;
  update) cmd_update "$@" ;;
  logs)   cmd_logs "$@" ;;
  sip)    cmd_sip "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $cmd (try: status | doctor | update | logs | sip)" ;;
esac
