# the user means: start
msgctxt "pattern"
msgid "\\b(?:set ?up|setup|configure|connect to|join|change|switch)\\b(?: (?:the|a|my|your|to|new|another|different)){0,3} ?wi-?fi\\b|\\bwi-?fi (?:set ?up|setup)\\b"
msgstr "(?:\\b(?:ri)?(?:configur|impost|colleg|connett|cambi|install|set ?up|setup)(?!at[oa]\\b)[\\w'’]*|\\b(?:ri)?conness(?![oa]\\b)\\w*)(?: \\S+){0,3} ?(?:wi[-‐‑ ]?fi\\b|rete senza fili)|\\bwi[-‐‑ ]?fi\\b.{0,20}\\b(?:configur|impost)(?!at[oa]\\b)\\w*"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\bsì\\b|\\bsi\\W*$|(?:^|[,.!?] *)\\W*si(?:[,.!]| (?:si|grazie|certo|dai|vai|procedi|perfetto|va bene|ok|okay|d['’ ]?accordo|fallo|esatto)\\b)|\\b(?:certo|certamente|ok|okay|va bene|va be|d['’ ]?accordo|daccordo|procedi|vai|vai pure|fallo|fai pure|perfetto|esatto|volentieri|per favore|per piacere|assolutamente|senz['’ ]?altro|come no|perch[ée] no|inizia|comincia|avvia|parti|dai)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "(?<!come )(?<!perch[ée] )\\bno\\b|\\b(?:nah|non (?:\\S+ ){0,2}?(?:voglio|ora|adesso|serve|importa|occorre|fare|farlo|grazie|mi interessa|[èe] il caso)|lascia(?:mo)? (?:perdere|stare)|fa niente|annull\\w*|ferm\\w*|stop\\w*|basta|per niente|neanche|nemmeno|macch[ée])\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:annull\\w*|ferma\\w*|stop\\w*|basta(?! che)|esci|uscire|smetti\\w*|interromp\\w*|lascia(?:mo)? (?:perdere|stare)|abbandona\\w*|chiudi\\w*)\\b"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:ripet\\w*|di nuovo|ancora|un['’ ]?altra volta|ridi(?:mmi|llo|ci)\\w*|(?:come|cosa|che) hai detto|non ho (?:capito|sentito)|scusa|scusi|come|cosa|password|parola d['’ ]?ordine|chiave|nome della rete|qual (?:era|[èe])|com['’ ]?era)\\b"
