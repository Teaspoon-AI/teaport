# the user means: start
msgctxt "pattern"
msgid "\\b(?:set(?:s|ting)?[- ]?up|(?:re)?configur(?:e|es|ing)|(?:re)?connect(?:s|ing)?|join(?:s|ing)?|chang(?:e|es|ing)|switch(?:es|ing)?)\\b(?: (?:the|a|my|your|our|this|that|to|onto|new|another|different|other|home|guest|me|us|it|yourself|the box|back)){0,4} ?(?:(?:wi[-‐‑ ]?fi|wireless)(?: (?:network|connection))?|network|hotspot)s?(?= *(?:[.,!?;:…]|$)| on \\w| (?:and|so|but|because|since|then|now|please|again|for|to|at|in|with|from|here|there|too|first|today|tonight|called|named|instead|as|if|when|or|that|which|i|we|ok|okay|thanks|thank|right|quickly)\\b)|\\bwi[-‐‑ ]?fi (?:set[- ]?up|setup)\\b"
msgstr "\\b(?:ri)?(?:configur|impost|colleg|connett|cambi|install|set ?up|setup)(?!at[oa]\\b)[\\w'’]*(?: \\S+){0,3} ?(?:wi[-‐‑ ]?fi\\b|rete senza fili)|\\bwi[-‐‑ ]?fi\\b.{0,20}\\b(?:configur|impost)(?!at[oa]\\b)\\w*"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\bsì\\b|\\bsi\\W*$|(?:^|[,.!?] *)\\W*si(?:[,.!]| (?:si|grazie|certo|dai|vai|procedi|perfetto|va bene|ok|okay|d['’ ]?accordo|fallo|esatto)\\b)|\\b(?:certo|certamente|ok|okay|va bene|va be|d['’ ]?accordo|daccordo|procedi|proceda|vai|vai pure|fallo|fai pure|lo faccia|perfetto|esatto|volentieri|per favore|per piacere|assolutamente|senz['’ ]?altro|come no|perch[éeè] no|no problem|nessun problema|inizia|cominci\\w*|avvia|parti|dai)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "(?<!come )(?<!perch[éeè] )\\bno\\b(?! problem)|\\b(?:nah|non (?:\\S+ ){0,2}?(?:voglio|ora|adesso|ancora|serve|importa|occorre|fare|farlo|grazie|mi interessa|mi va|c['’ ]?[èe] bisogno|[èe] il caso)|lascia(?:mo|te)? (?:perdere|stare)|lasci (?:perdere|stare)|fa niente|più tardi|un['’ ]?altra volta|annull\\w*|ferm\\w*|stop\\w*|basta|per niente|neanche|nemmeno|macch[ée])\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:annull\\w*|ferma\\w*|fermi|stop\\w*|basta(?! che)|esci\\w*|uscire|smetti\\w*|interromp\\w*|lascia(?:mo|te)? (?:perdere|stare)|lasci (?:perdere|stare)|abbandona\\w*|chiudi\\w*)\\b"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:ripet\\w*|di nuovo|ancora|un['’ ]?altra volta|ridi(?:mmi|llo|ci)\\w*|(?:come|cosa|che) hai detto|non ho (?:capito|sentito)|scusa|scusi|come|cosa|password|parola d['’ ]?ordine|chiave|nome della rete|qual (?:era|[èe])|com['’ ]?era)\\b"

# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "Lingua"

# The session arbiter (session_arbiter.py): one conversation at a time.
msgid "Sorry, I'm on a phone call right now. Please try again when it's over."
msgstr "Scusa, sono al telefono in questo momento. Riprova quando la chiamata è finita."

msgid "Sorry, I'm in another conversation right now. Please try again in a little while."
msgstr "Scusa, sono già in un'altra conversazione. Riprova tra poco."

msgid "Sorry, a phone call is coming in and I have to take it. We can talk again when it's over."
msgstr "Scusa, sta arrivando una telefonata e devo rispondere. Possiamo riprendere a parlare quando ho finito."

# A phone call during a conversation (session_arbiter.py, call_prompt.py): the agent asks,
# steps away, and comes back.
#. Translators: {caller} is a name or a phone number, as the caller ID gives it.
msgid "Someone's calling me — {caller}. Should I step away for a moment?"
msgstr "Qualcuno mi sta chiamando — {caller}. Rispondo un attimo?"

msgid "Someone's calling me. Should I step away for a moment?"
msgstr "Qualcuno mi sta chiamando. Rispondo un attimo?"

msgid "I'll take the call — back in a moment."
msgstr "Rispondo alla chiamata — torno subito."

msgid "Sorry about that — where were we?"
msgstr "Scusa l'interruzione — dove eravamo rimasti?"

msgid "Sorry, I couldn't get an answer just then. Could you try again?"
msgstr "Scusa, non sono riuscito a ottenere una risposta proprio ora. Puoi riprovare?"

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. It can be fixed on my settings page."
msgstr "Scusa, in questo momento non posso rispondere: l'account che uso per le mie risposte ha bisogno di attenzione, e riprovare non servirà. Si può sistemare dalla mia pagina delle impostazioni."

msgid "I still can't answer until my account is sorted out."
msgstr "Non posso ancora rispondere finché il mio account non viene sistemato."

msgid "Sorry, I couldn't get an answer just then."
msgstr "Scusa, non sono riuscito a ottenere una risposta proprio ora."

# The call recording notice (call_recording.py, #114).
msgid "This call is being recorded."
msgstr "Questa chiamata viene registrata."

# No model at all (llm_error_speaker.py, #277).
msgid "I can't answer questions yet, because the account I use for my answers isn't set up."
msgstr "Non posso ancora rispondere alle domande, perché l'account che uso per le mie risposte non è configurato."

msgid "I can't answer questions until I'm set up. Say \"set up Wi-Fi\" to get me online."
msgstr "Non posso rispondere alle domande finché non vengo configurato. Di' «configura il Wi-Fi» per collegarmi a internet."

msgid "Sorry, I can't take calls right now. Please try again later."
msgstr "Scusa, in questo momento non posso rispondere alle chiamate. Riprova più tardi."

msgid "I'm ready now. Please ask me again."
msgstr "Ora sono pronto. Fammi di nuovo la domanda."

msgid "I'm ready now. Please start a new conversation with me."
msgstr "Ora sono pronto. Inizia una nuova conversazione con me."

# The first-boot setup (wifi_voice.py, first_boot.py, #278).
msgid "Hi, I'm Teaport. Let's get me online. Give me a moment to look for networks."
msgstr "Ciao, sono Teaport. Collegami a internet. Un momento, cerco le reti disponibili."

msgid "You can say \"set up Wi-Fi\" any time to try again."
msgstr "Puoi dire «configura il Wi-Fi» in qualsiasi momento per riprovare."

msgid "I'm online now, so I've left setup mode."
msgstr "Ora sono online, quindi ho chiuso la modalità di configurazione."

# The sessions' own lines: busy / engine-unavailable, consult progress and tool acks (tools.py, agent_session.py).

msgid "Sorry, the voice assistant is busy with another session right now — please try again in a moment."
msgstr "Scusa, l'assistente vocale è occupato con un'altra sessione. Riprova tra un momento."

msgid "Sorry, I can't hear you right now — my speech recognition isn't available. Please try again in a moment."
msgstr "Scusa, ora non ti sento: il riconoscimento vocale non è disponibile. Riprova tra un momento."

msgid "Still working on that — {topic}."
msgstr "Ci sto ancora lavorando — {topic}."

msgid "Still working on it."
msgstr "Ci sto ancora lavorando."

msgid "Almost there — {topic}."
msgstr "Manca poco — {topic}."

msgid "Almost there — hang tight."
msgstr "Manca poco, un attimo ancora."

msgid "Looking up {q}."
msgstr "Cerco {q}."

msgid "Opening that page."
msgstr "Apro la pagina."

msgid "I'll work on that — give me a moment."
msgstr "Ci lavoro subito, un attimo."

msgid "One moment, let me set that up."
msgstr "Un attimo, lo preparo."

# Settings from the phone and the AI account (settings_access.py, ai_account.py, config_ui.py, wifi_setup.py, #279).
msgid "AI account"
msgstr "Account IA"

msgid "AI account (optional)"
msgstr "Account IA (facoltativo)"

msgid "An account is connected."
msgstr "È collegato un account."

msgid "Ask Teaport for a new one: say \"open my settings\"."
msgstr "Chiedine uno nuovo a Teaport: di' «apri le impostazioni»."

msgid "Checking the key…"
msgstr "Verifica della chiave…"

msgid "Code"
msgstr "Codice"

msgid "Continue"
msgstr "Continua"

msgid "Enter the code Teaport gave you. It works once."
msgstr "Inserisci il codice che ti ha dato Teaport. Funziona una sola volta."

msgid "I can't answer questions yet, because the account I use for my answers isn't set up. Say \"open my settings\" to set it up."
msgstr "Non posso ancora rispondere alle domande, perché il mio account per le risposte non è configurato. Di' «apri le impostazioni» per configurarlo."

msgid "I couldn't use the AI account key you entered, so I didn't save it. Say \"open my settings\" to try again."
msgstr "Non è stato possibile usare la chiave inserita per il tuo account IA, quindi non è stata salvata. Di' «apri le impostazioni» per riprovare."

msgid "I need to be online for that. Say \"set up Wi-Fi\" to get me online."
msgstr "Per questo devo essere online. Di' «configura il Wi-Fi» per collegarmi a internet."

msgid "I've put a code on my screen. Scan it with your phone's camera, then tap the link that appears to get to my settings."
msgstr "Ho mostrato un codice sul mio schermo. Inquadralo con la fotocamera del telefono, poi tocca il link che compare per arrivare alle mie impostazioni."

msgid "If your phone warns that the connection is not private, install {certificate} first, then ask Teaport for a new code."
msgstr "Se il telefono avvisa che la connessione non è privata, installa prima {certificate}, poi chiedi a Teaport un nuovo codice."

msgid "If your phone warns that this page is not private, here is how to trust Teaport."
msgstr "Se il telefono avvisa che questa pagina non è privata, ecco come considerare attendibile Teaport."

msgid "In your phone's browser, go to {address}, and enter the code {code}. It works once, for the next five minutes."
msgstr "Nel browser del telefono, vai all'indirizzo {address} e inserisci il codice {code}. Funziona una sola volta, per i prossimi cinque minuti."

msgid "Leave this empty to keep the account Teaport has now. To use your own OpenRouter account, paste its key here. Teaport checks the key once it's online, and says out loud whether it worked."
msgstr "Lascia vuoto questo campo per mantenere l'account che Teaport usa ora. Per usare il tuo account OpenRouter, incolla qui la sua chiave. Teaport verifica la chiave appena è online e ti dice a voce se ha funzionato."

msgid "No account is connected yet."
msgstr "Nessun account ancora collegato."

msgid "OpenRouter key"
msgstr "Chiave OpenRouter"

msgid "Save anyway"
msgstr "Salva comunque"

msgid "Settings"
msgstr "Impostazioni"

msgid "Show advanced"
msgstr "Mostra opzioni avanzate"

msgid "Sorry, my settings can't be reached from a phone on this box."
msgstr "Mi dispiace, su questo dispositivo le mie impostazioni non sono raggiungibili da un telefono."

msgid "Tap Continue to get to Teaport's settings on this phone. The code works once."
msgstr "Tocca “Continua” per aprire le impostazioni di Teaport su questo telefono. Il codice funziona una sola volta."

msgid "Teaport couldn't check this key: {reason}."
msgstr "Teaport non ha potuto verificare questa chiave: {reason}."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, paste a key from your OpenRouter account."
msgstr "Teaport usa un account OpenRouter per le sue risposte. Per usare il tuo, incolla una chiave del tuo account OpenRouter."

msgid "Teaport's certificate"
msgstr "Il certificato di Teaport"

msgid "Test and save"
msgstr "Verifica e salva"

msgid "That code didn't work. Check it, or ask Teaport for a new one."
msgstr "Il codice non ha funzionato. Controllalo, oppure chiedi a Teaport un nuovo codice."

msgid "The key works, and it's saved. Teaport uses it from your next conversation."
msgstr "La chiave funziona ed è stata salvata. Teaport la userà dalla prossima conversazione."

msgid "This code has expired"
msgstr "Questo codice è scaduto"

msgid "This code was already used"
msgstr "Questo codice è già stato usato"

msgid "This key didn't work: {reason}."
msgstr "Questa chiave non ha funzionato: {reason}."

msgid "Your AI account is connected."
msgstr "Il tuo account IA è collegato."

msgid "no AI service is set up on this box"
msgstr "su questo dispositivo non è configurato nessun servizio di IA"

