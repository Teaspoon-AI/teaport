# teaport — Italian strings for what the brain says and shows without the LLM
# (Wi-Fi setup). Source: English msgids in wifi_voice.py, wifi_setup.py and wifi.py.
# Edit here (any PO editor), then: python -m teaport_brain.i18n  (recompiles the .mo).
#
# Contexts: "digit" — how a digit is said; "spell" — symbol names, the separator
# between spelled characters, and how an uppercase letter is said; "pattern" — a
# Python regex (searched, case-insensitive) for the user's words meaning start / yes /
# no / cancel / repeat. English phrases are always understood as well.
# Placeholders like {network} must be kept as they are.
#
# Translated by a model (2026-10-07). A native speaker's review is welcome.
msgid ""
msgstr ""
"Project-Id-Version: teaport\n"
"PO-Revision-Date: 2026-10-07 00:00+0000\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: it\n"

msgid "Do you want to set up Wi-Fi? I'll go offline for a few minutes while you do it on your phone. Say yes or no."
msgstr "Vuoi configurare il Wi-Fi? Per qualche minuto resterò senza connessione, mentre lo fai dal telefono. Rispondi sì o no."

msgid "Wi-Fi setup is already running."
msgstr "La configurazione del Wi-Fi è già in corso."

msgid "Okay. Give me a moment to look for networks."
msgstr "Va bene. Dammi un momento per cercare le reti."

msgid "Sorry, I couldn't start Wi-Fi setup on this box."
msgstr "Mi dispiace, non sono riuscito ad avviare la configurazione del Wi-Fi su questo dispositivo."

msgid "Okay, I've stopped Wi-Fi setup and put things back as they were."
msgstr "Va bene, ho interrotto la configurazione del Wi-Fi e ho rimesso tutto com'era."

msgid "Wi-Fi setup didn't start. Please try again in a moment."
msgstr "La configurazione del Wi-Fi non è partita. Riprova tra un momento."

msgid "I'm still waiting for you on the setup page."
msgstr "Ti sto ancora aspettando sulla pagina di configurazione."

msgid "That didn't work: {reason}."
msgstr "Non ha funzionato: {reason}."

# {network} follows "alla rete" in Italian, so "your network" is translated as the
# rest of that phrase: "alla rete che hai scelto".
msgid "Got it. I'm joining {network}. Switch your phone back to it."
msgstr "Capito. Mi sto collegando alla rete {network}. Ricollega il telefono a quella rete."

msgid "I'm connected to {network}, and I'm online again."
msgstr "Sono collegato alla rete {network}, e ho di nuovo accesso a internet."

msgid "Wi-Fi setup timed out, so I've put things back as they were."
msgstr "La configurazione del Wi-Fi ci ha messo troppo, quindi ho rimesso tutto com'era."

msgid "Wi-Fi setup stopped: {reason}."
msgstr "La configurazione del Wi-Fi si è interrotta: {reason}."

# Only ever used as {network} after "alla rete" (see above): "alla rete che hai scelto".
msgid "your network"
msgstr "che hai scelto"

msgid "something went wrong"
msgstr "qualcosa è andato storto"

msgid "Okay, never mind."
msgstr "Va bene, lasciamo perdere."

msgid "Say yes to start Wi-Fi setup, or no."
msgstr "Rispondi sì per avviare la configurazione del Wi-Fi, oppure no."

msgid "I'm in Wi-Fi setup. Say repeat to hear the details again, or cancel to stop."
msgstr "Sto configurando il Wi-Fi. Puoi dire ripeti per riascoltare i dati, oppure annulla per interrompere."

msgid "On your phone, join the Wi-Fi network {ssid}. The password is {password}. A setup page should open by itself. If it doesn't, go to {url}."
msgstr "Sul telefono, collegati alla rete Wi-Fi {ssid}. La password è {password}. Dovrebbe aprirsi da sola una pagina di configurazione. Se non si apre, vai su {url}."

msgid "the saved settings for it did not work"
msgstr "le impostazioni salvate per quella rete non hanno funzionato"

msgid "the password did not work"
msgstr "la password non è stata accettata"

msgid "the network was not found"
msgstr "la rete non è stata trovata"

msgid "it would not connect"
msgstr "la connessione non è riuscita"

msgid "it joined but there is no internet through it"
msgstr "la connessione è riuscita, ma quella rete non ha accesso a internet"

msgid "this box has no Wi-Fi device"
msgstr "questo dispositivo non ha il Wi-Fi"

msgid "the setup network would not start"
msgstr "non è stato possibile avviare la rete di configurazione"

msgid "the setup page could not start"
msgstr "non è stato possibile avviare la pagina di configurazione"

msgid "open"
msgstr "aperta"

msgid "Teaport Wi-Fi setup"
msgstr "Configurazione Wi-Fi di Teaport"

msgid "Connect to Wi-Fi"
msgstr "Connettiti al Wi-Fi"

msgid "Pick your network and type its password. Teaport will leave this setup network and join yours, and say out loud whether that worked."
msgstr "Scegli la tua rete e inserisci la password. Teaport lascerà questa rete di configurazione, si collegherà alla tua e ti dirà a voce se ha funzionato."

msgid "No networks found — use Other."
msgstr "Nessuna rete trovata — usa Altra."

msgid "Other (hidden) network"
msgstr "Altra rete (nascosta)"

msgid "Network name"
msgstr "Nome della rete"

msgid "Password"
msgstr "Password"

msgid "Show password"
msgstr "Mostra password"

msgid "Connect"
msgstr "Connetti"

msgid "Teaport is joining"
msgstr "Teaport si sta collegando"

msgid "Joining {network}…"
msgstr "Connessione a {network}…"

msgid "Teaport is leaving this setup network now. Switch your phone back to {network}. Teaport will say out loud whether it connected; if it could not, the setup network comes back and you can try again."
msgstr "Teaport sta lasciando questa rete di configurazione. Ricollega il telefono a {network}. Teaport ti dirà a voce se si è collegato; se non ci riesce, la rete di configurazione tornerà disponibile e potrai riprovare."

msgid "Could not join {network}: {reason}. Try again."
msgstr "Impossibile collegarsi a {network}: {reason}. Riprova."

msgid "Pick a network, or type its name under Other."
msgstr "Scegli una rete, oppure scrivine il nome in Altra."

msgid "That network name is too long."
msgstr "Il nome della rete è troppo lungo."

msgid "Wi-Fi passwords are 8 to 63 characters."
msgstr "Le password Wi-Fi devono avere da 8 a 63 caratteri."

