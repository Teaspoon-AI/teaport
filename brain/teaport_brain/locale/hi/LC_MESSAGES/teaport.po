# the user means: start
msgctxt "pattern"
msgid "\\b(?:set(?:s|ting)?[- ]?up|(?:re)?configur(?:e|es|ing)|(?:re)?connect(?:s|ing)?|join(?:s|ing)?|chang(?:e|es|ing)|switch(?:es|ing)?)\\b(?: (?:the|a|my|your|our|this|that|to|onto|new|another|different|other|home|guest|me|us|it|yourself|the box|back)){0,4} ?(?:(?:wi[-‐‑ ]?fi|wireless)(?: (?:network|connection))?|network|hotspot)s?(?= *(?:[.,!?;:…]|$)| on \\w| (?:and|so|but|because|since|then|now|please|again|for|to|at|in|with|from|here|there|too|first|today|tonight|called|named|instead|as|if|when|or|that|which|i|we|ok|okay|thanks|thank|right|quickly)\\b)|\\bwi[-‐‑ ]?fi (?:set[- ]?up|setup)\\b"
msgstr "(?:वा[ईइय]\\s?-?\\s?(?:फ़|फ़|फ)ा[ईइय]|\\bwi\\s?-?\\s?fi\\b|\\bwify\\b|\\bwai\\s?-?\\s?fai\\b).{0,15}?(?:सेट\\s?-?\\s?अप|सेट\\s?(?:कर|करो|करें|करे|कीजिए|करिए|करना|करनी|करवा|कर\\s?दो|कर\\s?दीजिए)|कनेक्ट\\s?(?:कर|करो|करें|करे|कीजिए|करिए|करना|करनी|करवा|कर\\s?दो|कर\\s?दीजिए)|कॉन्(?:फ़|फ़|फ)िगर|कान्(?:फ़|फ़|फ)िगर|जो(?:ड़|ड़|ड)(?:ो|ना|नी|ें|िए|\\s?दो|\\s?दीजिए|\\s?लो|$|\\s)|बदल(?:ो|ना|नी|ें|िए|\\s?दो|\\s?दीजिए|$|\\s)|लगा(?:ओ|ना|नी|इए|एं|ें|\\s?दो|\\s?दीजिए)|ठीक\\s?(?:कर|करो|करें|करे|कीजिए|करिए|करना|करनी|करवा|कर\\s?दो|कर\\s?दीजिए)|सेटिंग\\s?(?:(?:कर|करो|करें|करे|कीजिए|करिए|करना|करनी|करवा|कर\\s?दो|कर\\s?दीजिए)|बदल)|चेंज|स्विच|\\bset\\s?up|\\bsetup|\\bset\\s?kar|\\bconnect\\s?kar|\\bjo[dr]|\\bbadal|\\bbadlo|\\blagao|\\blagana|\\bth[ei]e?k\\s?kar|\\bconfigure|\\bchange|\\bswitch)|(?:सेट\\s?-?\\s?अप|कॉन्(?:फ़|फ़|फ)िगर|\\bset\\s?up|\\bsetup|\\bconfigure).{0,10}?(?:वा[ईइय]\\s?-?\\s?(?:फ़|फ़|फ)ा[ईइय]|\\bwi\\s?-?\\s?fi\\b|\\bwify\\b|\\bwai\\s?-?\\s?fai\\b)"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "(?<![\\u0900-\\u097F])हा[ँं]?(?:\\s?जी)?(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])जी(?![\\u0900-\\u097F])(?!\\s*(?:नहीं|नही|ना))|(?<![\\u0900-\\u097F])ठीक\\s?है[ंँ]?(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])बि(?:ल्|ल)कुल(?![\\u0900-\\u097F])(?!\\s*न)|(?<![\\u0900-\\u097F])(?:ज़|ज़|ज)रूर(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])ओके(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])क्य(?:ों|ूँ|ूं|ो)\\s?नहीं(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])चल(?:ो|िए|ें)(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])(?:शुरू|स्टार्ट)\\s?(?:करो|करें|कीजिए|करिए|कर\\s?दो|कर\\s?दीजिए|करते\\s?हैं)(?![\\u0900-\\u097F])|\\b(?:ha|haa|han|haan|haanji|haan\\s?ji|ji\\s?haan|th[ei]e?k\\s?hai|bilkul(?!\\s*nahi)|zaroor|jaroor|zarur|jarur|shuru\\s?karo|start\\s?karo|chalo|kyo?u?n?\\s?nahi)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "^(?!.*(?:क्य(?:ों|ूँ|ूं|ो)\\s?नहीं|\\bkyo?u?n?\\s?nahi))(?:.*?(?:(?<![\\u0900-\\u097F])न(?:हीं|हीँ|हिं|ही)(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])नो(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])मत(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])रहने\\s?(?:दो|दीजिए|दें|दे)(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])छो(?:ड़|ड़|ड)(?:ो|\\s?दो|\\s?दीजिए|\\s?दें)(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])कै(?:ं|न्)?स(?:ि)?ल(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])रद्द(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])बाद\\s?में\\s?(?:करेंगे|करना|करते|कर\\s?लेंगे|देखेंगे)(?![\\u0900-\\u097F])|\\b(?:no|nope|nahi|nahin|nahee|nhi|mat|rehne\\s?do|rahne\\s?do|chho?d\\s?do|chho?do|cancel|radd)\\b)|\\W*ना(?![\\u0900-\\u097F])|\\W*na\\b|\\W*बाद\\s?में(?![\\u0900-\\u097F])|\\W*baad\\s?m(?:e|ein|ei)\\b)"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "(?<![\\u0900-\\u097F])कै(?:ं|न्)?स(?:ि)?ल(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])स्टॉप(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])रद्द(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])रोक(?:ो|िए|ें|\\s?दो|\\s?दीजिए)(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])बंद\\s?(?:करो|करें|कीजिए|करिए|कर\\s?दो|कर\\s?दीजिए)(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])रहने\\s?(?:दो|दीजिए|दें)(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])छो(?:ड़|ड़|ड)(?:ो|\\s?दो|\\s?दीजिए|\\s?दें)(?![\\u0900-\\u097F])|(?<![\\u0900-\\u097F])बस\\s?(?:करो|कीजिए|करें)(?![\\u0900-\\u097F])|\\b(?:cancel|radd|roko|rok\\s?do|band\\s?karo|band\\s?kar\\s?do|rehne\\s?do|rahne\\s?do|chho?d\\s?do|chho?do|bas\\s?karo)\\b"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "(?<![\\u0900-\\u097F])(?:दोबारा|दुबारा|फिर\\s?से|फिर\\s?(?:बोलो|बोलिए|बताओ|बताइए)|एक\\s?बार\\s?और|दोहरा(?:ओ|इए|एं|ना)|रिपीट|पासवर्ड|नेटवर्क\\s?का\\s?नाम|नाम\\s?क्या|क्या\\s?(?:था|बोला|कहा)|समझ\\s?नहीं|सुनाई\\s?नहीं|धीरे)(?![\\u0900-\\u097F])|^\\W*(?:क्या|जी|हैं)\\W*$|\\b(?:dobara|dobaara|dubara|phir\\s?se|fir\\s?se|ek\\s?ba+r\\s?aur|repeat|password|kya\\s?tha|kya\\s?bola|samajh\\s?nahi|sunai\\s?nahi|dohrao|dohraiye|dheere|dhire)\\b|^\\W*kya\\W*$"

# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "भाषा"

# The session arbiter (session_arbiter.py): one conversation at a time.
msgid "Sorry, I'm on a phone call right now. Please try again when it's over."
msgstr "माफ़ कीजिए, मैं अभी फ़ोन कॉल पर हूँ। कॉल ख़त्म होने के बाद फिर से कोशिश कीजिए।"

msgid "Sorry, I'm in another conversation right now. Please try again in a little while."
msgstr "माफ़ कीजिए, मैं अभी किसी और बातचीत में हूँ। थोड़ी देर में फिर से कोशिश कीजिए।"

msgid "Sorry, a phone call is coming in and I have to take it. We can talk again when it's over."
msgstr "माफ़ कीजिए, एक फ़ोन कॉल आ रही है और मुझे उसे उठाना होगा। कॉल ख़त्म होने के बाद हम फिर बात कर सकते हैं।"

# A phone call during a conversation (session_arbiter.py, call_prompt.py): the agent asks,
# steps away, and comes back.
#. Translators: {caller} is a name or a phone number, as the caller ID gives it.
msgid "Someone's calling me — {caller}. Should I step away for a moment?"
msgstr "कोई मुझे कॉल कर रहा है — {caller}। क्या मैं एक पल के लिए कॉल उठा लूँ?"

#. Translators: {digits} are the last four digits of the caller's phone number,
#. spaced so the voice reads them one by one ("8 5 0 0"). Keep them as they are.
msgid "Someone's calling me — a number ending in {digits}. Should I step away for a moment?"
msgstr "कोई मुझे कॉल कर रहा है — नंबर के आख़िरी अंक {digits} हैं। क्या मैं एक पल के लिए कॉल उठा लूँ?"

msgid "Someone's calling me. Should I step away for a moment?"
msgstr "कोई मुझे कॉल कर रहा है। क्या मैं एक पल के लिए कॉल उठा लूँ?"

msgid "I'll take the call — back in a moment."
msgstr "ज़रा कॉल ले लूँ — बस एक पल में वापस।"

msgid "Sorry about that — where were we?"
msgstr "माफ़ कीजिए — हम कहाँ थे?"

msgid "Sorry, I couldn't get an answer just then. Could you try again?"
msgstr "माफ़ कीजिए, अभी मुझे जवाब नहीं मिल पाया। क्या आप फिर से कोशिश करेंगे?"

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. It can be fixed on my settings page."
msgstr "माफ़ कीजिए, मैं अभी जवाब नहीं दे सकता: जिस खाते से मुझे जवाब मिलते हैं, उस पर ध्यान देने की ज़रूरत है, और फिर से कोशिश करने से कुछ नहीं होगा। इसे मेरे सेटिंग्स पेज पर ठीक किया जा सकता है।"

msgid "I still can't answer until my account is sorted out."
msgstr "जब तक मेरा खाता ठीक नहीं होता, मैं अब भी जवाब नहीं दे सकता।"

msgid "Sorry, I couldn't get an answer just then."
msgstr "माफ़ कीजिए, अभी मुझे जवाब नहीं मिल पाया।"

# The call recording notice (call_recording.py, #114).
msgid "This call is being recorded."
msgstr "यह कॉल रिकॉर्ड की जा रही है।"

# No model at all (llm_error_speaker.py, #277).
msgid "I can't answer questions yet, because the account I use for my answers isn't set up."
msgstr "अभी सवालों के जवाब नहीं दिए जा सकते, क्योंकि जवाबों के लिए इस्तेमाल होने वाला खाता अभी सेट अप नहीं है।"

msgid "I can't answer questions until I'm set up. Say \"set up Wi-Fi\" to get me online."
msgstr "जब तक मुझे सेट अप नहीं किया जाता, सवालों के जवाब नहीं दिए जा सकते। मुझे ऑनलाइन लाने के लिए “वाई-फ़ाई सेट अप करो” बोलिए।"

msgid "Sorry, I can't take calls right now. Please try again later."
msgstr "माफ़ कीजिए, अभी कॉल नहीं ली जा सकती। बाद में फिर से कोशिश कीजिए।"

msgid "I'm ready now. Please ask me again."
msgstr "अब मैं तैयार हूँ। कृपया फिर से पूछिए।"

msgid "I'm ready now. Please start a new conversation with me."
msgstr "अब मैं तैयार हूँ। कृपया मुझसे नई बातचीत शुरू कीजिए।"

# The first-boot setup (wifi_voice.py, first_boot.py, #278).
msgid "Hi, I'm Teaport. Let's get me online. Give me a moment to look for networks."
msgstr "नमस्ते, मैं Teaport हूँ। चलिए मुझे ऑनलाइन लाते हैं। ज़रा रुकिए, मैं आस-पास के नेटवर्क ढूँढ लूँ।"

msgid "You can say \"set up Wi-Fi\" any time to try again."
msgstr "दोबारा कोशिश करने के लिए आप कभी भी “वाई-फ़ाई सेट अप करो” बोल सकते हैं।"

msgid "I'm online now, so I've left setup mode."
msgstr "इंटरनेट चालू हो गया है, इसलिए मैंने सेट अप मोड बंद कर दिया है।"

# The sessions' own lines: busy / engine-unavailable, consult progress and tool acks (tools.py, agent_session.py).

msgid "Sorry, the voice assistant is busy with another session right now — please try again in a moment."
msgstr "माफ़ कीजिए, वॉइस असिस्टेंट अभी दूसरे सेशन में व्यस्त है। थोड़ी देर बाद फिर से कोशिश कीजिए।"

msgid "Sorry, I can't hear you right now — my speech recognition isn't available. Please try again in a moment."
msgstr "माफ़ कीजिए, अभी आपकी आवाज़ नहीं सुनाई दे रही, स्पीच रिकग्निशन उपलब्ध नहीं है। थोड़ी देर बाद फिर से कोशिश कीजिए।"

#. Translators: {phrase} is the model's own few words, in this language, on what is
#. being done for the user (in English: "looking up pastry shops on Burnet Road").
#. Only an English session says the {phrase} lines today (tools._status_phrase);
#. another says the plain ones (#120).
msgid "Sure — {phrase}."
msgstr "ज़रूर — {phrase}।"

msgid "On it."
msgstr "इस पर काम शुरू हो गया है।"

msgid "Still {phrase}."
msgstr "यह काम अभी चल रहा है — {phrase}।"

msgid "Still on it."
msgstr "यह काम अभी चल रहा है।"

msgid "This one's taking a bit longer."
msgstr "इसमें थोड़ा ज़्यादा समय लग रहा है।"

msgid "Looking up {q}."
msgstr "{q} खोजा जा रहा है।"

msgid "Opening that page."
msgstr "वह पेज खोल रहे हैं।"

msgid "One moment, let me set that up."
msgstr "एक पल रुकिए, इसे तैयार किया जा रहा है।"

# Settings from the phone and the AI account (settings_access.py, ai_account.py, config_ui.py, wifi_setup.py, #279).
msgid "AI account"
msgstr "AI खाता"

msgid "AI account (optional)"
msgstr "AI खाता (वैकल्पिक)"

msgid "An account is connected."
msgstr "एक खाता जुड़ा हुआ है।"

msgid "Ask Teaport for a new one: say \"open my settings\"."
msgstr "Teaport से नया कोड माँगें: “सेटिंग्स खोलो” बोलें।"

msgid "Checking the key…"
msgstr "कुंजी की जाँच हो रही है…"

msgid "Code"
msgstr "कोड"

msgid "Continue"
msgstr "आगे बढ़ें"

msgid "Enter the code Teaport gave you. It works once."
msgstr "Teaport ने जो कोड दिया है, उसे डालें। यह सिर्फ़ एक बार काम करता है।"

msgid "I can't answer questions yet, because the account I use for my answers isn't set up. Say \"open my settings\" to set it up."
msgstr "अभी सवालों के जवाब नहीं दिए जा सकते, क्योंकि जवाबों के लिए इस्तेमाल होने वाला खाता अभी सेट अप नहीं है। इसे सेट अप करने के लिए “सेटिंग्स खोलो” बोलिए।"

msgid "I couldn't use the AI account key you entered, so I didn't save it. Say \"open my settings\" to try again."
msgstr "आपकी डाली हुई AI खाते की कुंजी इस्तेमाल नहीं हो पाई, इसलिए उसे सेव नहीं किया गया। फिर से कोशिश करने के लिए “सेटिंग्स खोलो” बोलिए।"

msgid "I need to be online for that. Say \"set up Wi-Fi\" to get me online."
msgstr "इसके लिए इंटरनेट चालू होना ज़रूरी है। मुझे ऑनलाइन लाने के लिए “वाई-फ़ाई सेट अप करो” बोलिए।"

msgid "I've put a code on my screen. Scan it with your phone's camera, then tap the link that appears to get to my settings."
msgstr "मेरी स्क्रीन पर एक कोड दिख रहा है। उसे अपने फ़ोन के कैमरे से स्कैन कीजिए, फिर मेरी सेटिंग्स तक पहुँचने के लिए दिखने वाले लिंक पर टैप कीजिए।"

msgid "If your phone warns that the connection is not private, install {certificate} first, then ask Teaport for a new code."
msgstr "अगर आपका फ़ोन चेतावनी दे कि कनेक्शन प्राइवेट नहीं है, तो पहले {certificate} इंस्टॉल करें, फिर Teaport से नया कोड माँगें।"

msgid "If your phone warns that this page is not private, here is how to trust Teaport."
msgstr "अगर आपका फ़ोन चेतावनी दे कि यह पेज प्राइवेट नहीं है, तो Teaport पर भरोसा करने का तरीका यह है।"

msgid "In your phone's browser, go to {address}, and enter the code {code}. It works once, for the next five minutes."
msgstr "अपने फ़ोन के ब्राउज़र में {address} खोलिए, और कोड {code} डालिए। यह सिर्फ़ एक बार, अगले पाँच मिनट तक काम करेगा।"

msgid "Leave this empty to keep the account Teaport has now. To use your own OpenRouter account, paste its key here. Teaport checks the key once it's online, and says out loud whether it worked."
msgstr "Teaport अभी जिस खाते का इस्तेमाल कर रहा है, उसे बनाए रखने के लिए इसे खाली छोड़ दें। अपना OpenRouter खाता इस्तेमाल करने के लिए उसकी कुंजी यहाँ पेस्ट करें। ऑनलाइन होते ही Teaport कुंजी की जाँच करेगा, और बोलकर बताएगा कि वह काम कर रही है या नहीं।"

msgid "No account is connected yet."
msgstr "अभी कोई खाता नहीं जुड़ा है।"

msgid "OpenRouter key"
msgstr "OpenRouter कुंजी"

msgid "Save anyway"
msgstr "फिर भी सेव करें"

msgid "Settings"
msgstr "सेटिंग्स"

msgid "Show advanced"
msgstr "एडवांस्ड सेटिंग्स दिखाएँ"

msgid "Sorry, my settings can't be reached from a phone on this box."
msgstr "माफ़ कीजिए, इस डिवाइस पर मेरी सेटिंग्स फ़ोन से नहीं खोली जा सकतीं।"

msgid "Tap Continue to get to Teaport's settings on this phone. The code works once."
msgstr "इस फ़ोन पर Teaport की सेटिंग्स खोलने के लिए “आगे बढ़ें” पर टैप करें। यह कोड सिर्फ़ एक बार काम करता है।"

msgid "Teaport couldn't check this key: {reason}."
msgstr "Teaport इस कुंजी की जाँच नहीं कर पाया: {reason}।"

msgid "Teaport uses an OpenRouter account for its answers. To use your own, paste a key from your OpenRouter account."
msgstr "Teaport अपने जवाबों के लिए एक OpenRouter खाते का इस्तेमाल करता है। अपना खाता इस्तेमाल करने के लिए अपने OpenRouter खाते की कुंजी पेस्ट करें।"

msgid "Teaport's certificate"
msgstr "Teaport का सर्टिफ़िकेट"

msgid "Test and save"
msgstr "जाँचें और सेव करें"

msgid "That code didn't work. Check it, or ask Teaport for a new one."
msgstr "यह कोड काम नहीं आया। इसे जाँच लें, या Teaport से नया कोड माँगें।"

msgid "The key works, and it's saved. Teaport uses it from your next conversation."
msgstr "कुंजी काम कर रही है, और सेव हो गई है। Teaport आपकी अगली बातचीत से इसका इस्तेमाल करेगा।"

msgid "This code has expired"
msgstr "इस कोड की समय-सीमा ख़त्म हो गई है"

msgid "This code was already used"
msgstr "यह कोड पहले ही इस्तेमाल हो चुका है"

msgid "This key didn't work: {reason}."
msgstr "यह कुंजी काम नहीं आई: {reason}।"

msgid "Your AI account is connected."
msgstr "आपका AI खाता जुड़ गया है।"

msgid "no AI service is set up on this box"
msgstr "इस डिवाइस पर कोई AI सेवा सेट अप नहीं है"

msgctxt "pattern"
msgid "^\\W*(?:(?:um+|uh+|uhm|er+m?|eh|hm+|ok|okay|hey|so|now|please|teaport|well|alright|right)\\W+){0,3}(?:(?:can|could|would|will) you(?: please)? )?(?:open|show|bring up|pull up|go to|get)(?: up)?(?: me)?(?: to)? (?:(?:my|your|the|teaport's|teaport) )?settings(?:[\\s,]+(?:page|please|now|for me|thanks a lot|thank you (?:so |very )?much|thanks|thank you|cheers|ok(?:ay)?|teaport)\\b)*[\\s.,!?;:…]*$"
msgstr "^\\W*(?:(?:अं|उम+|उह|हम्म|अम्म|teaport|टीपोर्ट|ज़रा|ज़रा|जरा|प्लीज़?|प्लीज़|please|अरे|अच्छा|तो|ok|ओके|क्या)[\\s,.!।]+){0,3}(?:(?:आप|तुम)\\s+)?(?:(?:(?:मेरी|मेरे|अपनी|अपने|तुम्हारी|तुम्हारे|आपकी|आपके|(?:teaport|टीपोर्ट)\\s?(?:की|के))\\s+)?(?:(?:(?:से|सै)टिंग(?:्स|्ज़|्ज़|्ज|स)?|\\bsettings?\\b)(?:\\s?(?:का|वाला)?\\s?(?:पेज़?|पेज़|page))?\\s?(?:को\\s)?(?:(?:खोल|दिखा)\\s?सक(?:ते|ती)\\s?(?:हो|हैं)|खोल(?:ो|िए|िये|ें|\\s?दो|\\s?दीजिए|\\s?दीजिये|\\s?दें|\\s?दे)|दिखा(?:ओ|इए|इये|एं|एँ|\\s?दो|\\s?दीजिए|\\s?दें)|पर\\s?ले\\s?चलो|\\bkholo|\\bkhol\\s?do|\\bkholiye|\\bdikhao|\\bdikha\\s?do|\\bopen\\s?karo)(?![\\u0900-\\u097F])(?:[\\s,،]+(?:teaport|धन्यवाद|थैंक्स|शुक्रिया|thanks|ना|प्लीज़?|प्लीज़|please|अभी|ज़रा|ज़रा|जरा|जल्दी|na|plz)(?![\\u0900-\\u097F\\w]))*[\\s.,!?।|;:…]*$)|(?:खोलो|खोलिए|खोल\\s?दो|दिखाओ|दिखाइए)\\s+(?:(?:मेरी|मेरे|अपनी|अपने|तुम्हारी|तुम्हारे|आपकी|आपके|(?:teaport|टीपोर्ट)\\s?(?:की|के))\\s+)?(?:से|सै)टिंग(?:्स|्ज़|्ज़|्ज|स)?(?![\\u0900-\\u097F])(?:[\\s,]+(?:धन्यवाद|थैंक्स|शुक्रिया|thanks|ना|प्लीज़?|प्लीज़|please|अभी|ज़रा|जरा|जल्दी|na|plz)(?![\\u0900-\\u097F\\w]))*[\\s.,!?।|;:…]*$)"

msgctxt "pattern"
msgid "^\\W*(?:(?:um+|uh+|uhm|er+m?|eh|hm+|ok|okay|hey|so|now|please|teaport|well|alright|right|no|yes|yeah|just|thanks|thank you|good ?night|bye)\\W+){0,3}(?:(?:can|could|would|will) you(?: please)? |you can )?(?:please )?(?:just )?go (?:back )?to sleep(?:[\\s,]+(?:now|please|then|for now|again|thanks a lot|thank you (?:so |very )?much|thanks|thank you|cheers|ok(?:ay)?|teaport)\\b)*[\\s.,!?;:…]*$"
msgstr "^\\W*(?:(?:अं|उम+|उह|हम्म|अम्म|teaport|टीपोर्ट|ज़रा|जरा|प्लीज़?|please|अरे|अच्छा|तो|ok|ओके|ठीक है|नहीं|हाँ|हां|चलो|बस|क्या|शुभ रात्रि|गुड नाइट)[\\s,.!।]+){0,3}(?:(?:आप|तुम)\\s+)?(?:(?:अब|वापस|फिर\\s+से)\\s+)*(?:सो\\s?(?:जाओ|जाइए|जाइये|जाएं|जाएँ|जा|सकते\\s?(?:हो|हैं)|सकती\\s?(?:हो|हैं))|सोने\\s+(?:जाओ|जाइए|जाइये|चले\\s+जाओ)|\\bso\\s+jao|\\bso\\s+jaiye)(?![ऀ-ॿ])(?:[\\s,،]+(?:teaport|धन्यवाद|थैंक्स|शुक्रिया|thanks|ना|प्लीज़?|please|अभी|अब|जल्दी|na|plz)(?![ऀ-ॿ\\w]))*[\\s.,!?।|;:…]*$"

msgctxt "spell"
msgid "slash"
msgstr "स्लैश"

msgid "that doesn't look like a key"
msgstr "यह कुंजी जैसी नहीं लगती"

msgid "the AI service didn't answer"
msgstr "AI सेवा ने जवाब नहीं दिया"

msgid "the AI service refused this key"
msgstr "AI सेवा ने यह कुंजी अस्वीकार कर दी"

msgid "the key is empty"
msgstr "कुंजी खाली है"

msgid "this account has no credit left"
msgstr "इस खाते में कोई क्रेडिट नहीं बचा है"

msgid "this box's key is set by its installer, so it can't be changed here"
msgstr "इस डिवाइस की कुंजी इसे इंस्टॉल करने वाले ने तय की है, इसलिए इसे यहाँ बदला नहीं जा सकता"

# A key the agent (OpenClaw) did not take: nothing changed (ai_account.save_key, #281).
msgid "Teaport couldn't switch everything over to this key, so it kept the one it had. Try again in a minute."
msgstr "Teaport सब कुछ इस कुंजी पर नहीं बदल सका, इसलिए उसने पहले वाली कुंजी ही रखी। एक मिनट बाद फिर से कोशिश करें।"

# One OpenClaw may have taken all the same: a mismatch is recorded (ai_account.save_key, #281).
msgid "Teaport couldn't finish switching to this key. Try saving it again."
msgstr "Teaport इस कुंजी पर पूरी तरह नहीं बदल सका। इसे फिर से सहेजें।"

