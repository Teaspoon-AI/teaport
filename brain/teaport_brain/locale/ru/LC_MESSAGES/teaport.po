# the user means: start
msgctxt "pattern"
msgid "\\b(?:set ?up|setup|configure|connect to|join|change|switch)\\b(?: (?:the|a|my|your|to|new|another|different)){0,3} ?wi-?fi\\b|\\bwi-?fi (?:set ?up|setup)\\b"
msgstr "\\b(?:настро(?:ить|й|йте|им|йка|йку|йки|йке)|подключи(?:ть|ться|сь|те|тесь|м|мся)?|переключи(?:ть|ться|сь|те|тесь|м)?|смени(?:ть|те|м)?|смена|смену|поменя(?:ть|й|йте|ем)|измени(?:ть|те)?)\\b(?:\\s+[\\w-]+){0,3}?\\s+(?:wi[- ]?fi|вай[- ]?фа\\w*)|(?:wi[- ]?fi|вай[- ]?фа\\w*)(?:\\s+\\w+)?\\s+(?:настро(?:ить|й|йте|им|йка|йку)|подключи(?:ть|ться|сь|те|тесь|м|мся)?)\\b"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\b(?:да|ага|угу|конечно|давай(?:те)?(?!\\s+не\\b)|хорошо|ладно|окей|ок|согласен|согласна|разумеется|пожалуйста|поехали|вперёд|вперед|начина(?:й|йте|ем)|начни(?:те)?|запуска(?:й|йте)|без проблем|нет проблем|почему (?:бы )?(?:и )?нет)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b(?:(?<!почему )(?<!бы )(?<!и )нет(?!\\s+проблем)|неа|не надо|не нужно|не хочу|не будем|не стоит|не сейчас|не сегодня|потом|позже|попозже|в другой раз|ни за что|отмен\\w*|забудь\\w*|стоп|хватит|неважно|не важно)\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:отмен\\w*|стоп|хватит|прекрати(?:ть|те)?|останови(?:сь|те|тесь|ть)?|перестань(?:те)?|прерви(?:те)?|прервать|выход|выйти|выйди(?:те)?|забудь\\w*|не надо)\\b"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:повтор\\w*|ещё раз|еще раз|снова|заново|пароль|имя сети|название сети|как называется|что ты сказал\\w*|что вы сказали|не расслышал\\w*|не услышал\\w*|не понял\\w*)\\b"

# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "Язык"
