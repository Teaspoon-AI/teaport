# the user means: start
msgctxt "pattern"
msgid "\\b(?:set(?:s|ting)?[- ]?up|(?:re)?configur(?:e|es|ing)|(?:re)?connect(?:s|ing)?|join(?:s|ing)?|chang(?:e|es|ing)|switch(?:es|ing)?)\\b(?: (?:the|a|my|your|our|this|that|to|onto|new|another|different|other|home|guest|me|us|it|yourself|the box|back)){0,4} ?(?:(?:wi[-‐‑ ]?fi|wireless)(?: (?:network|connection))?|network|hotspot)s?(?= *(?:[.,!?;:…]|$)| on \\w| (?:and|so|but|because|since|then|now|please|again|for|to|at|in|with|from|here|there|too|first|today|tonight|called|named|instead|as|if|when|or|that|which|i|we|ok|okay|thanks|thank|right|quickly)\\b)|\\bwi[-‐‑ ]?fi (?:set[- ]?up|setup)\\b"
msgstr "(?<!не )(?<!не надо )(?<!не нужно )(?<!нельзя )(?<!не могу )(?<!зачем )\\b(?:настро(?:ить|й|йте|им|йка|йку|йки|йке)|настраива(?:ть|й|йте)|подключа(?:ть|ться|йся|йтесь)|переключа(?:ть|ться|йся|йтесь)|меня(?:ть|й|йте)|подключи(?:ть|ться|сь|те|тесь|м|мся)?|переключи(?:ть|ться|сь|те|тесь|м)?|смени(?:ть|те|м)?|смена|смену|поменя(?:ть|й|йте|ем)|измени(?:ть|те)?)\\b(?:\\s+[\\w-]+){0,3}?\\s+(?:wi[- ]?fi|вай[- ]?фа\\w*)|(?:wi[- ]?fi|вай[- ]?фа\\w*)(?:\\s+\\w+)?\\s+(?:настро(?:ить|й|йте|им|йка|йку)|подключи(?:ть|ться|сь|те|тесь|м|мся)?)\\b"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\b(?:да|ага|угу|конечно|давай(?:те)?(?!\\s+не\\b)|хорошо|ладно|окей|ок|согласен|согласна|разумеется|пожалуйста|поехали|вперёд|вперед|начина(?:й|йте|ем)|начни(?:те)?|запуска(?:й|йте)|без проблем|нет проблем|почему (?:бы )?(?:и )?нет)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b(?:(?<!почему )(?<!бы )(?<!и )нет(?!\\s+проблем)|неа|не надо|не нужно|не хочу|не будем|не стоит|не сейчас|не сегодня|потом|позже|попозже|в другой раз|ни за что|отмен\\w*|забудь\\w*|стоп|хватит|неважно|не важно)\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:отмен\\w*|стоп|хватит|прекрати(?:ть|те)?|останови(?:сь|те|тесь|ть)?|перестань(?:те)?|прерви(?:те)?|прервать|выход|выйти|выйди(?:те)?|забудь\\w*|не надо)\\b"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:повтор\\w*|ещё раз|еще раз|снова|заново|пароль|имя сети|название сети|как называется|что ты сказал\\w*|что вы сказали|не расслышал\\w*|не услышал\\w*|не понял\\w*)\\b"

# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "Язык"

# The session arbiter (session_arbiter.py): one conversation at a time.
msgid "Sorry, I'm on a phone call right now. Please try again when it's over."
msgstr "Извините, я сейчас разговариваю по телефону. Попробуйте ещё раз, когда звонок закончится."

msgid "Sorry, I'm in another conversation right now. Please try again in a little while."
msgstr "Извините, у меня сейчас другой разговор. Попробуйте ещё раз чуть позже."

msgid "Sorry, a phone call is coming in and I have to take it. We can talk again when it's over."
msgstr "Извините, поступает звонок, и мне нужно ответить. Поговорим, когда он закончится."

# A phone call during a conversation (session_arbiter.py, call_prompt.py): the agent asks,
# steps away, and comes back.
#. Translators: {caller} is a name or a phone number, as the caller ID gives it.
msgid "Someone's calling me — {caller}. Should I step away for a moment?"
msgstr "Мне звонят — {caller}. Можно я ненадолго отвлекусь и отвечу?"

msgid "Someone's calling me. Should I step away for a moment?"
msgstr "Мне звонят. Можно я ненадолго отвлекусь и отвечу?"

msgid "I'll take the call — back in a moment."
msgstr "Я отвечу на звонок — скоро вернусь."

msgid "Sorry about that — where were we?"
msgstr "Извините за паузу — на чём мы остановились?"

msgid "Sorry, I couldn't get an answer just then. Could you try again?"
msgstr "Извините, сейчас не получилось получить ответ. Попробуете ещё раз?"

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. It can be fixed on my settings page."
msgstr "Извините, я сейчас не могу ответить: аккаунт, который я использую для ответов, требует внимания, и повторная попытка не поможет. Это можно исправить на моей странице настроек."

msgid "I still can't answer until my account is sorted out."
msgstr "Я всё ещё не могу отвечать, пока с моим аккаунтом не разберутся."

msgid "Sorry, I couldn't get an answer just then."
msgstr "Извините, сейчас не получилось получить ответ."

# The call recording notice (call_recording.py, #114).
msgid "This call is being recorded."
msgstr "Этот звонок записывается."

# No model at all (llm_error_speaker.py, #277).
msgid "I can't answer questions yet, because the account I use for my answers isn't set up."
msgstr "Я пока не могу отвечать на вопросы: аккаунт, который я использую для ответов, ещё не настроен."

msgid "I can't answer questions until I'm set up. Say \"set up Wi-Fi\" to get me online."
msgstr "Я не могу отвечать на вопросы, пока меня не настроят. Скажите «настрой вай-фай», чтобы подключить меня к интернету."

msgid "Sorry, I can't take calls right now. Please try again later."
msgstr "Извините, я сейчас не могу принимать звонки. Попробуйте позже."

msgid "I'm ready now. Please ask me again."
msgstr "Теперь я готов. Спросите меня ещё раз."

msgid "I'm ready now. Please start a new conversation with me."
msgstr "Теперь я готов. Начните, пожалуйста, новый разговор со мной."

# The first-boot setup (wifi_voice.py, first_boot.py, #278).
msgid "Hi, I'm Teaport. Let's get me online. Give me a moment to look for networks."
msgstr "Привет, я Teaport. Давайте подключим меня к интернету. Минутку, поищу доступные сети."

msgid "You can say \"set up Wi-Fi\" any time to try again."
msgstr "Чтобы попробовать ещё раз, в любой момент скажите «настрой вай-фай»."

msgid "I'm online now, so I've left setup mode."
msgstr "Интернет появился, поэтому режим подключения выключен."

# The sessions' own lines: busy / engine-unavailable, consult progress and tool acks (tools.py, agent_session.py).

msgid "Sorry, the voice assistant is busy with another session right now — please try again in a moment."
msgstr "Извините, голосовой ассистент сейчас занят другим сеансом — попробуйте ещё раз через минуту."

msgid "Sorry, I can't hear you right now — my speech recognition isn't available. Please try again in a moment."
msgstr "Извините, я вас сейчас не слышу — распознавание речи недоступно. Попробуйте ещё раз через минуту."

#. Translators: {phrase} is the model's own few words, in this language, on what is
#. being done for the user (in English: "looking up pastry shops on Burnet Road").
#. Only an English session says the {phrase} lines today (tools._status_phrase);
#. another says the plain ones (#120).
msgid "Sure — {phrase}."
msgstr "Конечно — {phrase}."

msgid "On it."
msgstr "Уже занимаюсь."

msgid "Still {phrase}."
msgstr "Ещё работаю над этим — {phrase}."

msgid "Still on it."
msgstr "Ещё работаю над этим."

msgid "This one's taking a bit longer."
msgstr "Это занимает чуть больше времени."

msgid "Looking up {q}."
msgstr "Ищу {q}."

msgid "Opening that page."
msgstr "Открываю страницу."

msgid "One moment, let me set that up."
msgstr "Секунду, сейчас подготовлю."

# Settings from the phone and the AI account (settings_access.py, ai_account.py, config_ui.py, wifi_setup.py, #279).
msgid "AI account"
msgstr "Аккаунт ИИ"

msgid "AI account (optional)"
msgstr "Аккаунт ИИ (необязательно)"

msgid "An account is connected."
msgstr "Аккаунт подключён."

msgid "Ask Teaport for a new one: say \"open my settings\"."
msgstr "Попросите у Teaport новый: скажите «открой настройки»."

msgid "Checking the key…"
msgstr "Проверка ключа…"

msgid "Code"
msgstr "Код"

msgid "Continue"
msgstr "Продолжить"

msgid "Enter the code Teaport gave you. It works once."
msgstr "Введите код, который дал вам Teaport. Он действует один раз."

msgid "I can't answer questions yet, because the account I use for my answers isn't set up. Say \"open my settings\" to set it up."
msgstr "Я пока не могу отвечать на вопросы: аккаунт, который я использую для ответов, ещё не настроен. Скажите «открой настройки», чтобы его настроить."

msgid "I couldn't use the AI account key you entered, so I didn't save it. Say \"open my settings\" to try again."
msgstr "Не получилось использовать введённый вами ключ аккаунта ИИ, поэтому он не сохранён. Скажите «открой настройки», чтобы попробовать ещё раз."

msgid "I need to be online for that. Say \"set up Wi-Fi\" to get me online."
msgstr "Для этого мне нужен интернет. Скажите «настрой вай-фай», чтобы подключить меня к интернету."

msgid "I've put a code on my screen. Scan it with your phone's camera, then tap the link that appears to get to my settings."
msgstr "На моём экране появился код. Отсканируйте его камерой телефона, затем нажмите на появившуюся ссылку, чтобы перейти к моим настройкам."

msgid "If your phone warns that the connection is not private, install {certificate} first, then ask Teaport for a new code."
msgstr "Если телефон предупреждает, что подключение не защищено, сначала установите {certificate}, а затем попросите у Teaport новый код."

msgid "If your phone warns that this page is not private, here is how to trust Teaport."
msgstr "Если телефон предупреждает, что эта страница не защищена, здесь описано, как настроить доверие к Teaport."

msgid "In your phone's browser, go to {address}, and enter the code {code}. It works once, for the next five minutes."
msgstr "В браузере телефона откройте {address} и введите код {code}. Он действует один раз в течение пяти минут."

msgid "Leave this empty to keep the account Teaport has now. To use your own OpenRouter account, paste its key here. Teaport checks the key once it's online, and says out loud whether it worked."
msgstr "Оставьте поле пустым, чтобы сохранить аккаунт, который Teaport использует сейчас. Чтобы использовать свой аккаунт OpenRouter, вставьте сюда его ключ. Teaport проверит ключ, как только подключится к интернету, и скажет вслух, подошёл ли он."

msgid "No account is connected yet."
msgstr "Аккаунт ещё не подключён."

msgid "OpenRouter key"
msgstr "Ключ OpenRouter"

msgid "Save anyway"
msgstr "Всё равно сохранить"

msgid "Settings"
msgstr "Настройки"

msgid "Show advanced"
msgstr "Показать дополнительные"

msgid "Sorry, my settings can't be reached from a phone on this box."
msgstr "Извините, на этом устройстве мои настройки недоступны с телефона."

msgid "Tap Continue to get to Teaport's settings on this phone. The code works once."
msgstr "Нажмите «Продолжить», чтобы открыть настройки Teaport на этом телефоне. Код действует один раз."

msgid "Teaport couldn't check this key: {reason}."
msgstr "Teaport не удалось проверить этот ключ: {reason}."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, paste a key from your OpenRouter account."
msgstr "Teaport использует для ответов аккаунт OpenRouter. Чтобы использовать свой, вставьте ключ из своего аккаунта OpenRouter."

msgid "Teaport's certificate"
msgstr "сертификат Teaport"

msgid "Test and save"
msgstr "Проверить и сохранить"

msgid "That code didn't work. Check it, or ask Teaport for a new one."
msgstr "Этот код не подошёл. Проверьте его или попросите у Teaport новый."

msgid "The key works, and it's saved. Teaport uses it from your next conversation."
msgstr "Ключ работает и сохранён. Teaport начнёт использовать его со следующего разговора."

msgid "This code has expired"
msgstr "Срок действия этого кода истёк"

msgid "This code was already used"
msgstr "Этот код уже использован"

msgid "This key didn't work: {reason}."
msgstr "Этот ключ не подошёл: {reason}."

msgid "Your AI account is connected."
msgstr "Ваш аккаунт ИИ подключён."

msgid "no AI service is set up on this box"
msgstr "на этом устройстве не настроен сервис ИИ"

msgctxt "pattern"
msgid "^\\W*(?:(?:um+|uh+|uhm|er+m?|eh|hm+|ok|okay|hey|so|now|please|teaport|well|alright|right)\\W+){0,3}(?:(?:can|could|would|will) you(?: please)? )?(?:open|show|bring up|pull up|go to|get)(?: up)?(?: me)?(?: to)? (?:(?:my|your|the|teaport's|teaport) )?settings(?:[\\s,]+(?:page|please|now|for me|thanks a lot|thank you (?:so |very )?much|thanks|thank you|cheers|ok(?:ay)?|teaport)\\b)*[\\s.,!?;:…]*$"
msgstr "^\\W*(?:(?:э+|эм+|мм+|teaport|типорт|ну|так|окей|ок|слушай|пожалуйста|а|и)\\W+){0,3}(?:(?:(?:ты\\s+)?можешь|(?:вы\\s+)?можете|(?:(?:ты|вы)\\s+)?(?:не\\s+)?(?:мог|могла|могли)\\s+бы(?:\\s+(?:ты|вы))?)(?:\\s+(?:мне|нам|пожалуйста))*\\s+)?(?:(?:открой(?:те)?|покажи(?:те)?|зайди(?:те)?|перейди(?:те)?|открыть|показать)(?:\\s+(?:мне|нам|пожалуйста|в|на|ка))*\\s+(?:(?:мои|свои|твои|ваши)\\s+настройки|настройки|(?:(?:мою|свою|твою|вашу)\\s+)?страницу\\s+настроек)(?:[\\s,،]+(?:teaport|большое спасибо|спасибо|пожалуйста|сейчас)\\b)*[\\s.,!?;:…]*$|(?:(?:мои|свои|твои)\\s+)?настройки\\s+(?:пожалуйста\\s+)?(?:открой(?:те)?|покажи(?:те)?)(?:[\\s,،]+(?:teaport|большое спасибо|спасибо|пожалуйста|сейчас)\\b)*[\\s.,!?;:…]*$)"

msgctxt "spell"
msgid "slash"
msgstr "слэш"

msgid "that doesn't look like a key"
msgstr "это не похоже на ключ"

msgid "the AI service didn't answer"
msgstr "сервис ИИ не ответил"

msgid "the AI service refused this key"
msgstr "сервис ИИ отклонил этот ключ"

msgid "the key is empty"
msgstr "ключ пустой"

msgid "this account has no credit left"
msgstr "на этом аккаунте не осталось средств"

msgid "this box's key is set by its installer, so it can't be changed here"
msgstr "ключ этого устройства задан при установке, поэтому изменить его здесь нельзя"

# A key the agent (OpenClaw) did not take: nothing changed (ai_account.save_key, #281).
msgid "Teaport couldn't switch everything over to this key, so it kept the one it had. Try again in a minute."
msgstr "Teaport не смог перевести всё на этот ключ, поэтому оставил прежний. Попробуйте ещё раз через минуту."

# One OpenClaw may have taken all the same: a mismatch is recorded (ai_account.save_key, #281).
msgid "Teaport couldn't finish switching to this key. Try saving it again."
msgstr "Teaport не смог до конца перейти на этот ключ. Сохраните его ещё раз."

# The same without its pointer, where "open my settings" is not heard (wifi_voice.py).
msgid "I couldn't use the AI account key you entered, so I didn't save it."
msgstr "Не получилось использовать введённый вами ключ аккаунта ИИ, поэтому он не сохранён."

# The trial credit (credit.py, llm_error_speaker.py, #280).
msgid "Quick note: I've used half of my trial credit. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "Небольшое напоминание: половина моего пробного баланса уже израсходована. Когда будет минутка, скажите «открой настройки», чтобы подключить свой аккаунт."

msgid "Quick note: my trial credit is almost used up. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "Небольшое напоминание: мой пробный баланс почти закончился. Когда будет минутка, скажите «открой настройки», чтобы подключить свой аккаунт."

msgid "My trial credit has run out, so I can't answer questions until you connect your own account. Say \"open my settings\" to do that."
msgstr "Мой пробный баланс закончился, поэтому я не могу отвечать на вопросы, пока вы не подключите свой аккаунт. Для этого скажите «открой настройки»."

msgid "My trial credit has run out, so I can't answer questions until your own account is connected."
msgstr "Мой пробный баланс закончился, поэтому я не могу отвечать на вопросы, пока не будет подключён ваш собственный аккаунт."

msgid "Teaport is using its included trial credit."
msgstr "Teaport использует входящий в комплект пробный баланс."

msgid "Half of the trial credit is used. Connect your own account to keep Teaport answering."
msgstr "Половина пробного баланса израсходована. Подключите свой аккаунт, чтобы Teaport продолжал отвечать."

msgid "The trial credit is almost used up: about {amount} left. Connect your own account to keep Teaport answering."
msgstr "Пробный баланс почти закончился: осталось около {amount}. Подключите свой аккаунт, чтобы Teaport продолжал отвечать."

msgid "The trial credit has run out. Connect your own account so Teaport can answer again."
msgstr "Пробный баланс закончился. Подключите свой аккаунт, чтобы Teaport снова мог отвечать."

msgid "Back to settings"
msgstr "Назад к настройкам"

msgid "Code from OpenRouter"
msgstr "Код от OpenRouter"

msgid "Connect your OpenRouter account"
msgstr "Подключить аккаунт OpenRouter"

msgid "Connecting…"
msgstr "Подключение…"

msgid "Finish"
msgstr "Готово"


msgid "OpenRouter didn't accept the sign-in"
msgstr "OpenRouter не принял вход"

msgid "OpenRouter didn't connect the account. You can try again from Teaport's settings, or paste a key there instead."
msgstr "OpenRouter не подключил аккаунт. Можно попробовать снова в настройках Teaport или вставить там ключ."


msgid "Tap Finish to connect your OpenRouter account to Teaport."
msgstr "Нажмите «Готово», чтобы подключить аккаунт OpenRouter к Teaport."

msgid "Teaport couldn't connect your OpenRouter account"
msgstr "Teaport не удалось подключить ваш аккаунт OpenRouter"

msgid "Teaport couldn't connect your OpenRouter account: {reason}. You can try again from Teaport's settings, or paste a key there instead."
msgstr "Teaport не удалось подключить ваш аккаунт OpenRouter: {reason}. Можно попробовать снова в настройках Teaport или вставить там ключ."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, connect it here, or paste a key from it."
msgstr "Teaport использует для ответов аккаунт OpenRouter. Чтобы использовать свой, подключите его здесь или вставьте из него ключ."

msgid "Teaport uses your OpenRouter account from your next conversation."
msgstr "Teaport начнёт использовать ваш аккаунт OpenRouter со следующего разговора."

msgid "Teaport's settings have closed on this phone. Say \"open my settings\", then connect again."
msgstr "Настройки Teaport на этом телефоне закрылись. Скажите «открой настройки», а затем снова подключите аккаунт."

msgid "This connection has expired. Go back to Teaport's settings and connect again."
msgstr "Время на подключение истекло. Вернитесь в настройки Teaport и снова подключите аккаунт."



msgid "Your OpenRouter account is connected"
msgstr "Ваш аккаунт OpenRouter подключён"

msgid "Connecting your OpenRouter account to Teaport"
msgstr "Подключаем ваш аккаунт OpenRouter к Teaport"

msgid "Continue to Teaport"
msgstr "Перейти к Teaport"

msgid "Copied"
msgstr "Скопировано"

msgid "Copy code"
msgstr "Скопировать код"

msgid "If OpenRouter showed you a code, paste it here."
msgstr "Если OpenRouter показал вам код, вставьте его сюда."

msgid "If that doesn't work: copy this code, open Teaport's settings on this phone, and paste it into {field}. It works once, in the next ten minutes."
msgstr "Если не получилось: скопируйте этот код, откройте настройки Teaport на этом телефоне и вставьте его в поле «{field}». Код работает один раз, в течение десяти минут."

msgid "If your phone warns that the connection isn't private, it's the same warning you saw when you opened Teaport's settings."
msgstr "Если телефон предупреждает, что подключение не защищено, это то же предупреждение, что и при открытии настроек Teaport."

msgid "Now let's connect your OpenRouter account. I've put a code on my screen. Scan it with your phone's camera, tap the link that appears, and follow the steps on your phone."
msgstr "Теперь подключим ваш аккаунт OpenRouter. Я вывел код на экран. Отсканируйте его камерой телефона, нажмите на появившуюся ссылку и следуйте шагам на телефоне."

msgid "Now let's connect your OpenRouter account. In your phone's browser, go to {address}, enter the code {code}, and follow the steps there. The code works once, for the next five minutes."
msgstr "Теперь подключим ваш аккаунт OpenRouter. В браузере телефона откройте {address}, введите код {code} и следуйте шагам. Код работает один раз, в течение пяти минут."

msgid "Save it again"
msgstr "Сохранить ещё раз"

msgid "Teaport couldn't save the key"
msgstr "Teaport не удалось сохранить ключ"

msgid "Teaport no longer has that key. Tap Connect your OpenRouter account to sign in again."
msgstr "У Teaport больше нет этого ключа. Нажмите «Подключить аккаунт OpenRouter», чтобы войти снова."

msgid "Teaport still has the key from your OpenRouter sign-in. Tap Save it again to try once more."
msgstr "У Teaport ещё есть ключ после вашего входа в OpenRouter. Нажмите «Сохранить ещё раз», чтобы попробовать снова."

msgid "That doesn't look like a code from OpenRouter. Check it and paste it again."
msgstr "Это не похоже на код от OpenRouter. Проверьте его и вставьте ещё раз."

msgid "There's no sign-in waiting for a code. Tap Connect your OpenRouter account to start a new one."
msgstr "Сейчас нет входа, который ждёт код. Нажмите «Подключить аккаунт OpenRouter», чтобы начать новый."

msgid "This link doesn't lead to a Teaport on a home network, so this page won't go on with it."
msgstr "Эта ссылка не ведёт к Teaport в домашней сети, поэтому страница не будет по ней переходить."

msgid "To connect your OpenRouter account by signing in instead, leave this empty and finish setting up Wi-Fi. Then Teaport shows you how, or you can say \"open my settings\"."
msgstr "Чтобы подключить аккаунт OpenRouter через вход, оставьте это поле пустым и закончите настройку Wi-Fi. Потом Teaport покажет, как это сделать, или скажите «открой настройки»."

msgid "You sign in to OpenRouter on this phone and approve Teaport. OpenRouter then shows a code: copy it, come back to Teaport's settings, and paste it into Code from OpenRouter."
msgstr "Вы входите в OpenRouter на этом телефоне и разрешаете доступ Teaport. Затем OpenRouter показывает код: скопируйте его, вернитесь в настройки Teaport и вставьте его в поле «Код от OpenRouter»."

msgid "You sign in to OpenRouter on this phone and approve Teaport. Then a Teaport page asks you to tap Finish."
msgstr "Вы входите в OpenRouter на этом телефоне и разрешаете доступ Teaport. Затем страница Teaport попросит нажать «Готово»."

msgid "Your phone needs to be on the same Wi-Fi as Teaport. If it doesn't go on by itself, tap the button."
msgstr "Телефон должен быть в той же сети Wi-Fi, что и Teaport. Если переход не произойдёт сам, нажмите кнопку."

msgid "Your OpenRouter account has no credit yet, so Teaport can't answer until you add some at openrouter.ai/settings/credits."
msgstr "На вашем аккаунте OpenRouter пока нет средств, поэтому Teaport не сможет отвечать, пока вы не пополните баланс на openrouter.ai/settings/credits."

msgid "Your AI account is connected, but it has no credit yet. Add some on OpenRouter's website, and then I can answer."
msgstr "Ваш аккаунт ИИ подключён, но на нём пока нет средств. Пополните баланс на сайте OpenRouter, и тогда я смогу отвечать."

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. Say \"open my settings\" to fix it."
msgstr "Извините, я сейчас не могу ответить: аккаунт, который я использую для ответов, требует внимания, и повторная попытка не поможет. Скажите «открой настройки», чтобы это исправить."

# The recovery line (llm_text_guard.recovery_text): a collapsed or empty reply (#15).
msgid "Sorry, I lost my train of thought there. Could you say that again?"
msgstr "Извините, я потерял мысль. Можете повторить?"
