# the user means: start
msgctxt "pattern"
msgid "\\b(?:set ?up|setup|configure|connect to|join|change|switch)\\b(?: (?:the|a|my|your|to|new|another|different)){0,3} ?wi-?fi\\b|\\bwi-?fi (?:set ?up|setup)\\b"
msgstr "(?:[اأإ]عداد|ضبط|تهيئ[ةه]|توصيل|وصّ?ل|[اأإ]تصل|[اأإ]تصال|[اأإ]نضم|تغيير|تبديل|ربط|جهّ?ز|تجهيز)\\S*(?:\\s+\\S+){0,3}?\\s+\\S*?(?:wi[- ]?fi|وا[يى] ?فا[يى]|لا ?سلكي)|(?:wi[- ]?fi|وا[يى] ?فا[يى])\\S*(?:\\s+\\S+)?\\s+\\S*?(?:[اأإ]عداد|ضبط|تهيئ[ةه])"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\b[وف]?(?:نعم|[اأ]جل|بلى|طبع[ًا]+|حسن[ًا]+|موافق[ةه]?|تمام|[اأ]كيد|بالت[اأ]كيد|[اإ]بدأ|[لف]?نبدأ|هيا|تفضل|[اأ]وك[يى]|[اأ]يو[هة]|طيب|يلا|بالطبع|بكل سرور|من فضلك|لو سمحت|لا مشكل[ةه]|لا ب[اأ]س|لا [اأ]?مانع|لم لا|لما لا)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b[وف]?(?:(?<!لم )(?<!لما )لا(?!\\s+(?:مشكل[ةه]|ب[اأ]س|[اأ]?مانع))|كلّ?ا|لأ|لاء|[اأ]بد[ًا]+|ليس الآن|ليس الان|لاحق[ًا]+|فيما بعد|في وقت لاحق|[اإأ]لغ(?:ا[ءئ]|[يى]|ه)?|توقف|كفى|كفاي[ةه]|انس[ىي]?)\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b[وف]?(?:[اإأ]لغ(?:ا[ءئ]|[يى]|ه)?|توقف(?:ي|وا)?|[اأ]وقف(?:ه|ها|ي)?|[اإ]يقاف|كفى|كفاي[ةه]|اخرج|خروج|انس[ىي]?|[اإ]نهاء)\\b"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b[وف]?(?:[اأإ]عد(?:ها|ه|ي)?|[اأ]عيدي?|[اإ]عاد[ةه]|كرّ?ر\\S*|تكرار|مر[ةه] [اأ]خر[ىي]|مر[ةه] ثاني[ةه]|من جديد|ماذا قلت|كلم[ةه] المرور|كلم[ةه] السر|الباسورد|اسم الشبك[ةه]|لم [اأ]سمع)\\b"

