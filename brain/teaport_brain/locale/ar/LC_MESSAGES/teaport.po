# the user means: start
msgctxt "pattern"
msgid "\\b(?:set(?:s|ting)?[- ]?up|(?:re)?configur(?:e|es|ing)|(?:re)?connect(?:s|ing)?|join(?:s|ing)?|chang(?:e|es|ing)|switch(?:es|ing)?)\\b(?: (?:the|a|my|your|our|this|that|to|onto|new|another|different|other|home|guest|me|us|it|yourself|the box|back)){0,4} ?(?:(?:wi[-‐‑ ]?fi|wireless)(?: (?:network|connection))?|network|hotspot)s?(?= *(?:[.,!?;:…]|$)| on \\w| (?:and|so|but|because|since|then|now|please|again|for|to|at|in|with|from|here|there|too|first|today|tonight|called|named|instead|as|if|when|or|that|which|i|we|ok|okay|thanks|thank|right|quickly)\\b)|\\bwi[-‐‑ ]?fi (?:set[- ]?up|setup)\\b"
msgstr "(?:[اأإ]عداد|ضبط|تهيئ[ةه]|توصيل|وصّ?ل|[اأإ]تصل|[اأإ]تصال|[اأإ]نضم|تغيير|تبديل|ربط|جهّ?ز|تجهيز)\\S*(?:\\s+\\S+){0,3}?\\s+\\S*?(?:wi[- ]?fi|وا[يى] ?فا[يى]|لا ?سلكي)|(?:wi[- ]?fi|وا[يى] ?فا[يى])\\S*(?:\\s+\\S+)?\\s+\\S*?(?:[اأإ]عداد|ضبط|تهيئ[ةه])"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\b[وف]?(?:نعم|[اأ]جل|بلى|طبع[ًا]+|حسن[ًا]+|موافق[ةه]?|تمام|[اأ]كيد|بالت[اأ]كيد|[اإ]بدأ|[لف]?نبدأ|هيا|تفضل|[اأ]وك[يى]|[اأ]يو[هة]|طيب|يلا|بالطبع|بكل سرور|من فضلك|لو سمحت|لا مشكل[ةه]|لا ب[اأ]س|لا [اأ]?مانع|لم لا|لما لا)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b[وف]?(?:(?<!لم )(?<!لما )لا(?!\\s+(?:مشكل[ةه]|ب[اأ]س|[اأ]?مانع))|كلّ?ا|لأ|لاء|[اأ]بد[ًا]+|ليس الآن|ليس الان|لاحق[ًا]+|فيما بعد|في وقت لاحق|[اإأ]لغ(?:ا[ءئ]|[يى]|ه)?|توقف|كفى|كفاي[ةه]|انس[ىي]?)\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b[وف]?(?:[اإأ]لغ(?:ا[ءئ]|[يى]|ه)?|توقف(?:ي|وا)?|[اأ]وقف(?:ه|ها|ي)?|[اإ]يقاف|كفى|كفاي[ةه]|اخرج|خروج|انس[ىي]?|[اإ]نهاء)\\b"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b[وف]?(?:[اأإ]عد(?:ها|ه|ي)?|[اأ]عيدي?|[اإ]عاد[ةه]|كرّ?ر\\S*|تكرار|مر[ةه] [اأ]خر[ىي]|مر[ةه] ثاني[ةه]|من جديد|ماذا قلت|كلم[ةه] المرور|كلم[ةه] السر|الباسورد|اسم الشبك[ةه]|لم [اأ]سمع)\\b"

# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "اللغة"

# The session arbiter (session_arbiter.py): one conversation at a time.
msgid "Sorry, I'm on a phone call right now. Please try again when it's over."
msgstr "عذرًا، أنا في مكالمة هاتفية الآن. يرجى المحاولة مرة أخرى عند انتهائها."

msgid "Sorry, I'm in another conversation right now. Please try again in a little while."
msgstr "عذرًا، أنا في محادثة أخرى الآن. يرجى المحاولة مرة أخرى بعد قليل."

msgid "Sorry, a phone call is coming in and I have to take it. We can talk again when it's over."
msgstr "عذرًا، هناك مكالمة واردة ويجب أن أرد عليها. يمكننا التحدث مجددًا عند انتهائها."

# A phone call during a conversation (session_arbiter.py, call_prompt.py): the agent asks,
# steps away, and comes back.
#. Translators: {caller} is a name or a phone number, as the caller ID gives it.
msgid "Someone's calling me — {caller}. Should I step away for a moment?"
msgstr "هناك من يتصل بي — {caller}. هل أبتعد لحظة لأرد؟"

msgid "Someone's calling me. Should I step away for a moment?"
msgstr "هناك من يتصل بي. هل أبتعد لحظة لأرد؟"

msgid "I'll take the call — back in a moment."
msgstr "سأرد على المكالمة — سأعود بعد لحظة."

msgid "Sorry about that — where were we?"
msgstr "عذرًا على المقاطعة — أين كنا؟"

msgid "Sorry, I couldn't get an answer just then. Could you try again?"
msgstr "عذرًا، لم أتمكن من الحصول على إجابة الآن. هل يمكنك المحاولة مرة أخرى؟"

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. It can be fixed on my settings page."
msgstr "عذرًا، لا أستطيع الإجابة الآن: الحساب الذي أستخدمه لإجاباتي يحتاج إلى مراجعة، ولن تفيد إعادة المحاولة. يمكن إصلاحه من صفحة الإعدادات الخاصة بي."

msgid "I still can't answer until my account is sorted out."
msgstr "ما زلتُ لا أستطيع الإجابة حتى تتم تسوية مشكلة حسابي."

msgid "Sorry, I couldn't get an answer just then."
msgstr "عذرًا، لم أتمكن من الحصول على إجابة الآن."

# The call recording notice (call_recording.py, #114).
msgid "This call is being recorded."
msgstr "يتم تسجيل هذه المكالمة."

# No model at all (llm_error_speaker.py, #277).
msgid "I can't answer questions yet, because the account I use for my answers isn't set up."
msgstr "لا أستطيع الإجابة عن الأسئلة بعد، لأن الحساب الذي أستخدمه لإجاباتي لم تتم تهيئته."

msgid "I can't answer questions until I'm set up. Say \"set up Wi-Fi\" to get me online."
msgstr "لا أستطيع الإجابة عن الأسئلة قبل أن تكتمل تهيئتي. قل «إعداد الواي فاي» لتوصيلي بالإنترنت."

msgid "Sorry, I can't take calls right now. Please try again later."
msgstr "عذرًا، لا أستطيع استقبال المكالمات الآن. يرجى المحاولة مرة أخرى لاحقًا."

msgid "I'm ready now. Please ask me again."
msgstr "أنا جاهز الآن. اسألني مرة أخرى من فضلك."

msgid "I'm ready now. Please start a new conversation with me."
msgstr "أنا جاهز الآن. ابدأ محادثة جديدة معي من فضلك."

# The first-boot setup (wifi_voice.py, first_boot.py, #278).
msgid "Hi, I'm Teaport. Let's get me online. Give me a moment to look for networks."
msgstr "مرحبًا، أنا Teaport. لنوصلني بالإنترنت. لحظة واحدة، سأبحث عن الشبكات المتاحة."

msgid "You can say \"set up Wi-Fi\" any time to try again."
msgstr "يمكنك قول «إعداد الواي فاي» في أي وقت لإعادة المحاولة."

msgid "I'm online now, so I've left setup mode."
msgstr "أصبحتُ متصلًا بالإنترنت الآن، لذا خرجتُ من وضع التوصيل."

# The sessions' own lines: busy / engine-unavailable, consult progress and tool acks (tools.py, agent_session.py).

msgid "Sorry, the voice assistant is busy with another session right now — please try again in a moment."
msgstr "عذرًا، المساعد الصوتي مشغول بجلسة أخرى الآن. يُرجى المحاولة مجددًا بعد قليل."

msgid "Sorry, I can't hear you right now — my speech recognition isn't available. Please try again in a moment."
msgstr "عذرًا، لا أستطيع سماعك الآن، فالتعرف على الكلام غير متاح. يُرجى المحاولة مجددًا بعد قليل."

msgid "Still working on that — {topic}."
msgstr "ما زلت أعمل على ذلك — {topic}."

msgid "Still working on it."
msgstr "ما زلت أعمل على ذلك."

msgid "Almost there — {topic}."
msgstr "اقتربنا من الانتهاء — {topic}."

msgid "Almost there — hang tight."
msgstr "اقتربنا من الانتهاء، لحظات."

msgid "Looking up {q}."
msgstr "أبحث عن {q}."

msgid "Opening that page."
msgstr "أفتح تلك الصفحة."

msgid "I'll work on that — give me a moment."
msgstr "سأعمل على ذلك، لحظة."

msgid "One moment, let me set that up."
msgstr "لحظة، سأجهّز ذلك."

# Settings from the phone and the AI account (settings_access.py, ai_account.py, config_ui.py, wifi_setup.py, #279).
msgid "AI account"
msgstr "حساب الذكاء الاصطناعي"

msgid "AI account (optional)"
msgstr "حساب الذكاء الاصطناعي (اختياري)"

msgid "An account is connected."
msgstr "تم ربط حساب."

msgid "Ask Teaport for a new one: say \"open my settings\"."
msgstr "اطلب رمزًا جديدًا من Teaport: قل «افتح الإعدادات»."

msgid "Checking the key…"
msgstr "جارٍ التحقق من المفتاح…"

msgid "Code"
msgstr "الرمز"

msgid "Continue"
msgstr "متابعة"

msgid "Enter the code Teaport gave you. It works once."
msgstr "أدخل الرمز الذي أعطاك إياه Teaport. يعمل مرة واحدة فقط."

msgid "I can't answer questions yet, because the account I use for my answers isn't set up. Say \"open my settings\" to set it up."
msgstr "لا أستطيع الإجابة عن الأسئلة بعد، لأن الحساب الذي أستخدمه لإجاباتي لم تتم تهيئته. يُرجى قول «افتح الإعدادات» لتهيئته."

msgid "I couldn't use the AI account key you entered, so I didn't save it. Say \"open my settings\" to try again."
msgstr "تعذّر استخدام مفتاح حساب الذكاء الاصطناعي الذي أُدخل، لذا لم يتم حفظه. يُرجى قول «افتح الإعدادات» للمحاولة مرة أخرى."

msgid "I need to be online for that. Say \"set up Wi-Fi\" to get me online."
msgstr "يلزمني الاتصال بالإنترنت لذلك. يُرجى قول «إعداد الواي فاي» لتوصيلي بالإنترنت."

msgid "I've put a code on my screen. Scan it with your phone's camera, then tap the link that appears to get to my settings."
msgstr "عرضتُ رمزًا على شاشتي. يُرجى مسحه بكاميرا هاتفك، ثم النقر على الرابط الذي يظهر للوصول إلى إعداداتي."

msgid "If your phone warns that the connection is not private, install {certificate} first, then ask Teaport for a new code."
msgstr "إذا نبّهك هاتفك إلى أن الاتصال ليس خاصًا، فثبّت {certificate} أولًا، ثم اطلب رمزًا جديدًا من Teaport."

msgid "If your phone warns that this page is not private, here is how to trust Teaport."
msgstr "إذا نبّهك هاتفك إلى أن هذه الصفحة ليست خاصة، فإليك طريقة الوثوق بـ Teaport."

msgid "In your phone's browser, go to {address}, and enter the code {code}. It works once, for the next five minutes."
msgstr "في متصفح هاتفك، يُرجى الانتقال إلى {address} وإدخال الرمز {code}. يعمل الرمز مرة واحدة فقط، خلال الدقائق الخمس القادمة."

msgid "Leave this empty to keep the account Teaport has now. To use your own OpenRouter account, paste its key here. Teaport checks the key once it's online, and says out loud whether it worked."
msgstr "اترك هذا الحقل فارغًا للإبقاء على الحساب الذي يستخدمه Teaport حاليًا. لاستخدام حسابك الخاص على OpenRouter، الصق مفتاحه هنا. يتحقق Teaport من المفتاح بمجرد اتصاله بالإنترنت، ويُعلن بصوت مسموع ما إذا نجح."

msgid "No account is connected yet."
msgstr "لم يتم ربط أي حساب بعد."

msgid "OpenRouter key"
msgstr "مفتاح OpenRouter"

msgid "Save anyway"
msgstr "حفظ على أي حال"

msgid "Settings"
msgstr "الإعدادات"

msgid "Show advanced"
msgstr "إظهار الإعدادات المتقدمة"

msgid "Sorry, my settings can't be reached from a phone on this box."
msgstr "عذرًا، لا يمكن الوصول إلى إعداداتي من هاتف على هذا الجهاز."

msgid "Tap Continue to get to Teaport's settings on this phone. The code works once."
msgstr "انقر على «متابعة» للوصول إلى إعدادات Teaport على هذا الهاتف. يعمل الرمز مرة واحدة فقط."

msgid "Teaport couldn't check this key: {reason}."
msgstr "تعذّر على Teaport التحقق من هذا المفتاح: {reason}."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, paste a key from your OpenRouter account."
msgstr "يستخدم Teaport حسابًا على OpenRouter لإجاباته. لاستخدام حسابك الخاص، الصق مفتاحًا من حسابك على OpenRouter."

msgid "Teaport's certificate"
msgstr "شهادة Teaport"

msgid "Test and save"
msgstr "اختبار وحفظ"

msgid "That code didn't work. Check it, or ask Teaport for a new one."
msgstr "لم ينجح هذا الرمز. تحقّق منه، أو اطلب رمزًا جديدًا من Teaport."

msgid "The key works, and it's saved. Teaport uses it from your next conversation."
msgstr "المفتاح يعمل، وتم حفظه. سيستخدمه Teaport بدءًا من محادثتك التالية."

msgid "This code has expired"
msgstr "انتهت صلاحية هذا الرمز"

msgid "This code was already used"
msgstr "تم استخدام هذا الرمز من قبل"

msgid "This key didn't work: {reason}."
msgstr "لم ينجح هذا المفتاح: {reason}."

msgid "Your AI account is connected."
msgstr "تم ربط حساب الذكاء الاصطناعي الخاص بك."

msgid "no AI service is set up on this box"
msgstr "لا توجد خدمة ذكاء اصطناعي مُهيّأة على هذا الجهاز"

msgctxt "pattern"
msgid "^\\W*(?:(?:um+|uh+|uhm|er+m?|eh|hm+|ok|okay|hey|so|now|please|teaport|well|alright|right)\\W+){0,3}(?:open|show|bring up|pull up|go to|get)(?: up)?(?: me)?(?: to)? (?:(?:my|your|the|teaport's|teaport) )?settings(?= *(?:[.,!?;:…]|$)| (?:page|please|now)\\b)"
msgstr "^\\W*(?:(?:اه|ام+|إم+|يعني|من فضلك|لو سمحت|يرجى|رجاء|طيب|حسنا|يا\\s*teaport|teaport|يا\\s*تيبورت|تيبورت)\\W+){0,2}(?:[وف]?(?:افتح(?:ي|وا)?(?:\\s?لي)?|اعرض(?:ي|وا)?(?:\\s?لي)?|[اأ]ظهر(?:ي|وا)?(?:\\s?لي)?|ور(?:ي)?ني|فرجيني|خذني\\s+[اإ]لى|روح\\s+على|اذهب\\s+[اإ]لى|انتقل\\s+[اإ]لى)|فتح|عرض)\\s+(?:صفح[ةه]\\s+)?(?:ال[اإأ]عدادات|[اإأ]عدادات(?:ك|ي)|الضبط|settings)(?:\\s+(?:الخاص[ةه]\\s+بك|الخاص[ةه]\\s+بي|teaport|تيبورت))?(?=\\s*(?:[.,!?؟؛:…،]|$)|\\s+(?:من فضلك|لو سمحت|الآن|الان|رجاء)(?:\\s|$|[.,!،]))"

msgctxt "spell"
msgid "slash"
msgstr "شرطة مائلة"

msgid "that doesn't look like a key"
msgstr "لا يبدو هذا مفتاحًا"

msgid "the AI service didn't answer"
msgstr "لم تستجب خدمة الذكاء الاصطناعي"

msgid "the AI service refused this key"
msgstr "رفضت خدمة الذكاء الاصطناعي هذا المفتاح"

msgid "the key is empty"
msgstr "المفتاح فارغ"

msgid "this account has no credit left"
msgstr "لا يوجد رصيد متبقٍ في هذا الحساب"

msgid "this box's key is set by its installer, so it can't be changed here"
msgstr "مفتاح هذا الجهاز يحدده من قام بتثبيته، لذا لا يمكن تغييره هنا"

# A key the agent (OpenClaw) did not take: nothing changed (ai_account.save_key, #281).
msgid "Teaport couldn't switch everything over to this key, so it kept the one it had. Try again in a minute."
msgstr "لم يتمكن Teaport من تحويل كل شيء إلى هذا المفتاح، لذا احتفظ بالمفتاح الذي كان لديه. حاول مرة أخرى بعد دقيقة."

# One OpenClaw may have taken all the same: a mismatch is recorded (ai_account.save_key, #281).
msgid "Teaport couldn't finish switching to this key. Try saving it again."
msgstr "لم يتمكن Teaport من إكمال التحويل إلى هذا المفتاح. حاول حفظه مرة أخرى."

# The same without its pointer, where "open my settings" is not heard (wifi_voice.py).
msgid "I couldn't use the AI account key you entered, so I didn't save it."
msgstr "تعذّر استخدام مفتاح حساب الذكاء الاصطناعي الذي أُدخل، لذا لم يتم حفظه."

# The trial credit (credit.py, llm_error_speaker.py, #280).
msgid "Quick note: I've used half of my trial credit. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "ملاحظة سريعة: استُخدم نصف رصيدي التجريبي. عندما يتسع وقتك، يُرجى قول «افتح الإعدادات» لربط حسابك الخاص."

msgid "Quick note: my trial credit is almost used up. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "ملاحظة سريعة: رصيدي التجريبي يكاد ينفد. عندما يتسع وقتك، يُرجى قول «افتح الإعدادات» لربط حسابك الخاص."

msgid "My trial credit has run out, so I can't answer questions until you connect your own account. Say \"open my settings\" to do that."
msgstr "نفد رصيدي التجريبي، لذا لا أستطيع الإجابة عن الأسئلة حتى يتم ربط حسابك الخاص. يُرجى قول «افتح الإعدادات» لربطه."

msgid "My trial credit has run out, so I can't answer questions until your own account is connected."
msgstr "نفد رصيدي التجريبي، لذا لا أستطيع الإجابة عن الأسئلة حتى يتم ربط حسابك الخاص."

msgid "Teaport is using its included trial credit."
msgstr "يستخدم Teaport الرصيد التجريبي المضمّن معه."

msgid "Half of the trial credit is used. Connect your own account to keep Teaport answering."
msgstr "تم استخدام نصف الرصيد التجريبي. اربط حسابك الخاص ليواصل Teaport الإجابة."

msgid "The trial credit is almost used up: about {amount} left. Connect your own account to keep Teaport answering."
msgstr "الرصيد التجريبي يكاد ينفد: يتبقى نحو {amount}. اربط حسابك الخاص ليواصل Teaport الإجابة."

msgid "The trial credit has run out. Connect your own account so Teaport can answer again."
msgstr "نفد الرصيد التجريبي. اربط حسابك الخاص ليعود Teaport إلى الإجابة."
