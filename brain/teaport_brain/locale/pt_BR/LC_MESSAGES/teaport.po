# the user means: start
msgctxt "pattern"
msgid "\\b(?:set(?:s|ting)? ?up|(?:re)?configur(?:e|es|ing)|(?:re)?connect(?:s|ing)?|join(?:s|ing)?|chang(?:e|es|ing)|switch(?:es|ing)?)\\b(?: (?:the|a|my|your|our|this|that|to|onto|new|another|different|other|home|me|us|it|yourself|the box|back)){0,4} ?(?:wi[- ]?fi|wireless|network|hotspot)s?\\b|\\bwi[- ]?fi (?:set ?up|setup)\\b"
msgstr "\\b(?:(?:re)?configur(?:a|ar|e|o|emos|amos|ando)(?:-(?:lo|la|me|se))?|configura[cç](?:[aã]o|[oõ]es)|conect(?:a|ar|e|o|emos|ando)(?:-(?:se|me|nos))?|troc(?:a|ar|amos|ando)|troque(?:mos)?|mud(?:a|ar|e|amos|ando)|entr(?:a|ar|ando))\\b(?:[\\s,]+(?:o|a|os|as|um|uma|no|na|nos|nas|ao|à|em|de|do|da|meu|minha|seu|sua|outro|outra|novo|nova|rede|pra|para|esse|essa|este|esta|nesse|nessa|se|me)\\b){0,4}[\\s,]+(?:(?:wi|wai|uai)[- ]?fa?i|redes? sem fio)\\b|\\b(?:(?:wi|wai|uai)[- ]?fa?i|redes? sem fio)\\b.{0,30}?\\b(?:re)?configur(?:a|ar|e|emos|[aá]-l[oa])\\b"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "^(?!.*\\b(?:(?<!por qu[eê] )(?<!porqu[eê] )n[aã]o(?! tem problema| h[aá] problema)|nem)\\b).*?\\b(?:sim|claro|com certeza|pode(?=\\W*$)|pode (?:ser|sim|fazer|ir|come[cç]ar|configurar|mandar)|beleza|t[aá] bom|t[aá] bem|t[aá] certo|t[aá] ok|est[aá] bem|ok|okay|okey|certo|isso(?=\\W*$)|isso mesmo|isso a[ií]|vamos(?! ver)|bora|manda ver|por favor|positivo|fechado|quero(?! saber)|fa[cç]a|faz isso|afirmativo|uhum|aham|perfeito|valeu|pode crer|por qu[eê] n[aã]o|sem problema|n[aã]o tem problema)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b(?:(?<!por qu[eê] )(?<!porqu[eê] )n[aã]o(?! tem problema| h[aá] problema)|nem pensar|negativo|deixa (?:pra|para) l[aá]|esquece|esque[cç]a|cancel\\w*|(?:melhor|fica pra|fica para|deixa pra|deixa para) depois|mais tarde|outra hora)\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:cancel\\w*|pare|parar|para (?:tudo|com isso|a configura[cç][aã]o|j[aá])|esquece|esque[cç]a|deixa (?:pra|para) l[aá]|desist\\w*|interromp\\w*|n[aã]o quero mais|sai(?:r)? d(?:a|o|essa|esse|esta|este) (?:configura[cç][aã]o|modo|wi[- ]?fi))\\b|^\\W*(?:para\\W*)+$|(?<!n[aã]o )\\bchega(?: disso| j[aá]| por hoje)?\\W*$"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:repet\\w*|repit\\w*|de novo|outra vez|mais uma vez|qual (?:[ée]|era|que [ée])|o que (?:voc[eê] )?(?:disse|falou)|como (?:[ée]|era|que [ée])|senha|nome da rede|n[aã]o (?:entendi|ouvi|escutei)|mais devagar)\\b|^\\W*(?:o qu[eê]|h[aã]|oi|como|perd[aã]o)\\W*$"

# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "Idioma"
