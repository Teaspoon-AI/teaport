# the user means: start
msgctxt "pattern"
msgid "\\b(?:set(?:s|ting)?[- ]?up|(?:re)?configur(?:e|es|ing)|(?:re)?connect(?:s|ing)?|join(?:s|ing)?|chang(?:e|es|ing)|switch(?:es|ing)?)\\b(?: (?:the|a|my|your|our|this|that|to|onto|new|another|different|other|home|guest|me|us|it|yourself|the box|back)){0,4} ?(?:(?:wi[-‐‑ ]?fi|wireless)(?: (?:network|connection))?|network|hotspot)s?(?= *(?:[.,!?;:…]|$)| on \\w| (?:and|so|but|because|since|then|now|please|again|for|to|at|in|with|from|here|there|too|first|today|tonight|called|named|instead|as|if|when|or|that|which|i|we|ok|okay|thanks|thank|right|quickly)\\b)|\\bwi[-‐‑ ]?fi (?:set[- ]?up|setup)\\b"
msgstr "(?<!não )(?<!nao )(?<!não tô )(?<!não to )(?<!nao to )(?<!não estou )\\b(?:(?:re)?configur(?:a|ar|e|o|emos|amos|ando)(?:-(?:lo|la|me|se))?|configura[cç](?:[aã]o|[oõ]es)|conect(?:a|ar|e|o|emos|ando)(?:-(?:se|me|nos))?|troc(?:a|ar|amos|ando)|troque(?:mos)?|mud(?:a|ar|e|amos|ando)|entr(?:a|ar|ando))\\b(?:[\\s,]+(?:o|a|os|as|um|uma|no|na|nos|nas|ao|à|em|de|do|da|meu|minha|seu|sua|outro|outra|novo|nova|rede|pra|para|esse|essa|este|esta|nesse|nessa|se|me)\\b){0,4}[\\s,]+(?:(?:wi|wai|uai)[- ]?fa?i|redes? sem fio)\\b|\\b(?:(?:wi|wai|uai)[- ]?fa?i|redes? sem fio)\\b.{0,30}?\\b(?:re)?configur(?:a|ar|e|emos|[aá]-l[oa])\\b"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "^(?!.*\\b(?:(?<!por qu[eê] )(?<!porqu[eê] )n[aã]o(?! tem problema| h[aá] problema)|nem)\\b).*?\\b(?:sim|claro|com certeza|pode(?=\\W*$)|pode (?:ser|sim|fazer|ir|come[cç]ar|configurar|mandar)|beleza|t[aá] bom|t[aá] bem|t[aá] certo|t[aá] ok|est[aá] bem|ok|okay|okey|certo|isso(?=\\W*$)|isso mesmo|isso a[ií]|vamos(?! ver)|bora|manda ver|por favor|positivo|fechado|quero(?! saber)|fa[cç]a|faz isso|afirmativo|uhum|aham|perfeito|valeu|pode crer|por qu[eê] n[aã]o|sem problema|n[aã]o tem problema)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b(?:(?<!por qu[eê] )(?<!porqu[eê] )n[aã]o(?! tem problema| h[aá] problema)|nem pensar|negativo|deixa (?:pra|para) l[aá]|esquece|esque[cç]a|cancel\\w*|(?:melhor|fica pra|fica para|deixa pra|deixa para) depois|mais tarde|outra hora)\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:cancel\\w*|pare|parar|para (?:tudo|com isso|a configura[cç][aã]o|j[aá])|esquece|esque[cç]a|deixa (?:pra|para) l[aá]|desist\\w*|interromp\\w*|n[aã]o quero mais|sai(?:r)? d(?:a|o|essa|esse|esta|este) (?:configura[cç][aã]o|modo|wi[- ]?fi))\\b|^\\W*(?:para\\W*)+$|(?<!n[aã]o )\\bchega(?: disso| j[aá]| por hoje)?\\W*$"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:repet\\w*|repit\\w*|de novo|outra vez|mais uma vez|qual (?:[ée]|era|que [ée])|o que (?:voc[eê] )?(?:disse|falou)|como (?:[ée]|era|que [ée])|senha|nome da rede|n[aã]o (?:entendi|ouvi|escutei)|mais devagar)\\b|^\\W*(?:o qu[eê]|h[aã]|oi|como|perd[aã]o)\\W*$"

# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "Idioma"

# The session arbiter (session_arbiter.py): one conversation at a time.
msgid "Sorry, I'm on a phone call right now. Please try again when it's over."
msgstr "Desculpe, estou em uma ligação agora. Tente de novo quando ela terminar."

msgid "Sorry, I'm in another conversation right now. Please try again in a little while."
msgstr "Desculpe, estou em outra conversa agora. Tente de novo daqui a pouco."

msgid "Sorry, a phone call is coming in and I have to take it. We can talk again when it's over."
msgstr "Desculpe, está chegando uma ligação e preciso atender. Podemos conversar de novo quando ela terminar."

# A phone call during a conversation (session_arbiter.py, call_prompt.py): the agent asks,
# steps away, and comes back.
#. Translators: {caller} is a name or a phone number, as the caller ID gives it.
msgid "Someone's calling me — {caller}. Should I step away for a moment?"
msgstr "Alguém está me ligando — {caller}. Posso atender rapidinho?"

msgid "Someone's calling me. Should I step away for a moment?"
msgstr "Alguém está me ligando. Posso atender rapidinho?"

msgid "I'll take the call — back in a moment."
msgstr "Vou atender a ligação — já volto."

msgid "Sorry about that — where were we?"
msgstr "Desculpe a interrupção — onde a gente estava?"

msgid "Sorry, I couldn't get an answer just then. Could you try again?"
msgstr "Desculpe, não consegui uma resposta agora há pouco. Pode tentar de novo?"

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. It can be fixed on my settings page."
msgstr "Desculpe, não consigo responder agora: a conta que uso para as minhas respostas precisa de atenção, e tentar de novo não vai adiantar. Dá para resolver na minha página de configurações."

msgid "I still can't answer until my account is sorted out."
msgstr "Ainda não consigo responder até que a minha conta seja resolvida."

msgid "Sorry, I couldn't get an answer just then."
msgstr "Desculpe, não consegui uma resposta agora há pouco."

# The call recording notice (call_recording.py, #114).
msgid "This call is being recorded."
msgstr "Esta ligação está sendo gravada."

# No model at all (llm_error_speaker.py, #277).
msgid "I can't answer questions yet, because the account I use for my answers isn't set up."
msgstr "Ainda não consigo responder perguntas, porque a conta que uso para as minhas respostas não está configurada."

msgid "I can't answer questions until I'm set up. Say \"set up Wi-Fi\" to get me online."
msgstr "Não consigo responder perguntas até ser configurado. Diga “configurar o wi-fi” para me colocar na internet."

msgid "Sorry, I can't take calls right now. Please try again later."
msgstr "Desculpe, não posso atender ligações agora. Tente de novo mais tarde."

msgid "I'm ready now. Please ask me again."
msgstr "Agora estou pronto. Pode perguntar de novo."

msgid "I'm ready now. Please start a new conversation with me."
msgstr "Agora estou pronto. Comece uma nova conversa comigo."

# The first-boot setup (wifi_voice.py, first_boot.py, #278).
msgid "Hi, I'm Teaport. Let's get me online. Give me a moment to look for networks."
msgstr "Oi, eu sou o Teaport. Vamos me colocar na internet. Só um momento, vou procurar as redes."

msgid "You can say \"set up Wi-Fi\" any time to try again."
msgstr "Você pode dizer “configurar o wi-fi” a qualquer momento para tentar de novo."

msgid "I'm online now, so I've left setup mode."
msgstr "Já tenho internet, então saí do modo de conexão."

# The sessions' own lines: busy / engine-unavailable, consult progress and tool acks (tools.py, agent_session.py).

msgid "Sorry, the voice assistant is busy with another session right now — please try again in a moment."
msgstr "Desculpe, o assistente de voz está ocupado com outra sessão. Tente de novo daqui a pouco."

msgid "Sorry, I can't hear you right now — my speech recognition isn't available. Please try again in a moment."
msgstr "Desculpe, não consigo ouvir você agora: o reconhecimento de voz não está disponível. Tente de novo daqui a pouco."

msgid "Still working on that — {topic}."
msgstr "Ainda estou nisso — {topic}."

msgid "Still working on it."
msgstr "Ainda estou nisso."

msgid "Almost there — {topic}."
msgstr "Quase pronto — {topic}."

msgid "Almost there — hang tight."
msgstr "Quase pronto, só mais um instante."

msgid "Looking up {q}."
msgstr "Pesquisando {q}."

msgid "Opening that page."
msgstr "Abrindo a página."

msgid "I'll work on that — give me a moment."
msgstr "Vou trabalhar nisso, um momento."

msgid "One moment, let me set that up."
msgstr "Um momento, vou preparar isso."

# Settings from the phone and the AI account (settings_access.py, ai_account.py, config_ui.py, wifi_setup.py, #279).
msgid "AI account"
msgstr "Conta de IA"

msgid "AI account (optional)"
msgstr "Conta de IA (opcional)"

msgid "An account is connected."
msgstr "Há uma conta conectada."

msgid "Ask Teaport for a new one: say \"open my settings\"."
msgstr "Peça um novo ao Teaport: diga “abrir as configurações”."

msgid "Checking the key…"
msgstr "Verificando a chave…"

msgid "Code"
msgstr "Código"

msgid "Continue"
msgstr "Continuar"

msgid "Enter the code Teaport gave you. It works once."
msgstr "Digite o código que o Teaport passou para você. Ele só funciona uma vez."

msgid "I can't answer questions yet, because the account I use for my answers isn't set up. Say \"open my settings\" to set it up."
msgstr "Ainda não consigo responder perguntas, porque a conta que uso para as minhas respostas não está configurada. Diga “abrir as configurações” para configurá-la."

msgid "I couldn't use the AI account key you entered, so I didn't save it. Say \"open my settings\" to try again."
msgstr "Não consegui usar a chave da conta de IA que você digitou, então não a salvei. Diga “abrir as configurações” para tentar de novo."

msgid "I need to be online for that. Say \"set up Wi-Fi\" to get me online."
msgstr "Para isso, preciso estar na internet. Diga “configurar o wi-fi” para me colocar na internet."

msgid "I've put a code on my screen. Scan it with your phone's camera, then tap the link that appears to get to my settings."
msgstr "Coloquei um código na minha tela. Escaneie com a câmera do celular e depois toque no link que aparecer para chegar às minhas configurações."

msgid "If your phone warns that the connection is not private, install {certificate} first, then ask Teaport for a new code."
msgstr "Se o celular avisar que a conexão não é particular, instale primeiro {certificate} e depois peça um novo código ao Teaport."

msgid "If your phone warns that this page is not private, here is how to trust Teaport."
msgstr "Se o celular avisar que esta página não é particular, veja como confiar no Teaport."

msgid "In your phone's browser, go to {address}, and enter the code {code}. It works once, for the next five minutes."
msgstr "No navegador do celular, acesse {address} e digite o código {code}. Ele só funciona uma vez, nos próximos cinco minutos."

msgid "Leave this empty to keep the account Teaport has now. To use your own OpenRouter account, paste its key here. Teaport checks the key once it's online, and says out loud whether it worked."
msgstr "Deixe em branco para manter a conta que o Teaport usa agora. Para usar a sua própria conta do OpenRouter, cole a chave dela aqui. O Teaport verifica a chave assim que estiver na internet e avisa em voz alta se deu certo."

msgid "No account is connected yet."
msgstr "Nenhuma conta conectada ainda."

msgid "OpenRouter key"
msgstr "Chave do OpenRouter"

msgid "Save anyway"
msgstr "Salvar mesmo assim"

msgid "Settings"
msgstr "Configurações"

msgid "Show advanced"
msgstr "Mostrar opções avançadas"

msgid "Sorry, my settings can't be reached from a phone on this box."
msgstr "Desculpe, neste aparelho não dá para acessar as minhas configurações pelo celular."

msgid "Tap Continue to get to Teaport's settings on this phone. The code works once."
msgstr "Toque em Continuar para acessar as configurações do Teaport neste celular. O código só funciona uma vez."

msgid "Teaport couldn't check this key: {reason}."
msgstr "O Teaport não conseguiu verificar esta chave: {reason}."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, paste a key from your OpenRouter account."
msgstr "O Teaport usa uma conta do OpenRouter para as respostas. Para usar a sua, cole uma chave da sua conta do OpenRouter."

msgid "Teaport's certificate"
msgstr "o certificado do Teaport"

msgid "Test and save"
msgstr "Testar e salvar"

msgid "That code didn't work. Check it, or ask Teaport for a new one."
msgstr "Esse código não funcionou. Confira ou peça um novo ao Teaport."

msgid "The key works, and it's saved. Teaport uses it from your next conversation."
msgstr "A chave funciona e foi salva. O Teaport vai usá-la a partir da sua próxima conversa."

msgid "This code has expired"
msgstr "Este código expirou"

msgid "This code was already used"
msgstr "Este código já foi usado"

msgid "This key didn't work: {reason}."
msgstr "Esta chave não funcionou: {reason}."

msgid "Your AI account is connected."
msgstr "Sua conta de IA está conectada."

msgid "no AI service is set up on this box"
msgstr "nenhum serviço de IA está configurado neste aparelho"

msgctxt "pattern"
msgid "^\\W*(?:(?:um+|uh+|uhm|er+m?|eh|hm+|ok|okay|hey|so|now|please|teaport|well|alright|right)\\W+){0,3}(?:open|show|bring up|pull up|go to|get)(?: up)?(?: me)?(?: to)? (?:(?:my|your|the|teaport's|teaport) )?settings(?= *(?:[.,!?;:…]|$)| (?:page|please|now)\\b)"
msgstr "^\\W*(?:(?:hã|hum|ahn|eh|é|teaport|ok|okay|ei|ent[aã]o|e|por favor|beleza)\\W+){0,3}(?:abr(?:e|a|ir)(?:-?(?:me|nos))?|me abr(?:e|a)|mostr(?:a|e|ar)(?:-?(?:me|nos))?|me mostr(?:a|e)|v(?:ai|[aá]|ou)|ir|entr(?:a|e|ar)|(?:me )?lev(?:a|e)(?:-?me)?)(?: (?:pras?|pros|para|n?as|n?os|n?a|n?o|em|[aà]s|aos))? (?:(?:as|os|suas|seus|minhas|meus|tuas|teus|a|o|sua|minha|tua|nas|nos) )?(?:(?:p[aá]gina|tela|menu) (?:de|das|dos|do|da) (?:(?:minhas|suas|tuas) )?)?(?:configura[cç](?:[oõ]es|[aã]o)|ajustes|prefer[eê]ncias)(?= *(?:[.,!?;:…]|$)| (?:por favor|agora|j[aá]|a[ií]|do teaport)\\b)"

msgctxt "spell"
msgid "slash"
msgstr "barra"

msgid "that doesn't look like a key"
msgstr "isso não parece uma chave"

msgid "the AI service didn't answer"
msgstr "o serviço de IA não respondeu"

msgid "the AI service refused this key"
msgstr "o serviço de IA recusou esta chave"

msgid "the key is empty"
msgstr "a chave está vazia"

msgid "this account has no credit left"
msgstr "esta conta está sem crédito"

