msgstr "a chave deste aparelho é definida por quem o instalou, então não dá para mudá-la aqui"

# A key the agent (OpenClaw) did not take: nothing changed (ai_account.save_key, #281).
msgid "Teaport couldn't switch everything over to this key, so it kept the one it had. Try again in a minute."
msgstr "O Teaport não conseguiu passar tudo para esta chave, então manteve a que tinha. Tente de novo em um minuto."

# One OpenClaw may have taken all the same: a mismatch is recorded (ai_account.save_key, #281).
msgid "Teaport couldn't finish switching to this key. Try saving it again."
msgstr "O Teaport não conseguiu terminar de passar para esta chave. Salve-a de novo."

# The same without its pointer, where "open my settings" is not heard (wifi_voice.py).
msgid "I couldn't use the AI account key you entered, so I didn't save it."
msgstr "Não consegui usar a chave da conta de IA que você digitou, então não a salvei."

# The trial credit (credit.py, llm_error_speaker.py, #280).
msgid "Quick note: I've used half of my trial credit. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "Um aviso rápido: já usei metade do meu crédito de teste. Quando tiver um minutinho, diga “abrir as configurações” para conectar a sua própria conta."

msgid "Quick note: my trial credit is almost used up. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "Um aviso rápido: meu crédito de teste está quase acabando. Quando tiver um minutinho, diga “abrir as configurações” para conectar a sua própria conta."

msgid "My trial credit has run out, so I can't answer questions until you connect your own account. Say \"open my settings\" to do that."
msgstr "Meu crédito de teste acabou, então não consigo responder perguntas até você conectar a sua própria conta. Diga “abrir as configurações” para fazer isso."

msgid "My trial credit has run out, so I can't answer questions until your own account is connected."
msgstr "Meu crédito de teste acabou, então não consigo responder perguntas até a sua própria conta ser conectada."

msgid "Teaport is using its included trial credit."
msgstr "O Teaport está usando o crédito de teste incluído."

msgid "Half of the trial credit is used. Connect your own account to keep Teaport answering."
msgstr "Metade do crédito de teste já foi usada. Conecte a sua própria conta para o Teaport continuar respondendo."

msgid "The trial credit is almost used up: about {amount} left. Connect your own account to keep Teaport answering."
msgstr "O crédito de teste está quase acabando: restam cerca de {amount}. Conecte a sua própria conta para o Teaport continuar respondendo."

msgid "The trial credit has run out. Connect your own account so Teaport can answer again."
msgstr "O crédito de teste acabou. Conecte a sua própria conta para o Teaport voltar a responder."

msgid "Back to settings"
msgstr "Voltar às configurações"

msgid "Code from OpenRouter"
msgstr "Código do OpenRouter"

msgid "Connect your OpenRouter account"
msgstr "Conectar sua conta do OpenRouter"

msgid "Connecting…"
msgstr "Conectando…"

msgid "Finish"
msgstr "Concluir"

msgid "If the page after OpenRouter showed you a code, paste it here."
msgstr "Se a página depois do OpenRouter mostrou um código, cole-o aqui."

msgid "OpenRouter didn't accept the sign-in"
msgstr "O OpenRouter não aceitou o login"

msgid "OpenRouter didn't connect the account. You can try again from Teaport's settings, or paste a key there instead."
msgstr "O OpenRouter não conectou a conta. Você pode tentar de novo nas configurações do Teaport ou colar uma chave lá."

msgid "Signing in with OpenRouter isn't available on this box right now. Paste a key instead."
msgstr "Entrar com o OpenRouter não está disponível neste aparelho agora. Cole uma chave no lugar."

msgid "Tap Finish to connect your OpenRouter account to Teaport."
msgstr "Toque em Concluir para conectar sua conta do OpenRouter ao Teaport."

msgid "Teaport couldn't connect your OpenRouter account"
msgstr "O Teaport não conseguiu conectar sua conta do OpenRouter"

msgid "Teaport couldn't connect your OpenRouter account: {reason}. You can try again from Teaport's settings, or paste a key there instead."
msgstr "O Teaport não conseguiu conectar sua conta do OpenRouter: {reason}. Você pode tentar de novo nas configurações do Teaport ou colar uma chave lá."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, connect it here, or paste a key from it."
msgstr "O Teaport usa uma conta do OpenRouter para as respostas. Para usar a sua, conecte-a aqui ou cole uma chave dela."

msgid "Teaport uses your OpenRouter account from your next conversation."
msgstr "O Teaport vai usar sua conta do OpenRouter a partir da sua próxima conversa."

msgid "Teaport's settings have closed on this phone. Say \"open my settings\", then connect again."
msgstr "As configurações do Teaport foram fechadas neste celular. Diga “abrir as configurações” e conecte a conta de novo."

msgid "This connection has expired. Go back to Teaport's settings and connect again."
msgstr "Esta conexão expirou. Volte às configurações do Teaport e conecte a conta de novo."

msgid "To connect your OpenRouter account by signing in instead, finish setting up Wi-Fi, then say \"open my settings\"."
msgstr "Para conectar sua conta do OpenRouter fazendo login, termine de configurar o Wi-Fi e depois diga “abrir as configurações”."

msgid "You sign in to OpenRouter on this phone and approve Teaport, then come back to this page."
msgstr "Você faz login no OpenRouter neste celular e autoriza o Teaport, depois volta para esta página."

msgid "Your OpenRouter account is connected"
msgstr "Sua conta do OpenRouter está conectada"
