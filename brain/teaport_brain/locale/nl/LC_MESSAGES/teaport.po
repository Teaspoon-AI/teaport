# teaport — Dutch strings for what the brain says and shows without the LLM
# (Wi-Fi setup). Source: English msgids in wifi_voice.py, wifi_setup.py and wifi.py.
# Edit here (any PO editor), then: python -m teaport_brain.i18n  (recompiles the .mo).
#
# Contexts: "digit" — how a digit is said; "spell" — symbol names, the separator
# between spelled characters, and how an uppercase letter is said; "pattern" — a
# Python regex (searched, case-insensitive) for the user's words meaning start / yes /
# no / cancel / repeat. English phrases are always understood as well.
# Placeholders like {network} must be kept as they are.
#
# Translated by a model, reviewed by a second model (LQA, 2026-10-07). A native speaker's review is still recommended.
msgid ""
msgstr ""
"Project-Id-Version: teaport\n"
"PO-Revision-Date: 2026-10-07 00:00+0000\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: nl\n"

msgid "Do you want to set up Wi-Fi? I'll go offline for a few minutes while you do it on your phone. Say yes or no."
msgstr "Wil je de wifi instellen? Ik ben dan een paar minuten offline, terwijl jij het op je telefoon doet. Zeg ja of nee."

msgid "Wi-Fi setup is already running."
msgstr "Ik ben de wifi al aan het instellen."

msgid "Okay. Give me a moment to look for networks."
msgstr "Oké. Momentje, ik zoek naar netwerken."

msgid "Sorry, I couldn't start Wi-Fi setup on this box."
msgstr "Sorry, ik kon het instellen van de wifi op dit apparaat niet starten."

msgid "Okay, I've stopped Wi-Fi setup and put things back as they were."
msgstr "Oké, ik ben gestopt met het instellen van de wifi en heb alles teruggezet zoals het was."

msgid "Wi-Fi setup didn't start. Please try again in a moment."
msgstr "Het instellen van de wifi is niet gestart. Probeer het zo nog een keer."

msgid "I'm still waiting for you on the setup page."
msgstr "Ik wacht nog tot je klaar bent op de instelpagina."

msgid "That didn't work: {reason}."
msgstr "Dat is niet gelukt: {reason}."

msgid "Got it. I'm joining {network}. Switch your phone back to it."
msgstr "Begrepen. Ik maak nu verbinding met {network}. Zet je telefoon ook weer op dat netwerk."

msgid "I'm connected to {network}, and I'm online again."
msgstr "Ik ben verbonden met {network} en weer online."

msgid "Wi-Fi setup timed out, so I've put things back as they were."
msgstr "Het instellen van de wifi duurde te lang, dus ik heb alles teruggezet zoals het was."

msgid "Wi-Fi setup stopped: {reason}."
msgstr "Het instellen van de wifi is gestopt: {reason}."

msgid "your network"
msgstr "je netwerk"

msgid "something went wrong"
msgstr "er ging iets mis"

msgid "Okay, never mind."
msgstr "Oké, dan niet."

msgid "Say yes to start Wi-Fi setup, or no."
msgstr "Zeg ja om de wifi in te stellen, of nee."

msgid "I'm in Wi-Fi setup. Say repeat to hear the details again, or cancel to stop."
msgstr "Ik ben de wifi aan het instellen. Zeg herhaal om de gegevens nog een keer te horen, of annuleer om te stoppen."

msgid "On your phone, join the Wi-Fi network {ssid}. The password is {password}. A setup page should open by itself. If it doesn't, go to {url}."
msgstr "Verbind je telefoon met het wifinetwerk {ssid}. Het wachtwoord is {password}. Er zou vanzelf een instelpagina moeten verschijnen. Zo niet, ga dan naar {url}."

msgid "You can also read these details on my screen."
msgstr "Je kunt deze gegevens ook op mijn scherm lezen."

msgid "You can also scan the code on my screen to join, or read these details there."
msgstr "Je kunt ook de code op mijn scherm scannen om verbinding te maken, of deze gegevens daar lezen."

msgid "the saved settings for it did not work"
msgstr "de opgeslagen instellingen voor dat netwerk werkten niet"

msgid "the password did not work"
msgstr "het wachtwoord klopte niet"

msgid "the network was not found"
msgstr "het netwerk is niet gevonden"

msgid "it would not connect"
msgstr "de verbinding kwam niet tot stand"

msgid "it joined but there is no internet through it"
msgstr "de verbinding is gelukt, maar er is geen internettoegang"

msgid "this box has no Wi-Fi device"
msgstr "dit apparaat heeft geen wifi"

msgid "the setup network would not start"
msgstr "het instelnetwerk startte niet"

msgid "the setup page could not start"
msgstr "de instelpagina kon niet starten"

msgid "open"
msgstr "open"

msgid "Teaport Wi-Fi setup"
msgstr "Teaport: wifi instellen"

msgid "Connect to Wi-Fi"
msgstr "Verbinden met wifi"

msgid "Pick your network and type its password. Teaport will leave this setup network and join yours, and say out loud whether that worked."
msgstr "Kies je netwerk en typ het wachtwoord. Teaport verlaat dan dit instelnetwerk, maakt verbinding met het jouwe en zegt hardop of dat gelukt is."

msgid "No networks found — use Other."
msgstr "Geen netwerken gevonden – kies ‘Ander’."

msgid "Other (hidden) network"
msgstr "Ander (verborgen) netwerk"

msgid "Network name"
msgstr "Netwerknaam"

msgid "Password"
msgstr "Wachtwoord"

msgid "Show password"
msgstr "Wachtwoord tonen"

msgid "Connect"
msgstr "Verbinden"

msgid "Teaport is joining"
msgstr "Teaport maakt verbinding"

msgid "Joining {network}…"
msgstr "Verbinden met {network}…"

msgid "Teaport is leaving this setup network now. Switch your phone back to {network}. Teaport will say out loud whether it connected; if it could not, the setup network comes back and you can try again."
msgstr "Teaport verlaat nu dit instelnetwerk. Zet je telefoon weer op {network}. Teaport zegt hardop of de verbinding gelukt is; zo niet, dan komt het instelnetwerk terug en kun je het opnieuw proberen."

msgid "Could not join {network}: {reason}. Try again."
msgstr "Kan geen verbinding maken met {network}: {reason}. Probeer het opnieuw."

msgid "Pick a network, or type its name under Other."
msgstr "Kies een netwerk of typ de naam onder ‘Ander’."

msgid "That network name is too long."
msgstr "Die netwerknaam is te lang."

msgid "Wi-Fi passwords are 8 to 63 characters."
msgstr "Wifiwachtwoorden hebben 8 tot 63 tekens."

