# the user means: start
msgctxt "pattern"
msgid "\\b(?:set(?:s|ting)?[- ]?up|(?:re)?configur(?:e|es|ing)|(?:re)?connect(?:s|ing)?|join(?:s|ing)?|chang(?:e|es|ing)|switch(?:es|ing)?)\\b(?: (?:the|a|my|your|our|this|that|to|onto|new|another|different|other|home|guest|me|us|it|yourself|the box|back)){0,4} ?(?:(?:wi[-‐‑ ]?fi|wireless)(?: (?:network|connection))?|network|hotspot)s?(?= *(?:[.,!?;:…]|$)| on \\w| (?:and|so|but|because|since|then|now|please|again|for|to|at|in|with|from|here|there|too|first|today|tonight|called|named|instead|as|if|when|or|that|which|i|we|ok|okay|thanks|thank|right|quickly)\\b)|\\bwi[-‐‑ ]?fi (?:set[- ]?up|setup)\\b"
msgstr "\\b(?:configureer\\w*|configureren|verbind|verbinden|verbindt|wijzig(?:en)?|verander(?:en)?|wissel(?:en)?|koppel(?:en)?|maak verbinding|verbinding (?:maken|leggen)|instellen|in te stellen|inrichten|opzetten|op te zetten)\\b(?:\\W+\\w+){0,4}?\\W+(?:wi[\\s-]?fi|w[\\s-]?lan)|\\b(?:stel|stelt|zet|zetten)\\b(?:\\W+\\w+){0,3}?\\W+(?:wi[\\s-]?fi|w[\\s-]?lan)\\w*\\W+(?:\\w+\\W+){0,3}?(?:in|om)\\b|\\b(?:wi[\\s-]?fi|w[\\s-]?lan)\\w*(?:\\W+\\w+){0,3}?\\W*(?:instellen|in te stellen|configureren|inrichten|opzetten|op te zetten|set ?up|installatie|installeren|verbinden|wijzigen|veranderen|koppelen)\\b"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\b(?:ja|jawel|jazeker|jep|jup|zeker|oké|oke|okee|okay|ok|prima|graag|akkoord|natuurlijk|uiteraard|doe maar|doe het|ga je gang|ga (?:je )?door|ga maar|begin maar|start|starten|is goed|klinkt goed|goed zo|waarom (?:ook )?niet|top)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b(?:nee|neen|nope|welnee|laat maar|laat (?:het|dat) (?:maar|zitten)|vergeet (?:het|dat)|annuleer\\w*|annuleren|stop|stoppen|geen (?:zin|behoefte|tijd)|hoeft niet|ho maar|later|straks)\\b|(?<!waarom )(?<!waarom ook )(?<!werkt )(?<!lukt )(?<!doet het )\\bniet\\b(?! (?:slecht|verkeerd)\\b)"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:annuleer\\w*|annuleren|stop|stoppen|stopt|hou op|houd op|ophouden|afbreken|breek\\w*(?:\\W+\\w+){0,2}?\\W+af|laat maar|vergeet (?:het|dat)|kap ermee|kappen|klaar ermee|beëindig\\w*|beeindig\\w*|afsluiten|sluit af)\\b"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:herhaal\\w*|herhalen|herhaling|nog (?:een ?keer|eens|1 keer)|nogmaals|opnieuw|wat was|hoe was|wat zei je|wachtwoord\\w*|paswoord|netwerknaam|naam van (?:het|de) (?:netwerk|wifi)|wi[\\s-]?fi[\\s-]?naam|zeg (?:dat|het)|pardon|niet verstaan|langzamer)\\b"

# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "Taal"

# The session arbiter (session_arbiter.py): one conversation at a time.
msgid "Sorry, I'm on a phone call right now. Please try again when it's over."
msgstr "Sorry, ik zit nu in een telefoongesprek. Probeer het opnieuw als het voorbij is."

msgid "Sorry, I'm in another conversation right now. Please try again in a little while."
msgstr "Sorry, ik zit nu in een ander gesprek. Probeer het zo meteen opnieuw."

msgid "Sorry, a phone call is coming in and I have to take it. We can talk again when it's over."
msgstr "Sorry, er komt een telefoontje binnen en dat moet ik aannemen. We kunnen verder praten als het voorbij is."

# A phone call during a conversation (session_arbiter.py, call_prompt.py): the agent asks,
# steps away, and comes back.
#. Translators: {caller} is a name or a phone number, as the caller ID gives it.
msgid "Someone's calling me — {caller}. Should I step away for a moment?"
msgstr "Er belt iemand — {caller}. Zal ik even opnemen?"

msgid "Someone's calling me. Should I step away for a moment?"
msgstr "Er belt iemand. Zal ik even opnemen?"

msgid "I'll take the call — back in a moment."
msgstr "Ik neem het gesprek even aan — zo terug."

msgid "Sorry about that — where were we?"
msgstr "Sorry voor de onderbreking — waar waren we gebleven?"

msgid "Sorry, I couldn't get an answer just then. Could you try again?"
msgstr "Sorry, ik kreeg net geen antwoord. Wil je het nog eens proberen?"

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. It can be fixed on my settings page."
msgstr "Sorry, ik kan nu niet antwoorden: het account dat ik voor mijn antwoorden gebruik heeft aandacht nodig, en opnieuw proberen helpt niet. Het is op te lossen op mijn instellingenpagina."

msgid "I still can't answer until my account is sorted out."
msgstr "Ik kan nog steeds niet antwoorden tot mijn account in orde is."

msgid "Sorry, I couldn't get an answer just then."
msgstr "Sorry, ik kreeg net geen antwoord."

# The call recording notice (call_recording.py, #114).
msgid "This call is being recorded."
msgstr "Dit gesprek wordt opgenomen."

# No model at all (llm_error_speaker.py, #277).
msgid "I can't answer questions yet, because the account I use for my answers isn't set up."
msgstr "Ik kan nog geen vragen beantwoorden, want het account dat ik voor mijn antwoorden gebruik is nog niet ingesteld."

msgid "I can't answer questions until I'm set up. Say \"set up Wi-Fi\" to get me online."
msgstr "Ik kan geen vragen beantwoorden tot ik ben ingesteld. Zeg ‘stel de wifi in’ om me online te krijgen."

msgid "Sorry, I can't take calls right now. Please try again later."
msgstr "Sorry, ik kan nu geen gesprekken aannemen. Probeer het later opnieuw."

msgid "I'm ready now. Please ask me again."
msgstr "Ik ben nu klaar. Stel je vraag nog een keer."

msgid "I'm ready now. Please start a new conversation with me."
msgstr "Ik ben nu klaar. Begin een nieuw gesprek met me."

# The first-boot setup (wifi_voice.py, first_boot.py, #278).
msgid "Hi, I'm Teaport. Let's get me online. Give me a moment to look for networks."
msgstr "Hallo, ik ben Teaport. Laten we me online krijgen. Momentje, ik zoek naar netwerken."

msgid "You can say \"set up Wi-Fi\" any time to try again."
msgstr "Je kunt altijd ‘stel de wifi in’ zeggen om het opnieuw te proberen."

msgid "I'm online now, so I've left setup mode."
msgstr "Ik ben nu online, dus ik heb de verbindingsmodus verlaten."

# The sessions' own lines: busy / engine-unavailable, consult progress and tool acks (tools.py, agent_session.py).

msgid "Sorry, the voice assistant is busy with another session right now — please try again in a moment."
msgstr "Sorry, de spraakassistent is nu bezig met een andere sessie. Probeer het zo nog een keer."

msgid "Sorry, I can't hear you right now — my speech recognition isn't available. Please try again in a moment."
msgstr "Sorry, ik versta je nu even niet, de spraakherkenning werkt niet. Probeer het zo nog een keer."

#. Translators: {phrase} is the model's own few words, in this language, on what is
#. being done for the user (in English: "looking up pastry shops on Burnet Road").
#. Only an English session says the {phrase} lines today (tools._status_phrase);
#. another says the plain ones (#120).
msgid "Sure — {phrase}."
msgstr "Zeker — {phrase}."

msgid "On it."
msgstr "Ik ga ermee aan de slag."

msgid "Still {phrase}."
msgstr "Ik ben er nog mee bezig — {phrase}."

msgid "Still on it."
msgstr "Ik ben er nog mee bezig."

msgid "This one's taking a bit longer."
msgstr "Dit duurt wat langer."

msgid "Looking up {q}."
msgstr "Ik zoek {q} op."

msgid "Opening that page."
msgstr "Ik open die pagina."

msgid "One moment, let me set that up."
msgstr "Een momentje, ik zet het klaar."

# Settings from the phone and the AI account (settings_access.py, ai_account.py, config_ui.py, wifi_setup.py, #279).
msgid "AI account"
msgstr "AI-account"

msgid "AI account (optional)"
msgstr "AI-account (optioneel)"

msgid "An account is connected."
msgstr "Er is een account gekoppeld."

msgid "Ask Teaport for a new one: say \"open my settings\"."
msgstr "Vraag Teaport om een nieuwe: zeg ‘open de instellingen’."

msgid "Checking the key…"
msgstr "Sleutel controleren…"

msgid "Code"
msgstr "Code"

msgid "Continue"
msgstr "Doorgaan"

msgid "Enter the code Teaport gave you. It works once."
msgstr "Voer de code in die je van Teaport hebt gekregen. Hij werkt één keer."

msgid "I can't answer questions yet, because the account I use for my answers isn't set up. Say \"open my settings\" to set it up."
msgstr "Ik kan nog geen vragen beantwoorden, want het account dat ik voor mijn antwoorden gebruik is nog niet ingesteld. Zeg ‘open de instellingen’ om het in te stellen."

msgid "I couldn't use the AI account key you entered, so I didn't save it. Say \"open my settings\" to try again."
msgstr "Ik kon de sleutel voor het AI-account die je hebt ingevoerd niet gebruiken, dus ik heb hem niet opgeslagen. Zeg ‘open de instellingen’ om het opnieuw te proberen."

msgid "I need to be online for that. Say \"set up Wi-Fi\" to get me online."
msgstr "Daarvoor moet ik online zijn. Zeg ‘stel de wifi in’ om me online te krijgen."

msgid "I've put a code on my screen. Scan it with your phone's camera, then tap the link that appears to get to my settings."
msgstr "Ik heb een code op mijn scherm gezet. Scan hem met de camera van je telefoon en tik dan op de link die verschijnt om bij mijn instellingen te komen."

msgid "If your phone warns that the connection is not private, install {certificate} first, then ask Teaport for a new code."
msgstr "Als je telefoon waarschuwt dat de verbinding niet privé is, installeer dan eerst {certificate} en vraag Teaport daarna om een nieuwe code."

msgid "If your phone warns that this page is not private, here is how to trust Teaport."
msgstr "Als je telefoon waarschuwt dat deze pagina niet privé is, lees je hier hoe je Teaport kunt vertrouwen."

msgid "In your phone's browser, go to {address}, and enter the code {code}. It works once, for the next five minutes."
msgstr "Ga in de browser van je telefoon naar {address} en voer de code {code} in. Hij werkt één keer, de komende vijf minuten."

msgid "Leave this empty to keep the account Teaport has now. To use your own OpenRouter account, paste its key here. Teaport checks the key once it's online, and says out loud whether it worked."
msgstr "Laat dit leeg om het account te houden dat Teaport nu gebruikt. Wil je je eigen OpenRouter-account gebruiken, plak dan hier de sleutel ervan. Teaport controleert de sleutel zodra het online is en zegt hardop of hij werkt."

msgid "No account is connected yet."
msgstr "Er is nog geen account gekoppeld."

msgid "OpenRouter key"
msgstr "OpenRouter-sleutel"

msgid "Save anyway"
msgstr "Toch opslaan"

msgid "Settings"
msgstr "Instellingen"

msgid "Show advanced"
msgstr "Geavanceerd tonen"

msgid "Sorry, my settings can't be reached from a phone on this box."
msgstr "Sorry, op dit apparaat zijn mijn instellingen niet bereikbaar vanaf een telefoon."

msgid "Tap Continue to get to Teaport's settings on this phone. The code works once."
msgstr "Tik op ‘Doorgaan’ om op deze telefoon naar de instellingen van Teaport te gaan. De code werkt één keer."

msgid "Teaport couldn't check this key: {reason}."
msgstr "Teaport kon deze sleutel niet controleren: {reason}."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, paste a key from your OpenRouter account."
msgstr "Teaport gebruikt een OpenRouter-account voor zijn antwoorden. Wil je je eigen account gebruiken, plak dan een sleutel uit je OpenRouter-account."

msgid "Teaport's certificate"
msgstr "het certificaat van Teaport"

msgid "Test and save"
msgstr "Testen en opslaan"

msgid "That code didn't work. Check it, or ask Teaport for a new one."
msgstr "Die code werkte niet. Controleer hem of vraag Teaport om een nieuwe."

msgid "The key works, and it's saved. Teaport uses it from your next conversation."
msgstr "De sleutel werkt en is opgeslagen. Teaport gebruikt hem vanaf je volgende gesprek."

msgid "This code has expired"
msgstr "Deze code is verlopen"

msgid "This code was already used"
msgstr "Deze code is al gebruikt"

msgid "This key didn't work: {reason}."
msgstr "Deze sleutel werkte niet: {reason}."

msgid "Your AI account is connected."
msgstr "Je AI-account is gekoppeld."

msgid "no AI service is set up on this box"
msgstr "er is geen AI-dienst ingesteld op dit apparaat"

msgctxt "pattern"
msgid "^\\W*(?:(?:um+|uh+|uhm|er+m?|eh|hm+|ok|okay|hey|so|now|please|teaport|well|alright|right)\\W+){0,3}(?:(?:can|could|would|will) you(?: please)? )?(?:open|show|bring up|pull up|go to|get)(?: up)?(?: me)?(?: to)? (?:(?:my|your|the|teaport's|teaport) )?settings(?:[\\s,]+(?:page|please|now|for me|thanks a lot|thank you (?:so |very )?much|thanks|thank you|cheers|ok(?:ay)?|teaport)\\b)*[\\s.,!?;:…]*$"
msgstr "^\\W*(?:(?:eh|ehm|uh|uhm|hm+|teaport|ok|oké|okee|hé|hey|en|dus|alsjeblieft|graag|nou)\\W+){0,3}(?:(?:(?:kun|kan|zou|wil)\\s+je|(?:kunt|zou|wilt)\\s+u)(?:\\s+(?:me|mij|even|eens|alsjeblieft|graag|nu))*\\s+)?(?:(?:open|opent|toon|ga|haal)(?:\\s+(?:me|mij|ons|eens|even|nu|maar|naar|alsjeblieft|graag))*\\s+(?:(?:de|je|jouw|mijn|teaports?)\\s+)?instelling(?:en|enpagina|enscherm)(?:\\s+(?:open|op|erbij))?(?:[\\s,،]+(?:teaport|dank je wel|dank u wel|dank je|dank u|bedankt|alsjeblieft|alsjeblief|alstublieft|graag|nu|even|pagina)\\b)*[\\s.,!?;:…]*$|laat(?:\\s+(?:me|mij|ons|eens|even|nu|maar))*\\s+(?:(?:de|je|jouw|mijn|teaports?)\\s+)?instelling(?:en|enpagina|enscherm)\\s+zien(?:[\\s,،]+(?:teaport|dank je wel|dank u wel|dank je|dank u|bedankt|alsjeblieft|alsjeblief|alstublieft|graag|nu|even)\\b)*[\\s.,!?;:…]*$|(?:(?:de|je|jouw|mijn)\\s+)?instelling(?:en|enpagina|enscherm)\\s+(?:(?:even|graag|nu|maar)\\s+)?(?:openen|tonen|laten zien|openmaken|open)(?:[\\s,،]+(?:teaport|dank je wel|dank u wel|dank je|dank u|bedankt|alsjeblieft|alsjeblief|alstublieft|graag|nu|even)\\b)*[\\s.,!?;:…]*$)"

msgctxt "spell"
msgid "slash"
msgstr "schuine streep"

msgid "that doesn't look like a key"
msgstr "dat lijkt geen sleutel"

msgid "the AI service didn't answer"
msgstr "de AI-dienst gaf geen antwoord"

msgid "the AI service refused this key"
msgstr "de AI-dienst weigerde deze sleutel"

msgid "the key is empty"
msgstr "de sleutel is leeg"

msgid "this account has no credit left"
msgstr "dit account heeft geen tegoed meer"

msgid "this box's key is set by its installer, so it can't be changed here"
msgstr "de sleutel van dit apparaat is door de installateur ingesteld, dus hij kan hier niet worden gewijzigd"

# A key the agent (OpenClaw) did not take: nothing changed (ai_account.save_key, #281).
msgid "Teaport couldn't switch everything over to this key, so it kept the one it had. Try again in a minute."
msgstr "Teaport kon niet alles overzetten op deze sleutel en heeft daarom de oude gehouden. Probeer het over een minuut opnieuw."

# One OpenClaw may have taken all the same: a mismatch is recorded (ai_account.save_key, #281).
msgid "Teaport couldn't finish switching to this key. Try saving it again."
msgstr "Teaport kon de overstap naar deze sleutel niet afmaken. Sla hem opnieuw op."

# The same without its pointer, where "open my settings" is not heard (wifi_voice.py).
msgid "I couldn't use the AI account key you entered, so I didn't save it."
msgstr "Ik kon de sleutel voor het AI-account die je hebt ingevoerd niet gebruiken, dus ik heb hem niet opgeslagen."

# The trial credit (credit.py, llm_error_speaker.py, #280).
msgid "Quick note: I've used half of my trial credit. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "Even tussendoor: ik heb de helft van mijn proeftegoed gebruikt. Als je even tijd hebt, zeg dan ‘open de instellingen’ om je eigen account te koppelen."

msgid "Quick note: my trial credit is almost used up. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "Even tussendoor: mijn proeftegoed is bijna op. Als je even tijd hebt, zeg dan ‘open de instellingen’ om je eigen account te koppelen."

msgid "My trial credit has run out, so I can't answer questions until you connect your own account. Say \"open my settings\" to do that."
msgstr "Mijn proeftegoed is op, dus ik kan geen vragen beantwoorden tot je je eigen account koppelt. Zeg ‘open de instellingen’ om dat te doen."

msgid "My trial credit has run out, so I can't answer questions until your own account is connected."
msgstr "Mijn proeftegoed is op, dus ik kan geen vragen beantwoorden tot je eigen account gekoppeld is."

msgid "Teaport is using its included trial credit."
msgstr "Teaport gebruikt het meegeleverde proeftegoed."

msgid "Half of the trial credit is used. Connect your own account to keep Teaport answering."
msgstr "De helft van het proeftegoed is gebruikt. Koppel je eigen account zodat Teaport blijft antwoorden."

msgid "The trial credit is almost used up: about {amount} left. Connect your own account to keep Teaport answering."
msgstr "Het proeftegoed is bijna op: nog ongeveer {amount} over. Koppel je eigen account zodat Teaport blijft antwoorden."

msgid "The trial credit has run out. Connect your own account so Teaport can answer again."
msgstr "Het proeftegoed is op. Koppel je eigen account zodat Teaport weer kan antwoorden."

msgid "Back to settings"
msgstr "Terug naar de instellingen"

msgid "Code from OpenRouter"
msgstr "Code van OpenRouter"

msgid "Connect your OpenRouter account"
msgstr "Je OpenRouter-account koppelen"

msgid "Connecting…"
msgstr "Bezig met koppelen…"

msgid "Finish"
msgstr "Klaar"


msgid "OpenRouter didn't accept the sign-in"
msgstr "OpenRouter heeft de aanmelding niet geaccepteerd"

msgid "OpenRouter didn't connect the account. You can try again from Teaport's settings, or paste a key there instead."
msgstr "OpenRouter heeft het account niet gekoppeld. Je kunt het opnieuw proberen in de instellingen van Teaport, of daar een sleutel plakken."


msgid "Tap Finish to connect your OpenRouter account to Teaport."
msgstr "Tik op Klaar om je OpenRouter-account aan Teaport te koppelen."

msgid "Teaport couldn't connect your OpenRouter account"
msgstr "Teaport kon je OpenRouter-account niet koppelen"

msgid "Teaport couldn't connect your OpenRouter account: {reason}. You can try again from Teaport's settings, or paste a key there instead."
msgstr "Teaport kon je OpenRouter-account niet koppelen: {reason}. Je kunt het opnieuw proberen in de instellingen van Teaport, of daar een sleutel plakken."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, connect it here, or paste a key from it."
msgstr "Teaport gebruikt een OpenRouter-account voor zijn antwoorden. Wil je je eigen account gebruiken, koppel het dan hier of plak er een sleutel uit."

msgid "Teaport uses your OpenRouter account from your next conversation."
msgstr "Teaport gebruikt je OpenRouter-account vanaf je volgende gesprek."

msgid "Teaport's settings have closed on this phone. Say \"open my settings\", then connect again."
msgstr "De instellingen van Teaport zijn op deze telefoon gesloten. Zeg ‘open de instellingen’ en koppel daarna opnieuw."

msgid "This connection has expired. Go back to Teaport's settings and connect again."
msgstr "Deze koppeling is verlopen. Ga terug naar de instellingen van Teaport en koppel opnieuw."



msgid "Your OpenRouter account is connected"
msgstr "Je OpenRouter-account is gekoppeld"

msgid "Connecting your OpenRouter account to Teaport"
msgstr "Je OpenRouter-account wordt aan Teaport gekoppeld"

msgid "Continue to Teaport"
msgstr "Verder naar Teaport"

msgid "Copied"
msgstr "Gekopieerd"

msgid "Copy code"
msgstr "Code kopiëren"

msgid "If OpenRouter showed you a code, paste it here."
msgstr "Liet OpenRouter je een code zien? Plak die dan hier."

msgid "If that doesn't work: copy this code, open Teaport's settings on this phone, and paste it into {field}. It works once, in the next ten minutes."
msgstr "Werkt dat niet? Kopieer dan deze code, open de instellingen van Teaport op deze telefoon en plak hem in {field}. Hij werkt één keer, in de komende tien minuten."

msgid "If your phone warns that the connection isn't private, it's the same warning you saw when you opened Teaport's settings."
msgstr "Waarschuwt je telefoon dat de verbinding niet privé is? Dat is dezelfde waarschuwing als toen je de instellingen van Teaport opende."

msgid "Now let's connect your OpenRouter account. I've put a code on my screen. Scan it with your phone's camera, tap the link that appears, and follow the steps on your phone."
msgstr "Laten we nu je OpenRouter-account koppelen. Ik heb een code op mijn scherm gezet. Scan hem met de camera van je telefoon, tik op de link die verschijnt en volg de stappen op je telefoon."

msgid "Now let's connect your OpenRouter account. In your phone's browser, go to {address}, enter the code {code}, and follow the steps there. The code works once, for the next five minutes."
msgstr "Laten we nu je OpenRouter-account koppelen. Ga in de browser van je telefoon naar {address}, vul de code {code} in en volg de stappen daar. De code werkt één keer, de komende vijf minuten."

msgid "Save it again"
msgstr "Opnieuw opslaan"

msgid "Teaport couldn't save the key"
msgstr "Teaport kon de sleutel niet opslaan"

msgid "Teaport no longer has that key. Tap Connect your OpenRouter account to sign in again."
msgstr "Teaport heeft die sleutel niet meer. Tik op Je OpenRouter-account koppelen om je opnieuw aan te melden."

msgid "Teaport still has the key from your OpenRouter sign-in. Tap Save it again to try once more."
msgstr "Teaport heeft de sleutel van je OpenRouter-aanmelding nog. Tik op Opnieuw opslaan om het nog eens te proberen."

msgid "That doesn't look like a code from OpenRouter. Check it and paste it again."
msgstr "Dat lijkt geen code van OpenRouter. Controleer hem en plak hem opnieuw."

msgid "There's no sign-in waiting for a code. Tap Connect your OpenRouter account to start a new one."
msgstr "Er wacht geen aanmelding op een code. Tik op Je OpenRouter-account koppelen om een nieuwe te starten."

msgid "This link doesn't lead to a Teaport on a home network, so this page won't go on with it."
msgstr "Deze link leidt niet naar een Teaport in een thuisnetwerk, dus deze pagina gaat er niet mee verder."

msgid "To connect your OpenRouter account by signing in instead, leave this empty and finish setting up Wi-Fi. Then Teaport shows you how, or you can say \"open my settings\"."
msgstr "Wil je je OpenRouter-account liever koppelen door je aan te melden? Laat dit dan leeg en rond de wifi-instelling af. Daarna laat Teaport je zien hoe, of zeg ‘open de instellingen’."

msgid "You sign in to OpenRouter on this phone and approve Teaport. OpenRouter then shows a code: copy it, come back to Teaport's settings, and paste it into Code from OpenRouter."
msgstr "Je meldt je op deze telefoon aan bij OpenRouter en geeft Teaport toestemming. OpenRouter laat dan een code zien: kopieer die, ga terug naar de instellingen van Teaport en plak hem in Code van OpenRouter."

msgid "You sign in to OpenRouter on this phone and approve Teaport. Then a Teaport page asks you to tap Finish."
msgstr "Je meldt je op deze telefoon aan bij OpenRouter en geeft Teaport toestemming. Daarna vraagt een pagina van Teaport je op Klaar te tikken."

msgid "Your phone needs to be on the same Wi-Fi as Teaport. If it doesn't go on by itself, tap the button."
msgstr "Je telefoon moet op dezelfde wifi zitten als Teaport. Gaat het niet vanzelf verder, tik dan op de knop."

msgid "Your OpenRouter account has no credit yet, so Teaport can't answer until you add some at openrouter.ai/settings/credits."
msgstr "Je OpenRouter-account heeft nog geen tegoed, dus Teaport kan pas antwoorden als je tegoed toevoegt op openrouter.ai/settings/credits."

msgid "Your AI account is connected, but it has no credit yet. Add some on OpenRouter's website, and then I can answer."
msgstr "Je AI-account is gekoppeld, maar heeft nog geen tegoed. Voeg tegoed toe op de website van OpenRouter, dan kan ik antwoorden."

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. Say \"open my settings\" to fix it."
msgstr "Sorry, ik kan nu niet antwoorden: het account dat ik voor mijn antwoorden gebruik heeft aandacht nodig, en opnieuw proberen helpt niet. Zeg ‘open de instellingen’ om het op te lossen."

# The recovery line (llm_text_guard.recovery_text): a collapsed or empty reply (#15).
msgid "Sorry, I lost my train of thought there. Could you say that again?"
msgstr "Sorry, ik ben de draad kwijt. Kun je dat nog een keer zeggen?"
