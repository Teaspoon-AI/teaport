# teaport — Dutch strings for what the brain says and shows without the LLM
# (Wi-Fi setup). Source: English msgids in wifi_voice.py, wifi_setup.py and wifi.py.
# Edit here (any PO editor), then: python -m teaport_brain.i18n  (recompiles the .mo).
#
# Contexts: "digit" — how a digit is said; "spell" — symbol names, the separator
# between spelled characters, and how an uppercase letter is said; "pattern" — a
# Python regex (searched, case-insensitive) for the user's words meaning start / yes /
# no / cancel / repeat. English phrases are always understood as well.
# Placeholders like {network} must be kept as they are.
#
# Translated by a model, reviewed by a second model (LQA, 2026-10-07). A native speaker's review is still recommended.
msgid ""
msgstr ""
"Project-Id-Version: teaport\n"
"PO-Revision-Date: 2026-10-07 00:00+0000\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: nl\n"

msgid "Do you want to set up Wi-Fi? I'll go into setup mode and be offline for a few minutes while you do it on your phone. Say yes or no."
msgstr "Wil je de wifi instellen? Ik ga dan in de verbindingsmodus en ben een paar minuten offline, terwijl jij het op je telefoon doet. Zeg ja of nee."

msgid "I'm already in setup mode."
msgstr "Ik sta al in de verbindingsmodus."

msgid "Okay. Give me a moment to look for networks."
msgstr "Oké. Momentje, ik zoek naar netwerken."

msgid "I'm in setup mode."
msgstr "Ik sta nu in de verbindingsmodus."

msgid "Sorry, I couldn't go into setup mode."
msgstr "Sorry, ik kon niet naar de verbindingsmodus gaan."

msgid "Okay, I've left setup mode and put things back as they were."
msgstr "Oké, ik heb de verbindingsmodus verlaten en alles teruggezet zoals het was."

msgid "Okay, I've cancelled that. Everything is as it was."
msgstr "Oké, ik heb het geannuleerd. Alles is zoals het was."

msgid "Setup mode was turned off. Everything is as it was."
msgstr "De verbindingsmodus is uitgezet. Alles is zoals het was."

msgid "One moment, I'm getting setup mode ready. Say cancel to stop."
msgstr "Even geduld, ik maak de verbindingsmodus klaar. Zeg annuleer om te stoppen."

msgid "I couldn't stop yet. Say cancel again in a moment."
msgstr "Ik kon nog niet stoppen. Zeg zo nog een keer annuleer."

msgid "I couldn't go into setup mode. Please try again in a moment."
msgstr "Ik kon niet naar de verbindingsmodus gaan. Probeer het zo nog een keer."

msgid "I'm still in setup mode, waiting for you."
msgstr "Ik sta nog in de verbindingsmodus en wacht op je."

msgid "That didn't work: {reason}."
msgstr "Dat is niet gelukt: {reason}."

msgid "Got it. I'm joining {network}. Switch your phone back to it."
msgstr "Begrepen. Ik maak nu verbinding met {network}. Zet je telefoon ook weer op dat netwerk."

msgid "I'm connected to {network}, and I'm online again."
msgstr "Ik ben verbonden met {network} en weer online."

msgid "Nothing connected in time, so I've left setup mode and put things back as they were."
msgstr "Er kwam op tijd geen verbinding, dus ik heb de verbindingsmodus verlaten en alles teruggezet zoals het was."

msgid "I've left setup mode: {reason}."
msgstr "Ik heb de verbindingsmodus verlaten: {reason}."

msgid "Sorry, I couldn't go into setup mode: {reason}."
msgstr "Sorry, ik kon niet naar de verbindingsmodus gaan: {reason}."

msgid "your network"
msgstr "je netwerk"

msgid "something went wrong"
msgstr "er ging iets mis"

msgid "Okay, never mind."
msgstr "Oké, dan niet."

msgid "Say yes to go into setup mode, or no."
msgstr "Zeg ja om naar de verbindingsmodus te gaan, of nee."

msgid "I'm in setup mode. Say repeat to hear the details, or cancel to leave setup mode."
msgstr "Ik sta in de verbindingsmodus. Zeg herhaal om de gegevens te horen, of annuleer om de verbindingsmodus te verlaten."

msgid "On your phone, join the Wi-Fi network {ssid}. The password is {password}. Then open your browser, go to {url}, and pick your Wi-Fi."
msgstr "Verbind je telefoon met het wifinetwerk {ssid}. Het wachtwoord is {password}. Open daarna je browser, ga naar {url} en kies je wifi."

msgid "On your phone, join the Wi-Fi network shown on my screen, using the password shown there. Then, in your phone's browser, go to the address on my screen and pick your Wi-Fi. Say repeat if you'd like me to read the details."
msgstr "Verbind je telefoon met het wifinetwerk op mijn scherm, met het wachtwoord dat daar staat. Ga daarna in de browser van je telefoon naar het adres op mijn scherm en kies je wifi. Zeg herhaal als ik de gegevens moet voorlezen."

msgid "Scan the code on my screen with your phone's camera to join my setup network. Then, in your phone's browser, go to the address on my screen and pick your Wi-Fi. Say repeat if you'd like me to read the details."
msgstr "Scan de code op mijn scherm met de camera van je telefoon om met mijn verbindingsnetwerk te verbinden. Ga daarna in de browser van je telefoon naar het adres op mijn scherm en kies je wifi. Zeg herhaal als ik de gegevens moet voorlezen."

msgid "the saved settings for it did not work"
msgstr "de opgeslagen instellingen voor dat netwerk werkten niet"

msgid "the password did not work"
msgstr "het wachtwoord klopte niet"

msgid "the network was not found"
msgstr "het netwerk is niet gevonden"

msgid "it would not connect"
msgstr "de verbinding kwam niet tot stand"

msgid "it joined but there is no internet through it"
msgstr "de verbinding is gelukt, maar er is geen internettoegang"

msgid "this box has no Wi-Fi device"
msgstr "dit apparaat heeft geen wifi"

msgid "the setup network would not start"
msgstr "het verbindingsnetwerk startte niet"

msgid "open"
msgstr "open"

msgid "Connect Teaport to Wi-Fi"
msgstr "Teaport met wifi verbinden"

msgid "Connect to Wi-Fi"
msgstr "Verbinden met wifi"

msgid "Pick your network and type its password. Teaport will leave this setup network and join yours, and say out loud whether that worked."
msgstr "Kies je netwerk en typ het wachtwoord. Teaport verlaat dan dit verbindingsnetwerk, maakt verbinding met het jouwe en zegt hardop of dat gelukt is."

msgid "No networks found — use Other."
msgstr "Geen netwerken gevonden – kies ‘Ander’."

msgid "Other (hidden) network"
msgstr "Ander (verborgen) netwerk"

msgid "Network name"
msgstr "Netwerknaam"

msgid "Password"
msgstr "Wachtwoord"

msgid "Show password"
msgstr "Wachtwoord tonen"

msgid "Connect"
msgstr "Verbinden"

msgid "Teaport is joining"
msgstr "Teaport maakt verbinding"

msgid "Joining {network}…"
msgstr "Verbinden met {network}…"

msgid "Teaport is leaving this setup network now. Switch your phone back to {network}. Teaport will say out loud whether it connected; if it could not, the setup network comes back and you can try again."
msgstr "Teaport verlaat nu dit verbindingsnetwerk. Zet je telefoon weer op {network}. Teaport zegt hardop of de verbinding gelukt is; zo niet, dan komt het verbindingsnetwerk terug en kun je het opnieuw proberen."

msgid "Could not join {network}: {reason}. Try again."
msgstr "Kan geen verbinding maken met {network}: {reason}. Probeer het opnieuw."

msgid "Pick a network, or type its name under Other."
msgstr "Kies een netwerk of typ de naam onder ‘Ander’."

msgid "That network name is too long."
msgstr "Die netwerknaam is te lang."

msgid "Wi-Fi passwords are 8 to 63 characters."
msgstr "Wifiwachtwoorden hebben 8 tot 63 tekens."

# The box's screen in Wi-Fi setup (wifi_setup.py, #207): its titles, and the words beside
# a network's name and the setup password. Shown only by a screen that draws every script
# (the avatar says "unicode"); any other shows them in English. Each has a length budget
# in columns of a 21-column line: a CJK character, a Hangul syllable or an emoji takes
# two; a mark drawn on or under its letter (an accent, a virama, a vowel sign above or
# below) none; anything else one, a vowel sign beside its letter (ा ि ी ो) too
# (display.columns). tests/test_i18n.py holds every translation to its budget.
#. Translators: the title while setup mode is on; at most 18 columns.
msgctxt "screen"
msgid "Setup mode"
msgstr "Verbindingsmodus"

#. Translators: the title once the box has left setup mode for the user's Wi-Fi; at most 18 columns.
msgctxt "screen"
msgid "Wi-Fi"
msgstr "Wifi"

#. Translators: before the setup network's name ("Network  teaport-ab12"); at most 7 columns.
msgctxt "screen"
msgid "Network"
msgstr "Netwerk"

#. Translators: before the setup password, when both fit on one line; at most 11 columns.
msgctxt "screen"
msgid "Password"
msgstr "Wachtwoord"

#. Translators: the short Password, before the default 14-character password; at most 5 columns.
msgctxt "screen"
msgid "Pass"
msgstr "Code"

#. Translators: after Network, in place of a name the screen cannot draw; at most 15 columns.
msgctxt "screen"
msgid "(scan the code)"
msgstr "(scan de code)"

#. Translators: above the name of the network being joined; at most 18 columns.
msgctxt "screen"
msgid "Joining"
msgstr "Verbinden met"

#. Translators: above the name of the network joined; at most 18 columns.
msgctxt "screen"
msgid "Connected to"
msgstr "Verbonden met"

#. Translators: above the name of the network that could not be joined; at most 18 columns.
msgctxt "screen"
msgid "Could not join"
msgstr "Verbinden mislukt"

