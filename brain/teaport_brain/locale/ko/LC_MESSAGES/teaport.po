# the user means: start
msgctxt "pattern"
msgid "\\b(?:set ?up|setup|configure|connect to|join|change|switch)\\b(?: (?:the|a|my|your|to|new|another|different)){0,3} ?wi-?fi\\b|\\bwi-?fi (?:set ?up|setup)\\b"
msgstr "(?:wi[-‐ ]?fi|와이 ?파이|무선 ?랜|무선 ?lan).{0,10}?(?:설정|세팅|셋팅|셋업|연결|접속|바꾸|바꿔|바꿀|변경|잡아)"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "(?<![가-힣])(?:네|예|응|넵|넹)+(?![가-힣])|그래(?!서|도)|그러(?:세요|자|죠|시죠)|좋아|좋습니다|좋죠|오케이|알겠|알았어|부탁|(?<!안 )(?<![가-힣])해 ?(?:줘|주세요)|설정해|진행해|시작해|시작하세요|시작하자|시작합시다|물론|당연하"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "아니|아뇨|싫어|싫습니다|싫은데|(?<![가-힣])됐(?:어|습니다)|(?<![가-힣])안 ?(?:해|할)|하지 ?마|하지 ?말|필요 ?없|그만|취소|나중에"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "취소|그만|중지|중단|멈춰|멈추세요|스톱|스탑|종료|끝내|하지 ?마|(?<![가-힣])안 ?할래|(?<![가-힣])됐어|나갈래"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "다시|한 ?번 ?더|한 ?번만 ?더|반복|되풀이|뭐라고|뭐였|비밀 ?번호|비번|패스워드|네트워크 ?이름|와이파이 ?이름|못 ?들었"
