# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "언어"

# The session arbiter (session_arbiter.py): one conversation at a time.
msgid "Sorry, I'm on a phone call right now. Please try again when it's over."
msgstr "죄송해요, 지금 통화 중이에요. 통화가 끝나면 다시 시도해 주세요."

msgid "Sorry, I'm in another conversation right now. Please try again in a little while."
msgstr "죄송해요, 지금 다른 대화 중이에요. 잠시 후에 다시 시도해 주세요."

msgid "Sorry, a phone call is coming in and I have to take it. We can talk again when it's over."
msgstr "죄송해요, 전화가 와서 받아야 해요. 통화가 끝나면 다시 이야기해요."

# A phone call during a conversation (session_arbiter.py, call_prompt.py): the agent asks,
# steps away, and comes back.
#. Translators: {caller} is a name or a phone number, as the caller ID gives it.
msgid "Someone's calling me — {caller}. Should I step away for a moment?"
msgstr "전화가 왔어요 — {caller}. 잠깐 받고 와도 될까요?"

msgid "Someone's calling me. Should I step away for a moment?"
msgstr "전화가 왔어요. 잠깐 받고 와도 될까요?"

msgid "I'll take the call — back in a moment."
msgstr "전화 받고 올게요 — 금방 돌아올게요."

msgid "Sorry about that — where were we?"
msgstr "기다리게 해서 미안해요 — 우리 어디까지 얘기했죠?"

msgid "Sorry, I couldn't get an answer just then. Could you try again?"
msgstr "죄송해요, 방금은 답을 받지 못했어요. 다시 시도해 주시겠어요?"

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. It can be fixed on my settings page."
msgstr "죄송해요, 지금은 답할 수 없어요. 제가 답변에 쓰는 계정에 확인이 필요하고, 다시 시도해도 해결되지 않아요. 제 설정 페이지에서 고칠 수 있어요."

msgid "I still can't answer until my account is sorted out."
msgstr "계정 문제가 해결될 때까지는 아직 답할 수 없어요."

msgid "Sorry, I couldn't get an answer just then."
msgstr "죄송해요, 방금은 답을 받지 못했어요."

# The call recording notice (call_recording.py, #114).
msgid "This call is being recorded."
msgstr "이 통화는 녹음되고 있습니다."

# No model at all (llm_error_speaker.py, #277).
msgid "I can't answer questions yet, because the account I use for my answers isn't set up."
msgstr "답변에 쓰는 계정이 아직 설정되지 않아서 아직 질문에 답할 수 없어요."

msgid "I can't answer questions until I'm set up. Say \"set up Wi-Fi\" to get me online."
msgstr "준비가 끝나기 전에는 질문에 답할 수 없어요. 저를 인터넷에 연결하려면 '와이파이 설정해 줘'라고 말해 주세요."

msgid "Sorry, I can't take calls right now. Please try again later."
msgstr "죄송해요, 지금은 전화를 받을 수 없어요. 나중에 다시 걸어 주세요."

msgid "I'm ready now. Please ask me again."
msgstr "이제 준비됐어요. 다시 물어봐 주세요."

msgid "I'm ready now. Please start a new conversation with me."
msgstr "이제 준비됐어요. 새 대화를 시작해 주세요."

# The first-boot setup (wifi_voice.py, first_boot.py, #278).
msgid "Hi, I'm Teaport. Let's get me online. Give me a moment to look for networks."
msgstr "안녕하세요, 저는 Teaport예요. 인터넷에 연결해 봐요. 네트워크를 찾아볼게요. 잠시만 기다려 주세요."

msgid "You can say \"set up Wi-Fi\" any time to try again."
msgstr "다시 시도하려면 언제든 '와이파이 설정해 줘'라고 말해 주세요."

msgid "I'm online now, so I've left setup mode."
msgstr "인터넷에 연결돼서 연결 모드를 끝냈어요."

# The sessions' own lines: busy / engine-unavailable, consult progress and tool acks (tools.py, agent_session.py).

msgid "Sorry, the voice assistant is busy with another session right now — please try again in a moment."
msgstr "죄송해요, 음성 비서가 지금 다른 세션 중이에요. 조금 뒤에 다시 시도해 주세요."

msgid "Sorry, I can't hear you right now — my speech recognition isn't available. Please try again in a moment."
msgstr "죄송해요, 지금은 음성 인식이 안 돼요. 잠시 후 다시 시도해 주세요."

msgid "Still working on that — {topic}."
msgstr "아직 진행 중이에요 — {topic}."

msgid "Still working on it."
msgstr "아직 진행 중이에요."

msgid "Almost there — {topic}."
msgstr "거의 다 됐어요 — {topic}."

msgid "Almost there — hang tight."
msgstr "거의 다 됐어요, 조금만 기다려 주세요."

msgid "Looking up {q}."
msgstr "{q} 검색할게요."

msgid "Opening that page."
msgstr "그 페이지를 열게요."

msgid "I'll work on that — give me a moment."
msgstr "지금 할게요, 잠시만요."

msgid "One moment, let me set that up."
msgstr "잠시만요, 준비할게요."

# Settings from the phone and the AI account (settings_access.py, ai_account.py, config_ui.py, wifi_setup.py, #279).
msgid "AI account"
msgstr "AI 계정"

msgid "AI account (optional)"
msgstr "AI 계정 (선택)"

msgid "An account is connected."
msgstr "계정이 연결되어 있어요."

msgid "Ask Teaport for a new one: say \"open my settings\"."
msgstr "Teaport에게 새 코드를 요청하세요. '설정 열어 줘'라고 말하면 돼요."

msgid "Checking the key…"
msgstr "키를 확인하는 중…"

msgid "Code"
msgstr "코드"

msgid "Continue"
msgstr "계속"

msgid "Enter the code Teaport gave you. It works once."
msgstr "Teaport가 알려 준 코드를 입력하세요. 한 번만 쓸 수 있어요."

msgid "I can't answer questions yet, because the account I use for my answers isn't set up. Say \"open my settings\" to set it up."
msgstr "답변에 쓰는 계정이 아직 설정되지 않아서 아직 질문에 답할 수 없어요. 설정하시려면 '설정 열어 줘'라고 말해 주세요."

msgid "I couldn't use the AI account key you entered, so I didn't save it. Say \"open my settings\" to try again."
msgstr "입력하신 AI 계정 키를 쓸 수 없어서 저장하지 않았어요. 다시 시도하시려면 '설정 열어 줘'라고 말해 주세요."

msgid "I need to be online for that. Say \"set up Wi-Fi\" to get me online."
msgstr "그러려면 인터넷에 연결되어 있어야 해요. 저를 인터넷에 연결하려면 '와이파이 설정해 줘'라고 말해 주세요."

msgid "I've put a code on my screen. Scan it with your phone's camera, then tap the link that appears to get to my settings."
msgstr "제 화면에 코드를 띄웠어요. 휴대폰 카메라로 스캔한 다음, 나타나는 링크를 누르면 제 설정으로 들어갈 수 있어요."

msgid "If your phone warns that the connection is not private, install {certificate} first, then ask Teaport for a new code."
msgstr "휴대폰에서 비공개 연결이 아니라는 경고가 뜨면, 먼저 {certificate}를 설치한 다음 Teaport에게 새 코드를 요청하세요."

msgid "If your phone warns that this page is not private, here is how to trust Teaport."
msgstr "휴대폰에서 이 페이지가 비공개 연결이 아니라는 경고가 뜨면, 다음 방법으로 Teaport를 신뢰하도록 설정하세요."

msgid "In your phone's browser, go to {address}, and enter the code {code}. It works once, for the next five minutes."
msgstr "휴대폰 브라우저에서 {address}에 접속해서 다음 코드를 입력해 주세요. {code}. 이 코드는 한 번만, 앞으로 5분 동안 쓸 수 있어요."

msgid "Leave this empty to keep the account Teaport has now. To use your own OpenRouter account, paste its key here. Teaport checks the key once it's online, and says out loud whether it worked."
msgstr "지금 Teaport가 쓰는 계정을 그대로 쓰시려면 비워 두세요. 본인의 OpenRouter 계정을 쓰시려면 여기에 그 키를 붙여 넣으세요. Teaport가 인터넷에 연결되면 키를 확인하고, 잘 됐는지 소리 내어 알려 드려요."

msgid "No account is connected yet."
msgstr "아직 연결된 계정이 없어요."

msgid "OpenRouter key"
msgstr "OpenRouter 키"

msgid "Save anyway"
msgstr "그래도 저장"

msgid "Settings"
msgstr "설정"

msgid "Show advanced"
msgstr "고급 설정 보기"

msgid "Sorry, my settings can't be reached from a phone on this box."
msgstr "죄송해요, 이 기기에서는 휴대폰으로 제 설정에 들어갈 수 없어요."

msgid "Tap Continue to get to Teaport's settings on this phone. The code works once."
msgstr "'계속'을 누르면 이 휴대폰에서 Teaport 설정으로 들어가요. 코드는 한 번만 쓸 수 있어요."

msgid "Teaport couldn't check this key: {reason}."
msgstr "Teaport가 이 키를 확인하지 못했어요. {reason}."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, paste a key from your OpenRouter account."
msgstr "Teaport는 답변에 OpenRouter 계정을 써요. 본인 계정을 쓰시려면 OpenRouter 계정의 키를 붙여 넣으세요."

msgid "Teaport's certificate"
msgstr "Teaport 인증서"

msgid "Test and save"
msgstr "확인 후 저장"

msgid "That code didn't work. Check it, or ask Teaport for a new one."
msgstr "코드가 맞지 않아요. 다시 확인하거나 Teaport에게 새 코드를 요청하세요."

msgid "The key works, and it's saved. Teaport uses it from your next conversation."
msgstr "키가 작동하고, 저장됐어요. 다음 대화부터 Teaport가 이 키를 써요."

msgid "This code has expired"
msgstr "만료된 코드예요"

msgid "This code was already used"
msgstr "이미 사용된 코드예요"

msgid "This key didn't work: {reason}."
msgstr "이 키는 쓸 수 없어요. {reason}."

msgid "Your AI account is connected."
msgstr "AI 계정이 연결되어 있어요."

msgid "no AI service is set up on this box"
msgstr "이 기기에는 AI 서비스가 설정되어 있지 않아요"

msgctxt "pattern"
msgid "^\\W*(?:(?:um+|uh+|uhm|er+m?|eh|hm+|ok|okay|hey|so|now|please|teaport|well|alright|right)\\W+){0,3}(?:(?:can|could|would|will) you(?: please)? )?(?:open|show|bring up|pull up|go to|get)(?: up)?(?: me)?(?: to)? (?:(?:my|your|the|teaport's|teaport) )?settings(?:[\\s,]+(?:page|please|now|for me|thanks a lot|thank you (?:so |very )?much|thanks|thank you|cheers|ok(?:ay)?|teaport)\\b)*[\\s.,!?;:…]*$"
msgstr "^\\W*(?:(?:음|어|저|에|그럼|자|저기|이제|teaport(?:야|아)?|티포트(?:야|아)?)[\\s,.!]*){0,3}(?:(?:네|너의|니|당신의|내|제|나의|teaport의?|티포트의?)\\s*)?(?:설정|세팅)\\s*(?:페이지|화면|창|메뉴)?\\s*(?:을|를)?\\s*(?:좀\\s*)?(?:열어|보여|띄워)\\s*(?:줘요|줘|줄래요|줄래|주세요|주실래요|줄\\s*수\\s*있(?:어요|어|나요|을까요|니)|봐요|봐)?\\s*(?:[,\\s]*(?:제발|감사합니다|고마워(?:요)?))?[\\s.!,…?？]*$"

msgctxt "spell"
msgid "slash"
msgstr "슬래시"

msgid "that doesn't look like a key"
msgstr "키 형식이 아닌 것 같아요"

msgid "the AI service didn't answer"
msgstr "AI 서비스가 응답하지 않았어요"

msgid "the AI service refused this key"
msgstr "AI 서비스가 이 키를 거부했어요"

msgid "the key is empty"
msgstr "키가 비어 있어요"

msgid "this account has no credit left"
msgstr "이 계정에 남은 크레딧이 없어요"

msgid "this box's key is set by its installer, so it can't be changed here"
msgstr "이 기기의 키는 설치할 때 정해져서 여기서 바꿀 수 없어요"

# A key the agent (OpenClaw) did not take: nothing changed (ai_account.save_key, #281).
msgid "Teaport couldn't switch everything over to this key, so it kept the one it had. Try again in a minute."
msgstr "Teaport가 모든 것을 이 키로 바꾸지 못해서 기존 키를 그대로 두었습니다. 1분 후에 다시 시도해 주세요."

# One OpenClaw may have taken all the same: a mismatch is recorded (ai_account.save_key, #281).
msgid "Teaport couldn't finish switching to this key. Try saving it again."
msgstr "Teaport가 이 키로 바꾸는 작업을 끝내지 못했습니다. 다시 저장해 주세요."

# The same without its pointer, where "open my settings" is not heard (wifi_voice.py).
msgid "I couldn't use the AI account key you entered, so I didn't save it."
msgstr "입력하신 AI 계정 키를 쓸 수 없어서 저장하지 않았어요."

# The trial credit (credit.py, llm_error_speaker.py, #280).
msgid "Quick note: I've used half of my trial credit. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "잠깐 알려 드릴게요. 체험용 크레딧을 절반 썼어요. 시간 나실 때 '설정 열어 줘'라고 말해서 본인 계정을 연결해 주세요."

msgid "Quick note: my trial credit is almost used up. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "잠깐 알려 드릴게요. 체험용 크레딧이 거의 다 떨어졌어요. 시간 나실 때 '설정 열어 줘'라고 말해서 본인 계정을 연결해 주세요."

msgid "My trial credit has run out, so I can't answer questions until you connect your own account. Say \"open my settings\" to do that."
msgstr "체험용 크레딧을 다 써서, 본인 계정을 연결하시기 전까지는 질문에 답할 수 없어요. 연결하시려면 '설정 열어 줘'라고 말해 주세요."

msgid "My trial credit has run out, so I can't answer questions until your own account is connected."
msgstr "체험용 크레딧을 다 써서, 본인 계정이 연결되기 전까지는 질문에 답할 수 없어요."

msgid "Teaport is using its included trial credit."
msgstr "Teaport가 기본 제공된 체험용 크레딧을 쓰고 있어요."

msgid "Half of the trial credit is used. Connect your own account to keep Teaport answering."
msgstr "체험용 크레딧을 절반 썼어요. Teaport가 계속 답할 수 있도록 본인 계정을 연결해 주세요."

msgid "The trial credit is almost used up: about {amount} left. Connect your own account to keep Teaport answering."
msgstr "체험용 크레딧이 거의 다 떨어졌어요. 약 {amount} 남았어요. Teaport가 계속 답할 수 있도록 본인 계정을 연결해 주세요."

msgid "The trial credit has run out. Connect your own account so Teaport can answer again."
msgstr "체험용 크레딧을 다 썼어요. Teaport가 다시 답할 수 있도록 본인 계정을 연결해 주세요."

msgid "Back to settings"
msgstr "설정으로 돌아가기"

msgid "Code from OpenRouter"
msgstr "OpenRouter에서 받은 코드"

msgid "Connect your OpenRouter account"
msgstr "OpenRouter 계정 연결하기"

msgid "Connecting…"
msgstr "연결하는 중…"

msgid "Finish"
msgstr "완료"


msgid "OpenRouter didn't accept the sign-in"
msgstr "OpenRouter가 로그인을 받아들이지 않았어요"

msgid "OpenRouter didn't connect the account. You can try again from Teaport's settings, or paste a key there instead."
msgstr "OpenRouter가 계정을 연결하지 않았어요. Teaport 설정에서 다시 해 보거나, 거기에 키를 붙여 넣으세요."


msgid "Tap Finish to connect your OpenRouter account to Teaport."
msgstr "완료를 탭하면 OpenRouter 계정이 Teaport에 연결돼요."

msgid "Teaport couldn't connect your OpenRouter account"
msgstr "Teaport가 OpenRouter 계정을 연결하지 못했어요"

msgid "Teaport couldn't connect your OpenRouter account: {reason}. You can try again from Teaport's settings, or paste a key there instead."
msgstr "Teaport가 OpenRouter 계정을 연결하지 못했어요: {reason}. Teaport 설정에서 다시 해 보거나, 거기에 키를 붙여 넣으세요."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, connect it here, or paste a key from it."
msgstr "Teaport는 답변에 OpenRouter 계정을 써요. 본인 계정을 쓰시려면 여기서 연결하거나, 그 계정의 키를 붙여 넣으세요."

msgid "Teaport uses your OpenRouter account from your next conversation."
msgstr "다음 대화부터 Teaport가 본인의 OpenRouter 계정을 써요."

msgid "Teaport's settings have closed on this phone. Say \"open my settings\", then connect again."
msgstr "이 휴대폰에서 Teaport 설정이 닫혔어요. '설정 열어 줘'라고 말한 다음 다시 연결하세요."

msgid "This connection has expired. Go back to Teaport's settings and connect again."
msgstr "이 연결은 만료됐어요. Teaport 설정으로 돌아가서 다시 연결하세요."



msgid "Your OpenRouter account is connected"
msgstr "OpenRouter 계정이 연결됐어요"

msgid "Connecting your OpenRouter account to Teaport"
msgstr "OpenRouter 계정을 Teaport에 연결하는 중이에요"

msgid "Continue to Teaport"
msgstr "Teaport로 계속"

msgid "Copied"
msgstr "복사했어요"

msgid "Copy code"
msgstr "코드 복사"

msgid "If OpenRouter showed you a code, paste it here."
msgstr "OpenRouter에 코드가 나왔다면 여기에 붙여 넣으세요."

msgid "If that doesn't work: copy this code, open Teaport's settings on this phone, and paste it into {field}. It works once, in the next ten minutes."
msgstr "잘 안 되면 이 코드를 복사하고, 이 휴대폰에서 Teaport 설정을 열어 {field}에 붙여 넣으세요. 한 번만, 10분 안에 쓸 수 있어요."

msgid "If your phone warns that the connection isn't private, it's the same warning you saw when you opened Teaport's settings."
msgstr "휴대폰에서 연결이 비공개가 아니라는 경고가 나오면, Teaport 설정을 열 때 본 것과 같은 경고예요."

msgid "Now let's connect your OpenRouter account. I've put a code on my screen. Scan it with your phone's camera, tap the link that appears, and follow the steps on your phone."
msgstr "이제 OpenRouter 계정을 연결해 볼게요. 제 화면에 코드를 띄웠어요. 휴대폰 카메라로 스캔하고, 나타나는 링크를 탭한 다음 휴대폰에 나오는 단계를 따라 하세요."

msgid "Now let's connect your OpenRouter account. In your phone's browser, go to {address}, enter the code {code}, and follow the steps there. The code works once, for the next five minutes."
msgstr "이제 OpenRouter 계정을 연결해 볼게요. 휴대폰 브라우저에서 {address}로 가서 코드 {code}를 입력하고, 거기 나오는 단계를 따라 하세요. 코드는 한 번만, 5분 동안 쓸 수 있어요."

msgid "Save it again"
msgstr "다시 저장"

msgid "Teaport couldn't save the key"
msgstr "Teaport가 키를 저장하지 못했어요"

msgid "Teaport no longer has that key. Tap Connect your OpenRouter account to sign in again."
msgstr "Teaport에 그 키가 더 이상 없어요. OpenRouter 계정 연결하기를 탭해서 다시 로그인하세요."

msgid "Teaport still has the key from your OpenRouter sign-in. Tap Save it again to try once more."
msgstr "Teaport에 OpenRouter 로그인으로 받은 키가 아직 있어요. 다시 저장을 탭해서 한 번 더 해 보세요."

msgid "That doesn't look like a code from OpenRouter. Check it and paste it again."
msgstr "OpenRouter 코드가 아닌 것 같아요. 확인하고 다시 붙여 넣으세요."

msgid "There's no sign-in waiting for a code. Tap Connect your OpenRouter account to start a new one."
msgstr "코드를 기다리는 로그인이 없어요. OpenRouter 계정 연결하기를 탭해서 새로 시작하세요."

msgid "This link doesn't lead to a Teaport on a home network, so this page won't go on with it."
msgstr "이 링크는 집 네트워크의 Teaport로 연결되지 않아서, 이 페이지는 더 진행하지 않아요."

msgid "To connect your OpenRouter account by signing in instead, leave this empty and finish setting up Wi-Fi. Then Teaport shows you how, or you can say \"open my settings\"."
msgstr "로그인으로 OpenRouter 계정을 연결하려면 여기를 비워 두고 Wi-Fi 설정을 마치세요. 그다음 Teaport가 방법을 알려 드리거나, '설정 열어 줘'라고 말하면 돼요."

msgid "You sign in to OpenRouter on this phone and approve Teaport. OpenRouter then shows a code: copy it, come back to Teaport's settings, and paste it into Code from OpenRouter."
msgstr "이 휴대폰에서 OpenRouter에 로그인하고 Teaport를 승인해요. 그러면 OpenRouter에 코드가 나와요. 복사해서 Teaport 설정으로 돌아와 OpenRouter에서 받은 코드에 붙여 넣으세요."

msgid "You sign in to OpenRouter on this phone and approve Teaport. Then a Teaport page asks you to tap Finish."
msgstr "이 휴대폰에서 OpenRouter에 로그인하고 Teaport를 승인해요. 그다음 Teaport 페이지에서 완료를 탭하라고 안내해요."

msgid "Your phone needs to be on the same Wi-Fi as Teaport. If it doesn't go on by itself, tap the button."
msgstr "휴대폰이 Teaport와 같은 Wi-Fi에 연결돼 있어야 해요. 자동으로 넘어가지 않으면 버튼을 탭하세요."

msgid "Your OpenRouter account has no credit yet, so Teaport can't answer until you add some at openrouter.ai/settings/credits."
msgstr "OpenRouter 계정에 아직 크레딧이 없어서, openrouter.ai/settings/credits에서 크레딧을 추가할 때까지 Teaport가 대답할 수 없어요."

msgid "Your AI account is connected, but it has no credit yet. Add some on OpenRouter's website, and then I can answer."
msgstr "AI 계정은 연결됐지만 아직 크레딧이 없어요. OpenRouter 웹사이트에서 크레딧을 추가하면 대답할 수 있어요."

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. Say \"open my settings\" to fix it."
msgstr "죄송해요, 지금은 답할 수 없어요. 제가 답변에 쓰는 계정에 확인이 필요하고, 다시 시도해도 해결되지 않아요. 고치시려면 '설정 열어 줘'라고 말해 주세요."
