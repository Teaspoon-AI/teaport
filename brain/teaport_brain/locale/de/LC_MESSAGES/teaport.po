# the user means: start
msgctxt "pattern"
msgid "\\b(?:set(?:s|ting)?[- ]?up|(?:re)?configur(?:e|es|ing)|(?:re)?connect(?:s|ing)?|join(?:s|ing)?|chang(?:e|es|ing)|switch(?:es|ing)?)\\b(?: (?:the|a|my|your|our|this|that|to|onto|new|another|different|other|home|guest|me|us|it|yourself|the box|back)){0,4} ?(?:(?:wi[-‐‑ ]?fi|wireless)(?: (?:network|connection))?|network|hotspot)s?(?= *(?:[.,!?;:…]|$)| on \\w| (?:and|so|but|because|since|then|now|please|again|for|to|at|in|with|from|here|there|too|first|today|tonight|called|named|instead|as|if|when|or|that|which|i|we|ok|okay|thanks|thank|right|quickly)\\b)|\\bwi[-‐‑ ]?fi (?:set[- ]?up|setup)\\b"
msgstr "\\b(?:einricht\\w*|einzuricht\\w*|konfigurier\\w*|verbind|verbinde|verbinden|verbindest|verbindet|(?:ä|ae)nder\\w*|andern|wechsel\\w*|wechsl\\w*)\\b(?:\\W+\\w+){0,4}?\\W+(?:w[\\s-]?lan|wi[\\s-]?fi)|\\b(?:richt|richte|richtest|richtet|richten|stell|stelle|stellst|stellt|stellen)\\b(?:\\W+\\w+){0,3}?\\W+(?:w[\\s-]?lan|wi[\\s-]?fi)\\w*\\W+(?:\\w+\\W+){0,3}?(?:ein|um)\\b|\\b(?:w[\\s-]?lan|wi[\\s-]?fi)\\w*(?:\\W+\\w+){0,3}?\\W*(?:einricht\\w*|einzuricht\\w*|konfigur\\w*|einstellen|einzustellen|set ?up|verbinden|(?:ä|ae)ndern|andern|wechseln)\\b"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\b(?:ja|jawohl|jo|jup|jep|japp|klar|sicher|gerne?|(?<!wie )bitte(?!\\s*\\?)|genau|okay|okey|ok|o\\.?k|einverstanden|in ordnung|passt(?! schon)|natürlich|natuerlich|naturlich|auf jeden fall|warum nicht|nichts dagegen|mach (?:das|es|mal|ruhig|schon|nur)|machen wir|leg los|los geht|na los|dann los|(?:ist|klingt) gut|starte?n?)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b(?:nein|nee|nö|noe|nope|nix|keinesfalls|kein(?:e|en)? (?:lust|bedarf|interesse|zeit)|auf keinen fall|vergiss (?:es|das)|lass (?:es|das)(?! uns)|abbrechen|abbruch|stopp?|später|spaeter)\\b|^\\W*ne\\b|\\blass mal\\W*$|(?<!warum )(?<!wieso )(?<!weshalb )(?<!denn )(?<!geht )(?<!klappt )(?<!funktioniert )\\bnicht\\b(?! (?:schlecht|verkehrt|übel|schaden)\\b)"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:abbrech\\w*|brich\\w*(?:\\W+\\w+){0,2}?\\W+ab|abbruch|stopp?(?:en)?|aufh(?:ö|oe|o)r\\w*|h(?:ö|oe|o)r\\w* auf|beende\\w*|schluss|vergiss (?:es|das)|lass (?:es|das|gut) sein)\\b|^\\W*halt\\W*$"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:wiederhol\\w*|nochmal|nochmals|noch ?mal|noch einmal|(?:wie|was) war|wie lautet|wie hei(?:ß|ss|s)t|passwort\\w*|kennwort|w[\\s-]?lan[\\s-]?name|netzwerkname|netzname|name des (?:w[\\s-]?lans?|netzwerks|netzes)|sag (?:das|es)|was hast du gesagt|wie bitte|nicht verstanden|langsamer)\\b"

# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "Sprache"

# The session arbiter (session_arbiter.py): one conversation at a time.
msgid "Sorry, I'm on a phone call right now. Please try again when it's over."
msgstr "Tut mir leid, ich bin gerade in einem Telefonat. Bitte versuch es noch einmal, wenn es vorbei ist."

msgid "Sorry, I'm in another conversation right now. Please try again in a little while."
msgstr "Tut mir leid, ich bin gerade in einem anderen Gespräch. Bitte versuch es gleich noch einmal."

msgid "Sorry, a phone call is coming in and I have to take it. We can talk again when it's over."
msgstr "Tut mir leid, gerade kommt ein Anruf rein, den ich annehmen muss. Wir können danach weiterreden."

# A phone call during a conversation (session_arbiter.py, call_prompt.py): the agent asks,
# steps away, and comes back.
#. Translators: {caller} is a name or a phone number, as the caller ID gives it.
msgid "Someone's calling me — {caller}. Should I step away for a moment?"
msgstr "Jemand ruft mich an — {caller}. Soll ich kurz rangehen?"

msgid "Someone's calling me. Should I step away for a moment?"
msgstr "Jemand ruft mich an. Soll ich kurz rangehen?"

msgid "Someone's calling me from a withheld number. Should I step away for a moment?"
msgstr "Jemand ruft mich mit unterdrückter Nummer an. Soll ich kurz rangehen?"

msgid "I'll take the call — back in a moment."
msgstr "Ich gehe kurz ran — bin gleich wieder da."

msgid "Sorry about that — where were we?"
msgstr "Entschuldige die Unterbrechung — wo waren wir stehen geblieben?"
