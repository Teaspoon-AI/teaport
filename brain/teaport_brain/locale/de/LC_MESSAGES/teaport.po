# the user means: start
msgctxt "pattern"
msgid "\\b(?:set(?:s|ting)?[- ]?up|(?:re)?configur(?:e|es|ing)|(?:re)?connect(?:s|ing)?|join(?:s|ing)?|chang(?:e|es|ing)|switch(?:es|ing)?)\\b(?: (?:the|a|my|your|our|this|that|to|onto|new|another|different|other|home|guest|me|us|it|yourself|the box|back)){0,4} ?(?:(?:wi[-‐‑ ]?fi|wireless)(?: (?:network|connection))?|network|hotspot)s?(?= *(?:[.,!?;:…]|$)| on \\w| (?:and|so|but|because|since|then|now|please|again|for|to|at|in|with|from|here|there|too|first|today|tonight|called|named|instead|as|if|when|or|that|which|i|we|ok|okay|thanks|thank|right|quickly)\\b)|\\bwi[-‐‑ ]?fi (?:set[- ]?up|setup)\\b"
msgstr "\\b(?:einricht\\w*|einzuricht\\w*|konfigurier\\w*|verbind|verbinde|verbinden|verbindest|verbindet|(?:ä|ae)nder\\w*|andern|wechsel\\w*|wechsl\\w*)\\b(?:\\W+\\w+){0,4}?\\W+(?:w[\\s-]?lan|wi[\\s-]?fi)|\\b(?:richt|richte|richtest|richtet|richten|stell|stelle|stellst|stellt|stellen)\\b(?:\\W+\\w+){0,3}?\\W+(?:w[\\s-]?lan|wi[\\s-]?fi)\\w*\\W+(?:\\w+\\W+){0,3}?(?:ein|um)\\b|\\b(?:w[\\s-]?lan|wi[\\s-]?fi)\\w*(?:\\W+\\w+){0,3}?\\W*(?:einricht\\w*|einzuricht\\w*|konfigur\\w*|einstellen|einzustellen|set ?up|verbinden|(?:ä|ae)ndern|andern|wechseln)\\b"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\b(?:ja|jawohl|jo|jup|jep|japp|klar|sicher|gerne?|(?<!wie )bitte(?!\\s*\\?)|genau|okay|okey|ok|o\\.?k|einverstanden|in ordnung|passt(?! schon)|natürlich|natuerlich|naturlich|auf jeden fall|warum nicht|nichts dagegen|mach (?:das|es|mal|ruhig|schon|nur)|machen wir|leg los|los geht|na los|dann los|(?:ist|klingt) gut|starte?n?)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b(?:nein|nee|nö|noe|nope|nix|keinesfalls|kein(?:e|en)? (?:lust|bedarf|interesse|zeit)|auf keinen fall|vergiss (?:es|das)|lass (?:es|das)(?! uns)|abbrechen|abbruch|stopp?|später|spaeter)\\b|^\\W*ne\\b|\\blass mal\\W*$|(?<!warum )(?<!wieso )(?<!weshalb )(?<!denn )(?<!geht )(?<!klappt )(?<!funktioniert )\\bnicht\\b(?! (?:schlecht|verkehrt|übel|schaden)\\b)"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:abbrech\\w*|brich\\w*(?:\\W+\\w+){0,2}?\\W+ab|abbruch|stopp?(?:en)?|aufh(?:ö|oe|o)r\\w*|h(?:ö|oe|o)r\\w* auf|beende\\w*|schluss|vergiss (?:es|das)|lass (?:es|das|gut) sein)\\b|^\\W*halt\\W*$"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:wiederhol\\w*|nochmal|nochmals|noch ?mal|noch einmal|(?:wie|was) war|wie lautet|wie hei(?:ß|ss|s)t|passwort\\w*|kennwort|w[\\s-]?lan[\\s-]?name|netzwerkname|netzname|name des (?:w[\\s-]?lans?|netzwerks|netzes)|sag (?:das|es)|was hast du gesagt|wie bitte|nicht verstanden|langsamer)\\b"

# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "Sprache"

# The session arbiter (session_arbiter.py): one conversation at a time.
msgid "Sorry, I'm on a phone call right now. Please try again when it's over."
msgstr "Tut mir leid, ich bin gerade in einem Telefonat. Bitte versuch es noch einmal, wenn es vorbei ist."

msgid "Sorry, I'm in another conversation right now. Please try again in a little while."
msgstr "Tut mir leid, ich bin gerade in einem anderen Gespräch. Bitte versuch es gleich noch einmal."

msgid "Sorry, a phone call is coming in and I have to take it. We can talk again when it's over."
msgstr "Tut mir leid, gerade kommt ein Anruf rein, den ich annehmen muss. Wir können danach weiterreden."

# A phone call during a conversation (session_arbiter.py, call_prompt.py): the agent asks,
# steps away, and comes back.
#. Translators: {caller} is a name or a phone number, as the caller ID gives it.
msgid "Someone's calling me — {caller}. Should I step away for a moment?"
msgstr "Jemand ruft mich an — {caller}. Soll ich kurz rangehen?"

msgid "Someone's calling me. Should I step away for a moment?"
msgstr "Jemand ruft mich an. Soll ich kurz rangehen?"

msgid "I'll take the call — back in a moment."
msgstr "Ich gehe kurz ran — bin gleich wieder da."

msgid "Sorry about that — where were we?"
msgstr "Entschuldige die Unterbrechung — wo waren wir stehen geblieben?"

msgid "Sorry, I couldn't get an answer just then. Could you try again?"
msgstr "Tut mir leid, ich habe gerade keine Antwort bekommen. Kannst du es noch einmal versuchen?"

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. It can be fixed on my settings page."
msgstr "Tut mir leid, ich kann gerade nicht antworten: Das Konto, das ich für meine Antworten nutze, braucht Aufmerksamkeit, und ein neuer Versuch hilft nicht. Das lässt sich auf meiner Einstellungsseite beheben."

msgid "I still can't answer until my account is sorted out."
msgstr "Ich kann erst wieder antworten, wenn mein Konto in Ordnung gebracht ist."

msgid "Sorry, I couldn't get an answer just then."
msgstr "Tut mir leid, ich habe gerade keine Antwort bekommen."

# The call recording notice (call_recording.py, #114).
msgid "This call is being recorded."
msgstr "Dieses Gespräch wird aufgezeichnet."

# No model at all (llm_error_speaker.py, #277).
msgid "I can't answer questions yet, because the account I use for my answers isn't set up."
msgstr "Ich kann noch keine Fragen beantworten, weil das Konto, das ich für meine Antworten nutze, noch nicht eingerichtet ist."

msgid "I can't answer questions until I'm set up. Say \"set up Wi-Fi\" to get me online."
msgstr "Ich kann erst Fragen beantworten, wenn ich eingerichtet bin. Sag „Richte das WLAN ein“, damit ich online komme."

msgid "Sorry, I can't take calls right now. Please try again later."
msgstr "Tut mir leid, ich kann gerade keine Anrufe annehmen. Bitte versuch es später noch einmal."

msgid "I'm ready now. Please ask me again."
msgstr "Jetzt bin ich bereit. Frag mich bitte noch einmal."

msgid "I'm ready now. Please start a new conversation with me."
msgstr "Jetzt bin ich bereit. Bitte starte ein neues Gespräch mit mir."

# The first-boot setup (wifi_voice.py, first_boot.py, #278).
msgid "Hi, I'm Teaport. Let's get me online. Give me a moment to look for networks."
msgstr "Hallo, ich bin Teaport. Bringen wir mich online. Einen Moment, ich suche nach Netzwerken."

msgid "You can say \"set up Wi-Fi\" any time to try again."
msgstr "Du kannst jederzeit „Richte das WLAN ein“ sagen, um es noch einmal zu versuchen."

msgid "I'm online now, so I've left setup mode."
msgstr "Ich bin jetzt online, deshalb habe ich den Einrichtungsmodus beendet."

# The sessions' own lines: busy / engine-unavailable, consult progress and tool acks (tools.py, agent_session.py).

msgid "Sorry, the voice assistant is busy with another session right now — please try again in a moment."
msgstr "Tut mir leid, der Sprachassistent ist gerade mit einer anderen Sitzung beschäftigt. Versuch es gleich noch einmal."

msgid "Sorry, I can't hear you right now — my speech recognition isn't available. Please try again in a moment."
msgstr "Tut mir leid, ich höre dich gerade nicht, die Spracherkennung ist nicht verfügbar. Versuch es gleich noch einmal."

msgid "Still working on that — {topic}."
msgstr "Ich bin noch dabei — {topic}."

msgid "Still working on it."
msgstr "Ich bin noch dabei."

msgid "Almost there — {topic}."
msgstr "Fast geschafft — {topic}."

msgid "Almost there — hang tight."
msgstr "Fast geschafft, noch einen Moment."

msgid "Looking up {q}."
msgstr "Ich suche {q}."

msgid "Opening that page."
msgstr "Ich öffne die Seite."

msgid "I'll work on that — give me a moment."
msgstr "Ich kümmere mich gleich darum, einen Moment."

msgid "One moment, let me set that up."
msgstr "Einen Moment, ich richte das ein."

# Settings from the phone and the AI account (settings_access.py, ai_account.py, config_ui.py, wifi_setup.py, #279).
msgid "AI account"
msgstr "KI-Konto"

msgid "AI account (optional)"
msgstr "KI-Konto (optional)"

msgid "An account is connected."
msgstr "Ein Konto ist verbunden."

msgid "Ask Teaport for a new one: say \"open my settings\"."
msgstr "Bitte Teaport um einen neuen: Sag „Öffne die Einstellungen“."

msgid "Checking the key…"
msgstr "Schlüssel wird geprüft …"

msgid "Code"
msgstr "Code"

msgid "Continue"
msgstr "Weiter"

msgid "Enter the code Teaport gave you. It works once."
msgstr "Gib den Code ein, den Teaport dir gegeben hat. Er funktioniert nur einmal."

msgid "I can't answer questions yet, because the account I use for my answers isn't set up. Say \"open my settings\" to set it up."
msgstr "Ich kann noch keine Fragen beantworten, weil das Konto, das ich für meine Antworten nutze, noch nicht eingerichtet ist. Sag „Öffne die Einstellungen“, um es einzurichten."

msgid "I couldn't use the AI account key you entered, so I didn't save it. Say \"open my settings\" to try again."
msgstr "Ich konnte den Schlüssel für das KI-Konto, den du eingegeben hast, nicht verwenden, deshalb habe ich ihn nicht gespeichert. Sag „Öffne die Einstellungen“, um es noch einmal zu versuchen."

msgid "I need to be online for that. Say \"set up Wi-Fi\" to get me online."
msgstr "Dafür muss ich online sein. Sag „Richte das WLAN ein“, damit ich online komme."

msgid "I've put a code on my screen. Scan it with your phone's camera, then tap the link that appears to get to my settings."
msgstr "Ich habe einen Code auf meinem Display angezeigt. Scanne ihn mit der Kamera deines Handys und tippe dann auf den Link, der erscheint, um zu meinen Einstellungen zu kommen."

msgid "If your phone warns that the connection is not private, install {certificate} first, then ask Teaport for a new code."
msgstr "Wenn dein Handy warnt, dass die Verbindung nicht privat ist, installiere zuerst {certificate} und bitte Teaport dann um einen neuen Code."

msgid "If your phone warns that this page is not private, here is how to trust Teaport."
msgstr "Wenn dein Handy warnt, dass diese Seite nicht privat ist, erfährst du hier, wie du Teaport vertrauen kannst."

msgid "In your phone's browser, go to {address}, and enter the code {code}. It works once, for the next five minutes."
msgstr "Öffne im Browser deines Handys {address} und gib den Code {code} ein. Er funktioniert einmal, in den nächsten fünf Minuten."

msgid "Leave this empty to keep the account Teaport has now. To use your own OpenRouter account, paste its key here. Teaport checks the key once it's online, and says out loud whether it worked."
msgstr "Lass dieses Feld leer, um das Konto zu behalten, das Teaport gerade nutzt. Wenn du dein eigenes OpenRouter-Konto nutzen möchtest, füge hier seinen Schlüssel ein. Teaport prüft den Schlüssel, sobald es online ist, und sagt laut, ob er funktioniert hat."

msgid "No account is connected yet."
msgstr "Noch ist kein Konto verbunden."

msgid "OpenRouter key"
msgstr "OpenRouter-Schlüssel"

msgid "Save anyway"
msgstr "Trotzdem speichern"

msgid "Settings"
msgstr "Einstellungen"

msgid "Show advanced"
msgstr "Erweiterte Optionen anzeigen"

msgid "Sorry, my settings can't be reached from a phone on this box."
msgstr "Tut mir leid, auf diesem Gerät sind meine Einstellungen nicht über ein Handy erreichbar."

msgid "Tap Continue to get to Teaport's settings on this phone. The code works once."
msgstr "Tippe auf „Weiter“, um auf diesem Handy zu den Einstellungen von Teaport zu kommen. Der Code funktioniert nur einmal."

msgid "Teaport couldn't check this key: {reason}."
msgstr "Teaport konnte diesen Schlüssel nicht prüfen: {reason}."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, paste a key from your OpenRouter account."
msgstr "Teaport nutzt für seine Antworten ein OpenRouter-Konto. Wenn du dein eigenes nutzen möchtest, füge einen Schlüssel aus deinem OpenRouter-Konto ein."

msgid "Teaport's certificate"
msgstr "das Zertifikat von Teaport"

msgid "Test and save"
msgstr "Prüfen und speichern"

msgid "That code didn't work. Check it, or ask Teaport for a new one."
msgstr "Dieser Code hat nicht funktioniert. Prüfe ihn oder bitte Teaport um einen neuen."

msgid "The key works, and it's saved. Teaport uses it from your next conversation."
msgstr "Der Schlüssel funktioniert und ist gespeichert. Teaport nutzt ihn ab deinem nächsten Gespräch."

msgid "This code has expired"
msgstr "Dieser Code ist abgelaufen"

msgid "This code was already used"
msgstr "Dieser Code wurde schon verwendet"

msgid "This key didn't work: {reason}."
msgstr "Dieser Schlüssel hat nicht funktioniert: {reason}."

msgid "Your AI account is connected."
msgstr "Dein KI-Konto ist verbunden."

msgid "no AI service is set up on this box"
msgstr "auf diesem Gerät ist kein KI-Dienst eingerichtet"

msgctxt "pattern"
msgid "^\\W*(?:(?:um+|uh+|uhm|er+m?|eh|hm+|ok|okay|hey|so|now|please|teaport|well|alright|right)\\W+){0,3}(?:(?:can|could|would|will) you(?: please)? )?(?:open|show|bring up|pull up|go to|get)(?: up)?(?: me)?(?: to)? (?:(?:my|your|the|teaport's|teaport) )?settings(?= *(?:[.,!?;:…]|$)| (?:page|please|now)\\b)"
msgstr "^\\W*(?:(?:äh+m?|öh+m?|ähm|hm+|ehm|teaport|ok|okay|also|hey|und|bitte|na|so)\\W+){0,3}(?:(?:(?:kannst|könntest)\\s+du|(?:können|könnten)\\s+sie)(?:\\s+(?:mir|uns|bitte|mal|doch|kurz))*\\s+)?(?:(?:öffne|öffnet|oeffne|offne|zeig|zeige|zeigt|ruf|rufe|geh|gehe)(?:\\s+(?:mir|uns|bitte|mal|doch|jetzt|gleich|zu|in))*\\s+(?:(?:die|deine|meine|ihre|der|den|teaports?)\\s+)?einstellung(?:en|sseite)(?:\\s+(?:auf|an))?(?=\\s*(?:[.,!?;:…]|$)|\\s+(?:bitte|jetzt|mal|seite)\\b)|mach(?:e|t)?(?:\\s+(?:mir|uns|bitte|mal|doch|jetzt|gleich))*\\s+(?:(?:die|deine|meine|ihre|teaports?)\\s+)?einstellung(?:en|sseite)\\s+auf(?=\\s*(?:[.,!?;:…]|$)|\\s+(?:bitte|jetzt|mal)\\b)|(?:bitte\\s+)?(?:(?:die|deine|meine)\\s+)?einstellung(?:en|sseite)\\s+(?:bitte\\s+)?(?:öffnen|oeffnen|offnen|aufmachen|zeigen|anzeigen|aufrufen)(?=\\s*(?:[.,!?;:…]|$)|\\s+(?:bitte|jetzt)\\b))"

msgctxt "spell"
msgid "slash"
msgstr "Schrägstrich"

msgid "that doesn't look like a key"
msgstr "das sieht nicht wie ein Schlüssel aus"

msgid "the AI service didn't answer"
msgstr "der KI-Dienst hat nicht geantwortet"

msgid "the AI service refused this key"
msgstr "der KI-Dienst hat diesen Schlüssel abgelehnt"

msgid "the key is empty"
msgstr "der Schlüssel ist leer"

msgid "this account has no credit left"
msgstr "dieses Konto hat kein Guthaben mehr"

msgid "this box's key is set by its installer, so it can't be changed here"
msgstr "der Schlüssel dieses Geräts wird bei der Installation festgelegt und kann hier nicht geändert werden"

# A key the agent (OpenClaw) did not take: nothing changed (ai_account.save_key, #281).
msgid "Teaport couldn't switch everything over to this key, so it kept the one it had. Try again in a minute."
msgstr "Teaport konnte nicht alles auf diesen Schlüssel umstellen und hat deshalb den bisherigen behalten. Versuch es in einer Minute noch einmal."

# One OpenClaw may have taken all the same: a mismatch is recorded (ai_account.save_key, #281).
msgid "Teaport couldn't finish switching to this key. Try saving it again."
msgstr "Teaport konnte den Wechsel zu diesem Schlüssel nicht abschließen. Speichere ihn bitte noch einmal."

# The same without its pointer, where "open my settings" is not heard (wifi_voice.py).
msgid "I couldn't use the AI account key you entered, so I didn't save it."
msgstr "Ich konnte den Schlüssel für das KI-Konto, den du eingegeben hast, nicht verwenden, deshalb habe ich ihn nicht gespeichert."

# The trial credit (credit.py, llm_error_speaker.py, #280).
msgid "Quick note: I've used half of my trial credit. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "Kurzer Hinweis: Ich habe die Hälfte meines Testguthabens verbraucht. Wenn du einen Moment Zeit hast, sag „Öffne die Einstellungen“, um dein eigenes Konto zu verbinden."

msgid "Quick note: my trial credit is almost used up. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "Kurzer Hinweis: Mein Testguthaben ist fast aufgebraucht. Wenn du einen Moment Zeit hast, sag „Öffne die Einstellungen“, um dein eigenes Konto zu verbinden."

msgid "My trial credit has run out, so I can't answer questions until you connect your own account. Say \"open my settings\" to do that."
msgstr "Mein Testguthaben ist aufgebraucht, deshalb kann ich keine Fragen beantworten, bis du dein eigenes Konto verbindest. Sag dazu „Öffne die Einstellungen“."

msgid "My trial credit has run out, so I can't answer questions until your own account is connected."
msgstr "Mein Testguthaben ist aufgebraucht, deshalb kann ich keine Fragen beantworten, bis dein eigenes Konto verbunden ist."

msgid "Teaport is using its included trial credit."
msgstr "Teaport nutzt gerade das mitgelieferte Testguthaben."

msgid "Half of the trial credit is used. Connect your own account to keep Teaport answering."
msgstr "Die Hälfte des Testguthabens ist verbraucht. Verbinde dein eigenes Konto, damit Teaport weiter antwortet."

msgid "The trial credit is almost used up: about {amount} left. Connect your own account to keep Teaport answering."
msgstr "Das Testguthaben ist fast aufgebraucht: noch etwa {amount} übrig. Verbinde dein eigenes Konto, damit Teaport weiter antwortet."

msgid "The trial credit has run out. Connect your own account so Teaport can answer again."
msgstr "Das Testguthaben ist aufgebraucht. Verbinde dein eigenes Konto, damit Teaport wieder antworten kann."

msgid "Back to settings"
msgstr "Zurück zu den Einstellungen"

msgid "Code from OpenRouter"
msgstr "Code von OpenRouter"

msgid "Connect your OpenRouter account"
msgstr "Dein OpenRouter-Konto verbinden"

msgid "Connecting…"
msgstr "Wird verbunden…"

msgid "Finish"
msgstr "Fertig"


msgid "OpenRouter didn't accept the sign-in"
msgstr "OpenRouter hat die Anmeldung nicht angenommen"

msgid "OpenRouter didn't connect the account. You can try again from Teaport's settings, or paste a key there instead."
msgstr "OpenRouter hat das Konto nicht verbunden. Du kannst es in den Einstellungen von Teaport noch einmal versuchen oder dort stattdessen einen Schlüssel einfügen."


msgid "Tap Finish to connect your OpenRouter account to Teaport."
msgstr "Tippe auf Fertig, um dein OpenRouter-Konto mit Teaport zu verbinden."

msgid "Teaport couldn't connect your OpenRouter account"
msgstr "Teaport konnte dein OpenRouter-Konto nicht verbinden"

msgid "Teaport couldn't connect your OpenRouter account: {reason}. You can try again from Teaport's settings, or paste a key there instead."
msgstr "Teaport konnte dein OpenRouter-Konto nicht verbinden: {reason}. Du kannst es in den Einstellungen von Teaport noch einmal versuchen oder dort stattdessen einen Schlüssel einfügen."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, connect it here, or paste a key from it."
msgstr "Teaport nutzt für seine Antworten ein OpenRouter-Konto. Wenn du dein eigenes nutzen möchtest, verbinde es hier oder füge einen Schlüssel daraus ein."

msgid "Teaport uses your OpenRouter account from your next conversation."
msgstr "Teaport nutzt dein OpenRouter-Konto ab deinem nächsten Gespräch."

msgid "Teaport's settings have closed on this phone. Say \"open my settings\", then connect again."
msgstr "Die Einstellungen von Teaport sind auf diesem Handy geschlossen. Sag „Öffne die Einstellungen“ und verbinde dann noch einmal."

msgid "This connection has expired. Go back to Teaport's settings and connect again."
msgstr "Diese Verbindung ist abgelaufen. Geh zurück zu den Einstellungen von Teaport und verbinde noch einmal."



msgid "Your OpenRouter account is connected"
msgstr "Dein OpenRouter-Konto ist verbunden"

msgid "Connecting your OpenRouter account to Teaport"
msgstr "Dein OpenRouter-Konto wird mit Teaport verbunden"

msgid "Continue to Teaport"
msgstr "Weiter zu Teaport"

msgid "Copied"
msgstr "Kopiert"

msgid "Copy code"
msgstr "Code kopieren"

msgid "If OpenRouter showed you a code, paste it here."
msgstr "Wenn OpenRouter dir einen Code angezeigt hat, füge ihn hier ein."

msgid "If that doesn't work: copy this code, open Teaport's settings on this phone, and paste it into {field}. It works once, in the next ten minutes."
msgstr "Falls das nicht klappt: Kopiere diesen Code, öffne die Einstellungen von Teaport auf diesem Handy und füge ihn bei {field} ein. Er funktioniert einmal, in den nächsten zehn Minuten."

msgid "If your phone warns that the connection isn't private, it's the same warning you saw when you opened Teaport's settings."
msgstr "Wenn dein Handy warnt, dass die Verbindung nicht privat ist: Das ist dieselbe Warnung wie beim Öffnen der Einstellungen von Teaport."

msgid "Now let's connect your OpenRouter account. I've put a code on my screen. Scan it with your phone's camera, tap the link that appears, and follow the steps on your phone."
msgstr "Jetzt verbinden wir dein OpenRouter-Konto. Ich habe einen Code auf meinen Bildschirm gelegt. Scanne ihn mit der Kamera deines Handys, tippe auf den Link, der erscheint, und folge den Schritten auf deinem Handy."

msgid "Now let's connect your OpenRouter account. In your phone's browser, go to {address}, enter the code {code}, and follow the steps there. The code works once, for the next five minutes."
msgstr "Jetzt verbinden wir dein OpenRouter-Konto. Geh im Browser deines Handys auf {address}, gib den Code {code} ein und folge den Schritten dort. Der Code funktioniert einmal, in den nächsten fünf Minuten."

msgid "Save it again"
msgstr "Noch einmal speichern"

msgid "Teaport couldn't save the key"
msgstr "Teaport konnte den Schlüssel nicht speichern"

msgid "Teaport no longer has that key. Tap Connect your OpenRouter account to sign in again."
msgstr "Teaport hat diesen Schlüssel nicht mehr. Tippe auf Dein OpenRouter-Konto verbinden, um dich noch einmal anzumelden."

msgid "Teaport still has the key from your OpenRouter sign-in. Tap Save it again to try once more."
msgstr "Teaport hat den Schlüssel aus deiner OpenRouter-Anmeldung noch. Tippe auf Noch einmal speichern, um es erneut zu versuchen."

msgid "That doesn't look like a code from OpenRouter. Check it and paste it again."
msgstr "Das sieht nicht wie ein Code von OpenRouter aus. Prüfe ihn und füge ihn noch einmal ein."

msgid "There's no sign-in waiting for a code. Tap Connect your OpenRouter account to start a new one."
msgstr "Gerade wartet keine Anmeldung auf einen Code. Tippe auf Dein OpenRouter-Konto verbinden, um eine neue zu starten."

msgid "This link doesn't lead to a Teaport on a home network, so this page won't go on with it."
msgstr "Dieser Link führt zu keinem Teaport in einem Heimnetz, deshalb geht diese Seite damit nicht weiter."

msgid "To connect your OpenRouter account by signing in instead, leave this empty and finish setting up Wi-Fi. Then Teaport shows you how, or you can say \"open my settings\"."
msgstr "Wenn du dein OpenRouter-Konto lieber per Anmeldung verbinden möchtest, lass das Feld leer und richte das WLAN fertig ein. Danach zeigt dir Teaport, wie es geht, oder du sagst „Öffne die Einstellungen“."

msgid "You sign in to OpenRouter on this phone and approve Teaport. OpenRouter then shows a code: copy it, come back to Teaport's settings, and paste it into Code from OpenRouter."
msgstr "Du meldest dich auf diesem Handy bei OpenRouter an und erlaubst Teaport den Zugriff. OpenRouter zeigt dir dann einen Code: Kopiere ihn, geh zurück zu den Einstellungen von Teaport und füge ihn bei Code von OpenRouter ein."

msgid "You sign in to OpenRouter on this phone and approve Teaport. Then a Teaport page asks you to tap Finish."
msgstr "Du meldest dich auf diesem Handy bei OpenRouter an und erlaubst Teaport den Zugriff. Danach bittet dich eine Seite von Teaport, auf Fertig zu tippen."

msgid "Your phone needs to be on the same Wi-Fi as Teaport. If it doesn't go on by itself, tap the button."
msgstr "Dein Handy muss im selben WLAN sein wie Teaport. Wenn es nicht von selbst weitergeht, tippe auf die Schaltfläche."

msgid "Your OpenRouter account has no credit yet, so Teaport can't answer until you add some at openrouter.ai/settings/credits."
msgstr "Dein OpenRouter-Konto hat noch kein Guthaben, deshalb kann Teaport nicht antworten, bis du welches auf openrouter.ai/settings/credits aufgeladen hast."

msgid "Your AI account is connected, but it has no credit yet. Add some on OpenRouter's website, and then I can answer."
msgstr "Dein KI-Konto ist verbunden, aber es hat noch kein Guthaben. Lade welches auf der Website von OpenRouter auf, dann kann ich antworten."
