# the user means: start
msgctxt "pattern"
msgid "\\b(?:set ?up|setup|configure|connect to|join|change|switch)\\b(?: (?:the|a|my|your|to|new|another|different)){0,3} ?wi-?fi\\b|\\bwi-?fi (?:set ?up|setup)\\b"
msgstr "\\b(?:einricht\\w*|einzuricht\\w*|konfigurier\\w*|verbinde|verbinden|verbindest|verbindet|(?:ä|ae)nder\\w*|andern|wechsel\\w*|wechsl\\w*)\\b(?:\\W+\\w+){0,4}?\\W+(?:w[\\s-]?lan|wi[\\s-]?fi)|\\b(?:richt|richte|richtest|richtet|richten|stell|stelle|stellst|stellt|stellen)\\b(?:\\W+\\w+){0,3}?\\W+(?:w[\\s-]?lan|wi[\\s-]?fi)\\w*\\W+(?:\\w+\\W+){0,3}?(?:ein|um)\\b|\\b(?:w[\\s-]?lan|wi[\\s-]?fi)\\w*(?:\\W+\\w+){0,3}?\\W*(?:einricht\\w*|einzuricht\\w*|konfigur\\w*|einstellen|einzustellen|set ?up|verbinden|(?:ä|ae)ndern|andern|wechseln)\\b"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\b(?:ja|jawohl|jo|jup|jep|japp|klar|sicher|gerne?|bitte|genau|okay|okey|ok|o\\.?k|einverstanden|in ordnung|passt|natürlich|natuerlich|naturlich|auf jeden fall|warum nicht|nichts dagegen|mach (?:das|es|mal|ruhig|schon|nur)|machen wir|leg los|los geht|na los|dann los|(?:ist|klingt|alles) gut|starte?n?)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b(?:nein|nee|nö|noe|nope|nix|kein(?:e|en)? (?:lust|bedarf|interesse|zeit)|auf keinen fall|vergiss (?:es|das)|lass (?:es|das)(?! uns)|abbrechen|abbruch|stopp)\\b|(?<!warum )(?<!wieso )(?<!weshalb )(?<!denn )\\bnicht\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:abbrech\\w*|brich\\w*(?:\\W+\\w+){0,2}?\\W+ab|abbruch|stopp?(?:en)?|aufh(?:ö|oe|o)r\\w*|h(?:ö|oe|o)r\\w* auf|beende\\w*|schluss|vergiss (?:es|das)|lass (?:es|das|gut) sein)\\b|^\\W*halt\\W*$"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:wiederhol\\w*|nochmal|nochmals|noch ?mal|noch einmal|(?:wie|was) war|wie lautet|wie hei(?:ß|ss|s)t|passwort\\w*|kennwort|w[\\s-]?lan[\\s-]?name|netzwerkname|netzname|name des (?:w[\\s-]?lans?|netzwerks|netzes)|sag (?:das|es)|wie bitte|nicht verstanden|langsamer)\\b"
