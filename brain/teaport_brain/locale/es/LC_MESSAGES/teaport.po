# teaport — Spanish strings for what the brain says and shows without the LLM
# (Wi-Fi setup). Source: English msgids in wifi_voice.py, wifi_setup.py and wifi.py.
# Edit here (any PO editor), then: python -m teaport_brain.i18n  (recompiles the .mo).
#
# Contexts: "digit" — how a digit is said; "spell" — symbol names, the separator
# between spelled characters, and how an uppercase letter is said; "pattern" — a
# Python regex (searched, case-insensitive) for the user's words meaning start / yes /
# no / cancel / repeat. English phrases are always understood as well.
# Placeholders like {network} must be kept as they are.
#
# Translated by a model, reviewed by a second model (LQA, 2026-10-07). A native speaker's review is still recommended.
msgid ""
msgstr ""
"Project-Id-Version: teaport\n"
"PO-Revision-Date: 2026-10-07 00:00+0000\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: es\n"

msgid "Do you want to set up Wi-Fi? I'll go into setup mode and be offline for a few minutes while you do it on your phone. Say yes or no."
msgstr "¿Quieres configurar el wifi? Entraré en modo de configuración y me quedaré sin conexión unos minutos mientras lo haces desde tu teléfono. Di sí o no."

msgid "I'm already in setup mode."
msgstr "Ya estoy en modo de configuración."

msgid "Okay. Give me a moment to look for networks."
msgstr "Muy bien. Dame un momento para buscar redes."

msgid "I'm in setup mode."
msgstr "Estoy en modo de configuración."

msgid "Sorry, I couldn't go into setup mode."
msgstr "Lo siento, no pude entrar en modo de configuración."

msgid "Okay, I've left setup mode and put things back as they were."
msgstr "De acuerdo. Salí del modo de configuración y dejé todo como estaba."

msgid "Okay, I've cancelled that. Everything is as it was."
msgstr "De acuerdo, lo he cancelado. Todo está como estaba."

msgid "Setup mode was turned off. Everything is as it was."
msgstr "Se desactivó el modo de configuración. Todo está como estaba."

msgid "One moment, I'm getting setup mode ready. Say cancel to stop."
msgstr "Un momento, estoy preparando el modo de configuración. Di cancela para detenerlo."

msgid "I couldn't stop yet. Say cancel again in a moment."
msgstr "Todavía no pude detenerlo. Vuelve a decir cancela en un momento."

msgid "I couldn't go into setup mode. Please try again in a moment."
msgstr "No pude entrar en modo de configuración. Inténtalo de nuevo en un momento."

msgid "I'm still in setup mode, waiting for you."
msgstr "Sigo en modo de configuración, esperándote."

msgid "That didn't work: {reason}."
msgstr "No funcionó: {reason}."

msgid "Got it. I'm joining {network}. Switch your phone back to it."
msgstr "Entendido. Me estoy conectando a {network}. Vuelve a conectar tu teléfono a esa red."

msgid "I'm connected to {network}, and I'm online again."
msgstr "Listo, ya me conecté a {network} y vuelvo a tener internet."

msgid "Nothing connected in time, so I've left setup mode and put things back as they were."
msgstr "No se conectó nada a tiempo, así que salí del modo de configuración y dejé todo como estaba."

msgid "I've left setup mode: {reason}."
msgstr "Salí del modo de configuración: {reason}."

msgid "Sorry, I couldn't go into setup mode: {reason}."
msgstr "Lo siento, no pude entrar en modo de configuración: {reason}."

msgid "your network"
msgstr "tu red"

msgid "something went wrong"
msgstr "algo salió mal"

msgid "Okay, never mind."
msgstr "Está bien, lo dejamos."

msgid "Say yes to go into setup mode, or no."
msgstr "Di sí para entrar en modo de configuración, o no."

msgid "I'm in setup mode. Say repeat to hear the details, or cancel to leave setup mode."
msgstr "Estoy en modo de configuración. Di repite para escuchar los datos, o cancela para salir del modo de configuración."

msgid "On your phone, join the Wi-Fi network {ssid}. The password is {password}. Then open your browser, go to {url}, and pick your Wi-Fi."
msgstr "En tu teléfono, conéctate a la red wifi {ssid}. La contraseña es {password}. Luego abre tu navegador, ve a {url} y elige tu red wifi."

msgid "On your phone, join the Wi-Fi network shown on my screen, using the password shown there. Then, in your phone's browser, go to the address on my screen and pick your Wi-Fi. Say repeat if you'd like me to read the details."
msgstr "En tu teléfono, conéctate a la red wifi que aparece en mi pantalla, con la contraseña que se muestra allí. Luego, en el navegador de tu teléfono, ve a la dirección de mi pantalla y elige tu red wifi. Di repite si quieres que te lea los datos."

msgid "Scan the code on my screen with your phone's camera to join my setup network. Then, in your phone's browser, go to the address on my screen and pick your Wi-Fi. Say repeat if you'd like me to read the details."
msgstr "Escanea el código de mi pantalla con la cámara de tu teléfono para conectarte a mi red de configuración. Luego, en el navegador de tu teléfono, ve a la dirección de mi pantalla y elige tu red wifi. Di repite si quieres que te lea los datos."

msgid "the saved settings for it did not work"
msgstr "los datos guardados de esa red ya no sirven"

msgid "the password did not work"
msgstr "la red rechazó la contraseña"

msgid "the network was not found"
msgstr "no se encontró la red"

msgid "it would not connect"
msgstr "la conexión falló"

msgid "it joined but there is no internet through it"
msgstr "se conectó, pero esa red no tiene acceso a internet"

msgid "this box has no Wi-Fi device"
msgstr "este dispositivo no tiene wifi"

msgid "the setup network would not start"
msgstr "no se pudo crear la red de configuración"

msgid "open"
msgstr "abierta"

msgid "Connect Teaport to Wi-Fi"
msgstr "Conectar Teaport a una red Wi-Fi"

msgid "Connect to Wi-Fi"
msgstr "Conectarse a una red Wi-Fi"

msgid "Pick your network and type its password. Teaport will leave this setup network and join yours, and say out loud whether that worked."
msgstr "Elige tu red y escribe su contraseña. Teaport saldrá de esta red de configuración, se conectará a la tuya y te dirá en voz alta si lo logró."

msgid "No networks found — use Other."
msgstr "No se encontraron redes. Usa “Otra red”."

msgid "Other (hidden) network"
msgstr "Otra red (oculta)"

msgid "Network name"
msgstr "Nombre de la red"

msgid "Password"
msgstr "Contraseña"

msgid "Show password"
msgstr "Mostrar contraseña"

msgid "Connect"
msgstr "Conectar"

msgid "Teaport is joining"
msgstr "Teaport se está conectando"

msgid "Joining {network}…"
msgstr "Conectando a {network}…"

msgid "Teaport is leaving this setup network now. Switch your phone back to {network}. Teaport will say out loud whether it connected; if it could not, the setup network comes back and you can try again."
msgstr "Teaport está saliendo ahora de esta red de configuración. Vuelve a conectar tu teléfono a {network}. Teaport te dirá en voz alta si logró conectarse; si no lo logra, la red de configuración volverá a aparecer y podrás intentarlo de nuevo."

msgid "Could not join {network}: {reason}. Try again."
msgstr "No se pudo conectar a {network}: {reason}. Inténtalo de nuevo."

msgid "Pick a network, or type its name under Other."
msgstr "Elige una red o escribe su nombre en “Otra red”."

msgid "That network name is too long."
msgstr "Ese nombre de red es demasiado largo."

msgid "Wi-Fi passwords are 8 to 63 characters."
msgstr "La contraseña de Wi-Fi debe tener entre 8 y 63 caracteres."

