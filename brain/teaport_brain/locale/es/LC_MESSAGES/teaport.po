# the user means: start
msgctxt "pattern"
msgid "\\b(?:set(?:s|ting)?[- ]?up|(?:re)?configur(?:e|es|ing)|(?:re)?connect(?:s|ing)?|join(?:s|ing)?|chang(?:e|es|ing)|switch(?:es|ing)?)\\b(?: (?:the|a|my|your|our|this|that|to|onto|new|another|different|other|home|guest|me|us|it|yourself|the box|back)){0,4} ?(?:(?:wi[-‐‑ ]?fi|wireless)(?: (?:network|connection))?|network|hotspot)s?(?= *(?:[.,!?;:…]|$)| on \\w| (?:and|so|but|because|since|then|now|please|again|for|to|at|in|with|from|here|there|too|first|today|tonight|called|named|instead|as|if|when|or|that|which|i|we|ok|okay|thanks|thank|right|quickly)\\b)|\\bwi[-‐‑ ]?fi (?:set[- ]?up|setup)\\b"
msgstr "(?<!no )(?<!no estoy )(?<!no estás )(?<!no está )\\b(?:(?:re)?config[uú]r(?:a|ar|e|o|emos|amos|[aá]ndo)(?:lo|la|me|nos|te)?|configuraci[oó]n|con[eé]ct(?:a|ar|e|o|emos|ate|ame|ese|arte|arse|arme|arnos|[aá]ndo(?:me|te|se|nos)?)|c[aá]mbi(?:a|ar|e|o|emos|ate|arte|arse|arnos|ando))\\b(?:[\\s,]+(?:el|la|los|las|al|a|de|del|un|una|mi|tu|su|otra|otro|nueva|nuevo|red|me|te|se|nos)\\b){0,4}[\\s,]+(?:(?:wi|wai|uai|g[uü]i)[- ]?fa?i|red(?:es)? inal[aá]mbricas?)\\b|\\b(?:(?:wi|wai|uai|g[uü]i)[- ]?fa?i|red(?:es)? inal[aá]mbricas?)\\b.{0,30}?\\b(?:re)?config[uú]r(?:a|ar|e|emos)(?:lo|la)?\\b"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "^(?!.*\\b(?:(?<!por qu[eé] )(?<!porqu[eé] )(?<!c[oó]mo )no(?! hay problema| te preocupes)|nop|nel)\\b).*?\\b(?:sí|si(?!\\s+\\w)|claro|vale|dale|venga|de acuerdo|adelante|por favor|porfa|por supuesto|ok|okey|okay|hazlo|correcto|perfecto|exacto|afirmativo|órale|orale|quiero(?! saber)|empieza|empecemos|comienza|est[aá] bien|muy bien|por qu[eé] no|c[oó]mo no|no hay problema|sin problema|no te preocupes)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b(?:(?<!por qu[eé] )(?<!porqu[eé] )(?<!c[oó]mo )no(?! hay problema| te preocupes)|nop|nel|nah|negativo|ni hablar|para nada|olv[ií]dalo|d[eé]jalo|cancel\\w*|mejor (?:despu[eé]s|luego|otro d[ií]a)|m[aá]s tarde)\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:cancel\\w*|det[eé]n(?:te|lo|la|er|ga)?|basta|olv[ií]dalo|d[eé]jalo|ya no quiero|no quiero (?:seguir|continuar|configurar\\w*)|p[aá]ra(?:lo|la)? ya|p[aá]ralo|p[aá]rala|sal(?:ir|te)? de (?:la |el |esta |este )?(?:configuraci[oó]n|modo|wi[- ]?fi)|abort\\w*)\\b|^\\W*(?:para\\W*)+$"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:rep[ií]t\\w*|repetir\\w*|otra vez|de nuevo|una vez m[aá]s|cu[aá]l (?:era|es)|qu[eé] (?:era|es|dijiste|has dicho)|c[oó]mo (?:era|es|dijiste|se llama)|contrase[nñ]a|clave|nombre de la red|no (?:te )?(?:entend[ií]|escuch[eé]|o[ií])|m[aá]s despacio)\\b|^\\W*(?:perd[oó]n|c[oó]mo|qu[eé])\\W*$"

# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "Idioma"

# The session arbiter (session_arbiter.py): one conversation at a time.
msgid "Sorry, I'm on a phone call right now. Please try again when it's over."
msgstr "Lo siento, ahora mismo estoy en una llamada. Inténtalo de nuevo cuando termine."

msgid "Sorry, I'm in another conversation right now. Please try again in a little while."
msgstr "Lo siento, ahora mismo estoy en otra conversación. Inténtalo de nuevo en un rato."

msgid "Sorry, a phone call is coming in and I have to take it. We can talk again when it's over."
msgstr "Lo siento, está entrando una llamada y tengo que atenderla. Podemos seguir hablando cuando termine."

# A phone call during a conversation (session_arbiter.py, call_prompt.py): the agent asks,
# steps away, and comes back.
#. Translators: {caller} is a name or a phone number, as the caller ID gives it.
msgid "Someone's calling me — {caller}. Should I step away for a moment?"
msgstr "Alguien me está llamando — {caller}. ¿Contesto un momento?"

msgid "Someone's calling me. Should I step away for a moment?"
msgstr "Alguien me está llamando. ¿Contesto un momento?"

msgid "I'll take the call — back in a moment."
msgstr "Voy a contestar — vuelvo enseguida."

msgid "Sorry about that — where were we?"
msgstr "Perdona la interrupción — ¿por dónde íbamos?"

msgid "Sorry, I couldn't get an answer just then. Could you try again?"
msgstr "Lo siento, no pude obtener una respuesta en ese momento. ¿Puedes intentarlo de nuevo?"

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. It can be fixed on my settings page."
msgstr "Lo siento, ahora mismo no puedo responder: la cuenta que uso para mis respuestas necesita atención, y volver a intentarlo no servirá. Se puede arreglar en mi página de ajustes."

msgid "I still can't answer until my account is sorted out."
msgstr "Sigo sin poder responder hasta que se resuelva lo de mi cuenta."

msgid "Sorry, I couldn't get an answer just then."
msgstr "Lo siento, no pude obtener una respuesta en ese momento."

# The call recording notice (call_recording.py, #114).
msgid "This call is being recorded."
msgstr "Esta llamada está siendo grabada."

# No model at all (llm_error_speaker.py, #277).
msgid "I can't answer questions yet, because the account I use for my answers isn't set up."
msgstr "Todavía no puedo responder preguntas, porque la cuenta que uso para mis respuestas no está configurada."

msgid "I can't answer questions until I'm set up. Say \"set up Wi-Fi\" to get me online."
msgstr "No puedo responder preguntas hasta que me configuren. Di «configura el wifi» para conectarme a internet."

msgid "Sorry, I can't take calls right now. Please try again later."
msgstr "Lo siento, ahora mismo no puedo atender llamadas. Inténtalo de nuevo más tarde."

msgid "I'm ready now. Please ask me again."
msgstr "Ya estoy listo. Pregúntame otra vez, por favor."

msgid "I'm ready now. Please start a new conversation with me."
msgstr "Ya estoy listo. Empieza una nueva conversación conmigo, por favor."

# The first-boot setup (wifi_voice.py, first_boot.py, #278).
msgid "Hi, I'm Teaport. Let's get me online. Give me a moment to look for networks."
msgstr "Hola, soy Teaport. Vamos a conectarme a internet. Dame un momento para buscar redes."

msgid "You can say \"set up Wi-Fi\" any time to try again."
msgstr "Puedes decir «configura el wifi» en cualquier momento para volver a intentarlo."

msgid "I'm online now, so I've left setup mode."
msgstr "Ya tengo internet, así que salí del modo de configuración."

# The sessions' own lines: busy / engine-unavailable, consult progress and tool acks (tools.py, agent_session.py).

msgid "Sorry, the voice assistant is busy with another session right now — please try again in a moment."
msgstr "Lo siento, el asistente de voz está ocupado con otra sesión ahora mismo. Inténtalo de nuevo en un momento."

msgid "Sorry, I can't hear you right now — my speech recognition isn't available. Please try again in a moment."
msgstr "Lo siento, ahora mismo no te oigo: el reconocimiento de voz no está disponible. Inténtalo de nuevo en un momento."

msgid "Still working on that — {topic}."
msgstr "Sigo trabajando en eso — {topic}."

msgid "Still working on it."
msgstr "Sigo trabajando en ello."

msgid "Almost there — {topic}."
msgstr "Ya casi está — {topic}."

msgid "Almost there — hang tight."
msgstr "Ya casi está, espera un momento."

msgid "Looking up {q}."
msgstr "Buscando {q}."

msgid "Opening that page."
msgstr "Abriendo la página."

msgid "I'll work on that — give me a moment."
msgstr "Voy a trabajar en ello, un momento."

msgid "One moment, let me set that up."
msgstr "Un momento, déjame prepararlo."

# Settings from the phone and the AI account (settings_access.py, ai_account.py, config_ui.py, wifi_setup.py, #279).
msgid "AI account"
msgstr "Cuenta de IA"

msgid "AI account (optional)"
msgstr "Cuenta de IA (opcional)"

msgid "An account is connected."
msgstr "Hay una cuenta conectada."

msgid "Ask Teaport for a new one: say \"open my settings\"."
msgstr "Pídele uno nuevo a Teaport: di «abre los ajustes»."

msgid "Checking the key…"
msgstr "Comprobando la clave…"

msgid "Code"
msgstr "Código"

msgid "Continue"
msgstr "Continuar"

msgid "Enter the code Teaport gave you. It works once."
msgstr "Escribe el código que te dio Teaport. Solo sirve una vez."

msgid "I can't answer questions yet, because the account I use for my answers isn't set up. Say \"open my settings\" to set it up."
msgstr "Todavía no puedo responder preguntas, porque la cuenta que uso para mis respuestas no está configurada. Di «abre los ajustes» para configurarla."

msgid "I couldn't use the AI account key you entered, so I didn't save it. Say \"open my settings\" to try again."
msgstr "No pude usar la clave de la cuenta de IA que escribiste, así que no la guardé. Di «abre los ajustes» para intentarlo de nuevo."

msgid "I need to be online for that. Say \"set up Wi-Fi\" to get me online."
msgstr "Para eso necesito internet. Di «configura el wifi» para conectarme a internet."

msgid "I've put a code on my screen. Scan it with your phone's camera, then tap the link that appears to get to my settings."
msgstr "Puse un código en mi pantalla. Escanéalo con la cámara de tu teléfono y luego toca el enlace que aparece para entrar a mis ajustes."

msgid "If your phone warns that the connection is not private, install {certificate} first, then ask Teaport for a new code."
msgstr "Si tu teléfono avisa de que la conexión no es privada, instala primero {certificate} y luego pídele a Teaport un código nuevo."

msgid "If your phone warns that this page is not private, here is how to trust Teaport."
msgstr "Si tu teléfono avisa de que esta página no es privada, aquí se explica cómo confiar en Teaport."

msgid "In your phone's browser, go to {address}, and enter the code {code}. It works once, for the next five minutes."
msgstr "En el navegador de tu teléfono, ve a {address} y escribe el código {code}. Solo sirve una vez, durante los próximos cinco minutos."

msgid "Leave this empty to keep the account Teaport has now. To use your own OpenRouter account, paste its key here. Teaport checks the key once it's online, and says out loud whether it worked."
msgstr "Deja esto vacío para seguir con la cuenta que Teaport tiene ahora. Para usar tu propia cuenta de OpenRouter, pega aquí su clave. Teaport comprueba la clave en cuanto tiene internet y te dice en voz alta si funcionó."

msgid "No account is connected yet."
msgstr "Todavía no hay ninguna cuenta conectada."

msgid "OpenRouter key"
msgstr "Clave de OpenRouter"

msgid "Save anyway"
msgstr "Guardar de todos modos"

msgid "Settings"
msgstr "Ajustes"

msgid "Show advanced"
msgstr "Mostrar opciones avanzadas"

msgid "Sorry, my settings can't be reached from a phone on this box."
msgstr "Lo siento, en este dispositivo no se puede entrar a mis ajustes desde un teléfono."

msgid "Tap Continue to get to Teaport's settings on this phone. The code works once."
msgstr "Toca Continuar para entrar a los ajustes de Teaport en este teléfono. El código solo sirve una vez."

msgid "Teaport couldn't check this key: {reason}."
msgstr "Teaport no pudo comprobar esta clave: {reason}."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, paste a key from your OpenRouter account."
msgstr "Teaport usa una cuenta de OpenRouter para sus respuestas. Para usar la tuya, pega una clave de tu cuenta de OpenRouter."

msgid "Teaport's certificate"
msgstr "el certificado de Teaport"

msgid "Test and save"
msgstr "Comprobar y guardar"

msgid "That code didn't work. Check it, or ask Teaport for a new one."
msgstr "Ese código no funcionó. Revísalo o pídele uno nuevo a Teaport."

msgid "The key works, and it's saved. Teaport uses it from your next conversation."
msgstr "La clave funciona y ya está guardada. Teaport la usará a partir de tu próxima conversación."

msgid "This code has expired"
msgstr "Este código expiró"

msgid "This code was already used"
msgstr "Este código ya se usó"

msgid "This key didn't work: {reason}."
msgstr "Esta clave no funcionó: {reason}."

msgid "Your AI account is connected."
msgstr "Tu cuenta de IA está conectada."

msgid "no AI service is set up on this box"
msgstr "este dispositivo no tiene ningún servicio de IA configurado"

msgctxt "pattern"
msgid "^\\W*(?:(?:um+|uh+|uhm|er+m?|eh|hm+|ok|okay|hey|so|now|please|teaport|well|alright|right)\\W+){0,3}(?:(?:can|could|would|will) you(?: please)? )?(?:open|show|bring up|pull up|go to|get)(?: up)?(?: me)?(?: to)? (?:(?:my|your|the|teaport's|teaport) )?settings(?:[\\s,]+(?:page|please|now|for me|thanks a lot|thank you (?:so |very )?much|thanks|thank you|cheers|ok(?:ay)?|teaport)\\b)*[\\s.,!?;:…]*$"
msgstr "^\\W*(?:(?:eh|em+|ehm|este|mm+|teaport|oye|ok|okay|vale|bueno|entonces|y|por favor|porfa)\\W+){0,3}(?:(?:me |nos )?(?:puedes|podrías|podrias|puede|podría|podria|podés)(?: (?:me|nos))? )?(?:[aá]br(?:e|a|ir)(?:me|nos)?|mu[eé]str(?:a|e|ar)(?:me|nos)?|mostrar(?:me|nos)?|ens[eé][nñ](?:a|e|ar)(?:me|nos)?|ll[eé]v(?:a|e)(?:me|nos)|ve|vamos|ir|entra|entrar|pon(?:me)?)(?: (?:a|al|a la|en|en la))? (?:(?:mis|tus|sus|los|las|la|el|mi|tu|su) )?(?:(?:p[aá]gina|men[uú]|pantalla) (?:de )?(?:(?:mis|tus|los|la) )?)?(?:ajustes|configuraci[oó]n(?:es)?|preferencias)(?:[\\s,،]+(?:teaport|muchas gracias|gracias|por favor|porfa|ahora|ya|de teaport)\\b)*[\\s.,!?;:…]*$"

msgctxt "spell"
msgid "slash"
msgstr "barra"

msgid "that doesn't look like a key"
msgstr "eso no parece una clave"

msgid "the AI service didn't answer"
msgstr "el servicio de IA no respondió"

msgid "the AI service refused this key"
msgstr "el servicio de IA rechazó esta clave"

msgid "the key is empty"
msgstr "la clave está vacía"

msgid "this account has no credit left"
msgstr "a esta cuenta no le queda crédito"

msgid "this box's key is set by its installer, so it can't be changed here"
msgstr "la clave de este dispositivo la puso quien lo instaló, así que no se puede cambiar aquí"

# A key the agent (OpenClaw) did not take: nothing changed (ai_account.save_key, #281).
msgid "Teaport couldn't switch everything over to this key, so it kept the one it had. Try again in a minute."
msgstr "Teaport no pudo pasar todo a esta clave, así que se quedó con la que tenía. Vuelve a intentarlo en un minuto."

# One OpenClaw may have taken all the same: a mismatch is recorded (ai_account.save_key, #281).
msgid "Teaport couldn't finish switching to this key. Try saving it again."
msgstr "Teaport no pudo terminar de pasar a esta clave. Vuelve a guardarla."

# The same without its pointer, where "open my settings" is not heard (wifi_voice.py).
msgid "I couldn't use the AI account key you entered, so I didn't save it."
msgstr "No pude usar la clave de la cuenta de IA que escribiste, así que no la guardé."

# The trial credit (credit.py, llm_error_speaker.py, #280).
msgid "Quick note: I've used half of my trial credit. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "Un apunte rápido: ya usé la mitad de mi crédito de prueba. Cuando tengas un momento, di «abre los ajustes» para conectar tu propia cuenta."

msgid "Quick note: my trial credit is almost used up. When you have a minute, say \"open my settings\" to connect your own account."
msgstr "Un apunte rápido: mi crédito de prueba está casi agotado. Cuando tengas un momento, di «abre los ajustes» para conectar tu propia cuenta."

msgid "My trial credit has run out, so I can't answer questions until you connect your own account. Say \"open my settings\" to do that."
msgstr "Se me acabó el crédito de prueba, así que no puedo responder preguntas hasta que conectes tu propia cuenta. Di «abre los ajustes» para hacerlo."

msgid "My trial credit has run out, so I can't answer questions until your own account is connected."
msgstr "Se me acabó el crédito de prueba, así que no puedo responder preguntas hasta que se conecte tu propia cuenta."

msgid "Teaport is using its included trial credit."
msgstr "Teaport está usando el crédito de prueba incluido."

msgid "Half of the trial credit is used. Connect your own account to keep Teaport answering."
msgstr "Ya se usó la mitad del crédito de prueba. Conecta tu propia cuenta para que Teaport siga respondiendo."

msgid "The trial credit is almost used up: about {amount} left. Connect your own account to keep Teaport answering."
msgstr "El crédito de prueba está casi agotado: quedan unos {amount}. Conecta tu propia cuenta para que Teaport siga respondiendo."

msgid "The trial credit has run out. Connect your own account so Teaport can answer again."
msgstr "El crédito de prueba se agotó. Conecta tu propia cuenta para que Teaport pueda volver a responder."

msgid "Back to settings"
msgstr "Volver a los ajustes"

msgid "Code from OpenRouter"
msgstr "Código de OpenRouter"

msgid "Connect your OpenRouter account"
msgstr "Conecta tu cuenta de OpenRouter"

msgid "Connecting…"
msgstr "Conectando…"

msgid "Finish"
msgstr "Terminar"


msgid "OpenRouter didn't accept the sign-in"
msgstr "OpenRouter no aceptó el inicio de sesión"

msgid "OpenRouter didn't connect the account. You can try again from Teaport's settings, or paste a key there instead."
msgstr "OpenRouter no conectó la cuenta. Puedes volver a intentarlo desde los ajustes de Teaport o pegar allí una clave."


msgid "Tap Finish to connect your OpenRouter account to Teaport."
msgstr "Toca Terminar para conectar tu cuenta de OpenRouter a Teaport."

msgid "Teaport couldn't connect your OpenRouter account"
msgstr "Teaport no pudo conectar tu cuenta de OpenRouter"

msgid "Teaport couldn't connect your OpenRouter account: {reason}. You can try again from Teaport's settings, or paste a key there instead."
msgstr "Teaport no pudo conectar tu cuenta de OpenRouter: {reason}. Puedes volver a intentarlo desde los ajustes de Teaport o pegar allí una clave."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, connect it here, or paste a key from it."
msgstr "Teaport usa una cuenta de OpenRouter para sus respuestas. Para usar la tuya, conéctala aquí o pega una clave de ella."

msgid "Teaport uses your OpenRouter account from your next conversation."
msgstr "Teaport usará tu cuenta de OpenRouter a partir de tu próxima conversación."

msgid "Teaport's settings have closed on this phone. Say \"open my settings\", then connect again."
msgstr "Los ajustes de Teaport se cerraron en este teléfono. Di «abre los ajustes» y vuelve a conectar la cuenta."

msgid "This connection has expired. Go back to Teaport's settings and connect again."
msgstr "Esta conexión caducó. Vuelve a los ajustes de Teaport y conecta la cuenta de nuevo."



msgid "Your OpenRouter account is connected"
msgstr "Tu cuenta de OpenRouter está conectada"

msgid "Connecting your OpenRouter account to Teaport"
msgstr "Conectando tu cuenta de OpenRouter a Teaport"

msgid "Continue to Teaport"
msgstr "Continuar a Teaport"

msgid "Copied"
msgstr "Copiado"

msgid "Copy code"
msgstr "Copiar código"

msgid "If OpenRouter showed you a code, paste it here."
msgstr "Si OpenRouter te mostró un código, pégalo aquí."

msgid "If that doesn't work: copy this code, open Teaport's settings on this phone, and paste it into {field}. It works once, in the next ten minutes."
msgstr "Si eso no funciona: copia este código, abre los ajustes de Teaport en este teléfono y pégalo en {field}. Funciona una vez, en los próximos diez minutos."

msgid "If your phone warns that the connection isn't private, it's the same warning you saw when you opened Teaport's settings."
msgstr "Si tu teléfono avisa de que la conexión no es privada, es el mismo aviso que viste al abrir los ajustes de Teaport."

msgid "Now let's connect your OpenRouter account. I've put a code on my screen. Scan it with your phone's camera, tap the link that appears, and follow the steps on your phone."
msgstr "Ahora vamos a conectar tu cuenta de OpenRouter. He puesto un código en mi pantalla. Escanéalo con la cámara del teléfono, toca el enlace que aparece y sigue los pasos en tu teléfono."

msgid "Now let's connect your OpenRouter account. In your phone's browser, go to {address}, enter the code {code}, and follow the steps there. The code works once, for the next five minutes."
msgstr "Ahora vamos a conectar tu cuenta de OpenRouter. En el navegador del teléfono, ve a {address}, escribe el código {code} y sigue los pasos. El código funciona una vez, durante los próximos cinco minutos."

msgid "Save it again"
msgstr "Guardarla de nuevo"

msgid "Teaport couldn't save the key"
msgstr "Teaport no pudo guardar la clave"

msgid "Teaport no longer has that key. Tap Connect your OpenRouter account to sign in again."
msgstr "Teaport ya no tiene esa clave. Toca Conecta tu cuenta de OpenRouter para iniciar sesión de nuevo."

msgid "Teaport still has the key from your OpenRouter sign-in. Tap Save it again to try once more."
msgstr "Teaport todavía tiene la clave de tu inicio de sesión en OpenRouter. Toca Guardarla de nuevo para intentarlo otra vez."

msgid "That doesn't look like a code from OpenRouter. Check it and paste it again."
msgstr "Eso no parece un código de OpenRouter. Revísalo y pégalo de nuevo."

msgid "There's no sign-in waiting for a code. Tap Connect your OpenRouter account to start a new one."
msgstr "No hay ningún inicio de sesión esperando un código. Toca Conecta tu cuenta de OpenRouter para empezar uno nuevo."

msgid "This link doesn't lead to a Teaport on a home network, so this page won't go on with it."
msgstr "Este enlace no lleva a un Teaport en una red doméstica, así que esta página no seguirá con él."

msgid "To connect your OpenRouter account by signing in instead, leave this empty and finish setting up Wi-Fi. Then Teaport shows you how, or you can say \"open my settings\"."
msgstr "Para conectar tu cuenta de OpenRouter iniciando sesión, deja esto vacío y termina de configurar el wifi. Después Teaport te muestra cómo, o puedes decir «abre los ajustes»."

msgid "You sign in to OpenRouter on this phone and approve Teaport. OpenRouter then shows a code: copy it, come back to Teaport's settings, and paste it into Code from OpenRouter."
msgstr "Inicias sesión en OpenRouter en este teléfono y apruebas a Teaport. Luego OpenRouter muestra un código: cópialo, vuelve a los ajustes de Teaport y pégalo en Código de OpenRouter."

msgid "You sign in to OpenRouter on this phone and approve Teaport. Then a Teaport page asks you to tap Finish."
msgstr "Inicias sesión en OpenRouter en este teléfono y apruebas a Teaport. Después, una página de Teaport te pide que toques Terminar."

msgid "Your phone needs to be on the same Wi-Fi as Teaport. If it doesn't go on by itself, tap the button."
msgstr "Tu teléfono tiene que estar en el mismo wifi que Teaport. Si no sigue solo, toca el botón."

msgid "Your OpenRouter account has no credit yet, so Teaport can't answer until you add some at openrouter.ai/settings/credits."
msgstr "Tu cuenta de OpenRouter todavía no tiene saldo, así que Teaport no puede responder hasta que añadas saldo en openrouter.ai/settings/credits."

msgid "Your AI account is connected, but it has no credit yet. Add some on OpenRouter's website, and then I can answer."
msgstr "Tu cuenta de IA está conectada, pero todavía no tiene saldo. Añade saldo en la web de OpenRouter y entonces podré responder."

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. Say \"open my settings\" to fix it."
msgstr "Lo siento, ahora mismo no puedo responder: la cuenta que uso para mis respuestas necesita atención, y volver a intentarlo no servirá. Di «abre los ajustes» para arreglarlo."
