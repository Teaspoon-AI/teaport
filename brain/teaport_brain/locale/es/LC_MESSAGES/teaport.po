# teaport — Spanish strings for what the brain says and shows without the LLM
# (Wi-Fi setup). Source: English msgids in wifi_voice.py, wifi_setup.py and wifi.py.
# Edit here (any PO editor), then: python -m teaport_brain.i18n  (recompiles the .mo).
#
# Contexts: "digit" — how a digit is said; "spell" — symbol names, the separator
# between spelled characters, and how an uppercase letter is said; "pattern" — a
# Python regex (searched, case-insensitive) for the user's words meaning start / yes /
# no / cancel / repeat. English phrases are always understood as well.
# Placeholders like {network} must be kept as they are.
#
# Machine-drafted (2026-10-07). A native speaker's review is welcome.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: es\n"

msgid "Do you want to set up Wi-Fi? I'll go offline for a few minutes while you do it on your phone. Say yes or no."
msgstr "¿Quieres configurar el wifi? Me quedaré sin conexión unos minutos mientras lo haces desde tu teléfono. Di sí o no."

msgid "Wi-Fi setup is already running."
msgstr "La configuración del wifi ya está en marcha."

msgid "Okay. Give me a moment to look for networks."
msgstr "Vale. Dame un momento para buscar redes."

msgid "Sorry, I couldn't start Wi-Fi setup on this box."
msgstr "Lo siento, no pude iniciar la configuración del wifi en este equipo."

msgid "Okay, I've stopped Wi-Fi setup and put things back as they were."
msgstr "Vale, he detenido la configuración del wifi y lo he dejado todo como estaba."

msgid "Wi-Fi setup didn't start. Please try again in a moment."
msgstr "La configuración del wifi no se inició. Inténtalo de nuevo en un momento."

msgid "I'm still waiting for you on the setup page."
msgstr "Sigo esperándote en la página de configuración."

msgid "That didn't work: {reason}."
msgstr "No funcionó: {reason}."

msgid "Got it. I'm joining {network}. Switch your phone back to it."
msgstr "Entendido. Me estoy conectando a {network}. Vuelve a conectar tu teléfono a esa red."

msgid "I'm connected to {network}, and I'm online again."
msgstr "Estoy conectado a {network} y vuelvo a tener internet."

msgid "Wi-Fi setup timed out, so I've put things back as they were."
msgstr "Se agotó el tiempo de la configuración del wifi, así que lo he dejado todo como estaba."

msgid "Wi-Fi setup stopped: {reason}."
msgstr "La configuración del wifi se detuvo: {reason}."

msgid "your network"
msgstr "tu red"

msgid "something went wrong"
msgstr "algo salió mal"

msgid "Okay, never mind."
msgstr "Vale, olvídalo."

msgid "Say yes to start Wi-Fi setup, or no."
msgstr "Di sí para empezar a configurar el wifi, o no."

msgid "I'm in Wi-Fi setup. Say repeat to hear the details again, or cancel to stop."
msgstr "Estoy configurando el wifi. Di repite para volver a oír los datos, o cancela para parar."

msgid "On your phone, join the Wi-Fi network {ssid}. The password is {password}. A setup page should open by itself. If it doesn't, go to {url}."
msgstr "En tu teléfono, conéctate a la red wifi {ssid}. La contraseña es {password}. Debería abrirse sola una página de configuración. Si no, ve a {url}."

msgid "the saved settings for it did not work"
msgstr "la configuración guardada para esa red no funcionó"

msgid "the password did not work"
msgstr "la contraseña no funcionó"

msgid "the network was not found"
msgstr "no se encontró la red"

msgid "it would not connect"
msgstr "no se pudo conectar"

msgid "it joined but there is no internet through it"
msgstr "se conectó, pero no hay internet a través de esa red"

msgid "this box has no Wi-Fi device"
msgstr "este equipo no tiene wifi"

msgid "the setup network would not start"
msgstr "la red de configuración no arrancó"

msgid "the setup page could not start"
msgstr "la página de configuración no arrancó"

msgid "open"
msgstr "abierta"

msgid "Teaport Wi-Fi setup"
msgstr "Configuración wifi de Teaport"

msgid "Connect to Wi-Fi"
msgstr "Conectar al wifi"

msgid "Pick your network and type its password. Teaport will leave this setup network and join yours, and say out loud whether that worked."
msgstr "Elige tu red y escribe su contraseña. Teaport dejará esta red de configuración, se conectará a la tuya y dirá en voz alta si funcionó."

msgid "No networks found — use Other."
msgstr "No se encontraron redes; usa Otra."

msgid "Other (hidden) network"
msgstr "Otra red (oculta)"

msgid "Network name"
msgstr "Nombre de la red"

msgid "Password"
msgstr "Contraseña"

msgid "Show password"
msgstr "Mostrar contraseña"

msgid "Connect"
msgstr "Conectar"

msgid "Teaport is joining"
msgstr "Teaport se está conectando"

msgid "Joining {network}…"
msgstr "Conectando a {network}…"

msgid "Teaport is leaving this setup network now. Switch your phone back to {network}. Teaport will say out loud whether it connected; if it could not, the setup network comes back and you can try again."
msgstr "Teaport está dejando ahora esta red de configuración. Vuelve a conectar tu teléfono a {network}. Teaport dirá en voz alta si se conectó; si no pudo, la red de configuración volverá y podrás intentarlo de nuevo."

msgid "Could not join {network}: {reason}. Try again."
msgstr "No se pudo conectar a {network}: {reason}. Inténtalo de nuevo."

msgid "Pick a network, or type its name under Other."
msgstr "Elige una red o escribe su nombre en Otra."

msgid "That network name is too long."
msgstr "Ese nombre de red es demasiado largo."

msgid "Wi-Fi passwords are 8 to 63 characters."
msgstr "Las contraseñas wifi tienen de 8 a 63 caracteres."

