# the user means: start
msgctxt "pattern"
msgid "\\b(?:set ?up|setup|configure|connect to|join|change|switch)\\b(?: (?:the|a|my|your|to|new|another|different)){0,3} ?wi-?fi\\b|\\bwi-?fi (?:set ?up|setup)\\b"
msgstr "\\b(?:configura\\w*|conecta\\w*|cambia\\w*|pon\\w*)\\b(?: \\w+){0,3} ?wi-?fi\\b|\\bwi-?fi\\b.{0,12}\\bconfigura\\w*"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\b(?:sí|si|claro|vale|dale|de acuerdo|adelante|por favor|ok|okay)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b(?:no|olvídalo|olvidalo|déjalo|dejalo|cancela\\w*)\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:cancela\\w*|para|detente|basta|olvídalo|olvidalo|sal)\\b"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:repite|repítelo|repitelo|otra vez|de nuevo|cuál era|cual era|contraseña|clave|nombre de la red)\\b"
