# the user means: start
msgctxt "pattern"
msgid "\\b(?:set(?:s|ting)?[- ]?up|(?:re)?configur(?:e|es|ing)|(?:re)?connect(?:s|ing)?|join(?:s|ing)?|chang(?:e|es|ing)|switch(?:es|ing)?)\\b(?: (?:the|a|my|your|our|this|that|to|onto|new|another|different|other|home|guest|me|us|it|yourself|the box|back)){0,4} ?(?:(?:wi[-‐‑ ]?fi|wireless)(?: (?:network|connection))?|network|hotspot)s?(?= *(?:[.,!?;:…]|$)| on \\w| (?:and|so|but|because|since|then|now|please|again|for|to|at|in|with|from|here|there|too|first|today|tonight|called|named|instead|as|if|when|or|that|which|i|we|ok|okay|thanks|thank|right|quickly)\\b)|\\bwi[-‐‑ ]?fi (?:set[- ]?up|setup)\\b"
msgstr "\\b(?:re)?(?:configur|param[eèé]tr|connect|branch|chang|r[eéè]gl|install|rejoin|set ?up|setup)(?!ée?s?\\b)[\\w'’-]*(?: \\S+){0,3} ?(?:wi[-‐‑ ]?fi\\b|r[ée]seau sans fil)|\\bwi[-‐‑ ]?fi\\b.{0,20}\\b(?:configur|param[eèé]tr|r[eéè]gl)(?!ée?s?\\b)\\w*"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\b(?:oui|ouais|ouai|ok|okay|o\\.k|d['’ ]?accord|d['’ ]?acc|dac|bien s[uû]r|bien entendu|vas[- ]y|allez[- ]y|allons[- ]y|allez|go|volontiers|carr[ée]ment|absolument|exactement|parfait|[ée]videmment|tout [àa] fait|pourquoi pas|c['’ ]?est parti|je veux bien|faites[- ]le|fais[- ]le|s['’ ]?il (?:te|vous) pla[iî]t|stp|svp|lance\\w*|commence\\w*|d[ée]marre\\w*)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b(?:non|nan|pas maintenant|pas pour (?:l['’ ]?instant|le moment)|plus tard|pas la peine|pas besoin|pas question|pas d['’ ]?accord|surtout pas|certainement pas|absolument pas|je (?:ne )?veux pas|(?:ne )?(?:le )?(?:fais|faites) pas|laisse[zr]? tomber|laisse[zr]? b[ée]ton|oublie[zr]? [çc]a|annule\\w*|arr[eê]te\\w*|stop\\w*)\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:annule\\w*|arr[eê]te\\w*|stop\\w*|laisse[zr]? tomber|laisse[zr]? b[ée]ton|quitte\\w*|sors|sortez|sortir|abandonne\\w*|interromp\\w*)\\b"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "\\b(?:r[ée]p[eèé]te\\w*|redi[st]\\w*|redire|encore|de nouveau|une autre fois|pardon|quoi|comment|quel (?:est|[ée]tait) le|mot de passe|nom du r[ée]seau|(?:pas|rien) compris|rappelle\\w*)\\b"

# The language picker on the setup page (its accessible label).
msgid "Language"
msgstr "Langue"

# The session arbiter (session_arbiter.py): one conversation at a time.
msgid "Sorry, I'm on a phone call right now. Please try again when it's over."
msgstr "Désolé, je suis au téléphone en ce moment. Réessayez quand l'appel sera terminé."

msgid "Sorry, I'm in another conversation right now. Please try again in a little while."
msgstr "Désolé, je suis déjà dans une autre conversation. Réessayez dans un petit moment."

msgid "Sorry, a phone call is coming in and I have to take it. We can talk again when it's over."
msgstr "Désolé, un appel arrive et je dois le prendre. Nous pourrons reparler quand il sera terminé."

# A phone call during a conversation (session_arbiter.py, call_prompt.py): the agent asks,
# steps away, and comes back.
#. Translators: {caller} is a name or a phone number, as the caller ID gives it.
msgid "Someone's calling me — {caller}. Should I step away for a moment?"
msgstr "Quelqu'un m'appelle — {caller}. Je m'absente un instant pour répondre ?"

msgid "Someone's calling me. Should I step away for a moment?"
msgstr "Quelqu'un m'appelle. Je m'absente un instant pour répondre ?"

msgid "I'll take the call — back in a moment."
msgstr "Je prends l'appel — je reviens tout de suite."

msgid "Sorry about that — where were we?"
msgstr "Désolé pour l'interruption — où en étions-nous ?"

msgid "Sorry, I couldn't get an answer just then. Could you try again?"
msgstr "Désolé, je n'ai pas pu obtenir de réponse à l'instant. Pouvez-vous réessayer ?"

msgid "Sorry, I can't answer right now: the account I use for my answers needs attention, and trying again won't help. It can be fixed on my settings page."
msgstr "Désolé, je ne peux pas répondre pour le moment : le compte que j'utilise pour mes réponses a besoin d'attention, et réessayer n'y changera rien. Cela peut se régler sur ma page de réglages."

msgid "I still can't answer until my account is sorted out."
msgstr "Je ne peux toujours pas répondre tant que mon compte n'est pas réglé."

msgid "Sorry, I couldn't get an answer just then."
msgstr "Désolé, je n'ai pas pu obtenir de réponse à l'instant."

# The call recording notice (call_recording.py, #114).
msgid "This call is being recorded."
msgstr "Cet appel est enregistré."

# No model at all (llm_error_speaker.py, #277).
msgid "I can't answer questions yet, because the account I use for my answers isn't set up."
msgstr "Je ne peux pas encore répondre aux questions, car le compte que j'utilise pour mes réponses n'est pas configuré."

msgid "I can't answer questions until I'm set up. Say \"set up Wi-Fi\" to get me online."
msgstr "Je ne peux pas répondre aux questions tant que je ne suis pas configuré. Dites « configure le Wi-Fi » pour me connecter à Internet."

msgid "Sorry, I can't take calls right now. Please try again later."
msgstr "Désolé, je ne peux pas prendre d'appels pour le moment. Réessayez plus tard."

msgid "I'm ready now. Please ask me again."
msgstr "Je suis prêt maintenant. Posez-moi la question à nouveau."

msgid "I'm ready now. Please start a new conversation with me."
msgstr "Je suis prêt maintenant. Commencez une nouvelle conversation avec moi."

# The first-boot setup (wifi_voice.py, first_boot.py, #278).
msgid "Hi, I'm Teaport. Let's get me online. Give me a moment to look for networks."
msgstr "Bonjour, je suis Teaport. Connectons-moi à Internet. Un instant, je recherche les réseaux disponibles."

msgid "You can say \"set up Wi-Fi\" any time to try again."
msgstr "Vous pouvez dire « configure le Wi-Fi » à tout moment pour réessayer."

msgid "I'm online now, so I've left setup mode."
msgstr "Je suis maintenant en ligne, j'ai donc quitté le mode configuration."

# The sessions' own lines: busy / engine-unavailable, consult progress and tool acks (tools.py, agent_session.py).

msgid "Sorry, the voice assistant is busy with another session right now — please try again in a moment."
msgstr "Désolé, l'assistant vocal est occupé avec une autre session pour l'instant. Réessayez dans un instant."

msgid "Sorry, I can't hear you right now — my speech recognition isn't available. Please try again in a moment."
msgstr "Désolé, je ne vous entends pas pour l'instant : la reconnaissance vocale est indisponible. Réessayez dans un instant."

msgid "Still working on that — {topic}."
msgstr "Je travaille toujours dessus — {topic}."

msgid "Still working on it."
msgstr "Je travaille toujours dessus."

msgid "Almost there — {topic}."
msgstr "C'est presque fini — {topic}."

msgid "Almost there — hang tight."
msgstr "C'est presque fini, un instant encore."

msgid "Looking up {q}."
msgstr "Je cherche {q}."

msgid "Opening that page."
msgstr "J'ouvre la page."

msgid "I'll work on that — give me a moment."
msgstr "Je m'en occupe, un instant."

msgid "One moment, let me set that up."
msgstr "Un instant, je prépare cela."

# Settings from the phone and the AI account (settings_access.py, ai_account.py, config_ui.py, wifi_setup.py, #279).
msgid "AI account"
msgstr "Compte IA"

msgid "AI account (optional)"
msgstr "Compte IA (facultatif)"

msgid "An account is connected."
msgstr "Un compte est connecté."

msgid "Ask Teaport for a new one: say \"open my settings\"."
msgstr "Demandez-en un nouveau à Teaport : dites « ouvre les réglages »."

msgid "Checking the key…"
msgstr "Vérification de la clé…"

msgid "Code"
msgstr "Code"

msgid "Continue"
msgstr "Continuer"

msgid "Enter the code Teaport gave you. It works once."
msgstr "Saisissez le code que Teaport vous a donné. Il ne fonctionne qu'une fois."

msgid "I can't answer questions yet, because the account I use for my answers isn't set up. Say \"open my settings\" to set it up."
msgstr "Je ne peux pas encore répondre aux questions : le compte qui me sert pour mes réponses reste à configurer. Dites « ouvre les réglages » pour le configurer."

msgid "I couldn't use the AI account key you entered, so I didn't save it. Say \"open my settings\" to try again."
msgstr "Je n’ai pas pu utiliser la clé de compte IA que vous avez saisie, je ne l’ai donc pas enregistrée. Dites « ouvre les réglages » pour réessayer."

msgid "I need to be online for that. Say \"set up Wi-Fi\" to get me online."
msgstr "Pour cela, il me faut Internet. Dites « configure le Wi-Fi » pour me connecter à Internet."

msgid "I've put a code on my screen. Scan it with your phone's camera, then tap the link that appears to get to my settings."
msgstr "J'ai affiché un code sur mon écran. Scannez-le avec l'appareil photo de votre téléphone, puis touchez le lien qui apparaît pour accéder à mes réglages."

msgid "If your phone warns that the connection is not private, install {certificate} first, then ask Teaport for a new code."
msgstr "Si votre téléphone indique que la connexion n'est pas privée, installez d'abord {certificate}, puis demandez un nouveau code à Teaport."

msgid "If your phone warns that this page is not private, here is how to trust Teaport."
msgstr "Si votre téléphone indique que cette page n'est pas privée, voici comment faire confiance à Teaport."

msgid "In your phone's browser, go to {address}, and enter the code {code}. It works once, for the next five minutes."
msgstr "Dans le navigateur de votre téléphone, allez à l'adresse {address} et saisissez le code {code}. Il ne fonctionne qu'une fois, pendant les cinq prochaines minutes."

msgid "Leave this empty to keep the account Teaport has now. To use your own OpenRouter account, paste its key here. Teaport checks the key once it's online, and says out loud whether it worked."
msgstr "Laissez ce champ vide pour garder le compte que Teaport utilise actuellement. Pour utiliser votre propre compte OpenRouter, collez sa clé ici. Teaport vérifie la clé dès qu'il est en ligne et vous dit à voix haute si elle fonctionne."

msgid "No account is connected yet."
msgstr "Aucun compte n'est encore connecté."

msgid "OpenRouter key"
msgstr "Clé OpenRouter"

msgid "Save anyway"
msgstr "Enregistrer quand même"

msgid "Settings"
msgstr "Réglages"

msgid "Show advanced"
msgstr "Afficher les options avancées"

msgid "Sorry, my settings can't be reached from a phone on this box."
msgstr "Désolé, sur cet appareil, mes réglages ne sont pas accessibles depuis un téléphone."

msgid "Tap Continue to get to Teaport's settings on this phone. The code works once."
msgstr "Touchez Continuer pour accéder aux réglages de Teaport sur ce téléphone. Le code ne fonctionne qu'une fois."

msgid "Teaport couldn't check this key: {reason}."
msgstr "Teaport n'a pas pu vérifier cette clé : {reason}."

msgid "Teaport uses an OpenRouter account for its answers. To use your own, paste a key from your OpenRouter account."
msgstr "Teaport utilise un compte OpenRouter pour ses réponses. Pour utiliser le vôtre, collez une clé de votre compte OpenRouter."

msgid "Teaport's certificate"
msgstr "le certificat de Teaport"

msgid "Test and save"
msgstr "Tester et enregistrer"

msgid "That code didn't work. Check it, or ask Teaport for a new one."
msgstr "Ce code n'a pas fonctionné. Vérifiez-le, ou demandez-en un nouveau à Teaport."

msgid "The key works, and it's saved. Teaport uses it from your next conversation."
msgstr "La clé fonctionne et elle est enregistrée. Teaport l'utilisera dès votre prochaine conversation."

msgid "This code has expired"
msgstr "Ce code a expiré"

msgid "This code was already used"
msgstr "Ce code a déjà été utilisé"

msgid "This key didn't work: {reason}."
msgstr "Cette clé n'a pas fonctionné : {reason}."

msgid "Your AI account is connected."
msgstr "Votre compte IA est connecté."

msgid "no AI service is set up on this box"
msgstr "aucun service d'IA n'est configuré sur cet appareil"

