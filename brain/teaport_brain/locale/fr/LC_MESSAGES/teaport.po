msgstr "^\\W*(?:(?:euh|heu|hum|bah|teaport|ok|okay|d['’]accord|alors|bon|et|s['’ ]?il (?:te|vous) pla[iî]t|stp|svp)\\W+){0,3}(?:ouvr(?:e|ez|ir)|affich(?:e|ez|er)|montr(?:e|ez|er)|va|allez|aller|acc[eé]d(?:e|ez|er))(?:[- ](?:moi|nous))?(?: (?:aux|[àa]|dans|sur))? (?:(?:les|tes|vos|mes|ses|la|le|ta|votre|ma|sa|ton|mon) )?(?:(?:page|menu|[ée]cran) (?:des|de|du) (?:(?:mes|tes|vos|ses) )?)?(?:r[ée]glages|param[eèé]tres|configuration)(?= *(?:[.,!?;:…]|$)| (?:s['’ ]?il (?:te|vous) pla[iî]t|stp|svp|maintenant|de teaport)\\b)"

