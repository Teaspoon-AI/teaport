# the user means: start
msgctxt "pattern"
msgid "\\b(?:set ?up|setup|configure|connect to|join|change|switch)\\b(?: (?:the|a|my|your|to|new|another|different)){0,3} ?wi-?fi\\b|\\bwi-?fi (?:set ?up|setup)\\b"
msgstr "\\b(?:configur\\w*|connect\\w*|chang\\w*|install\\w*|régl\\w*)\\b(?: \\S+){0,3} ?wi-?fi\\b"

# the user means: yes
msgctxt "pattern"
msgid "\\b(?:yes|yeah|yep|sure|okay|ok|go ahead|do it|please|start)\\b"
msgstr "\\b(?:oui|ouais|d'accord|bien sûr|vas-y|allez-y|ok|okay|s'il te plaît|s'il vous plaît)\\b"

# the user means: no
msgctxt "pattern"
msgid "\\b(?:no|nope|don't|do not|never ?mind|cancel|stop)\\b"
msgstr "\\b(?:non|laisse tomber|annule\\w*|pas maintenant)\\b"

# the user means: cancel
msgctxt "pattern"
msgid "\\b(?:cancel|stop|quit|exit|abort|never ?mind)\\b"
msgstr "\\b(?:annule\\w*|arrête\\w*|stop|laisse tomber|quitte\\w*)\\b"

# the user means: repeat
msgctxt "pattern"
msgid "\\b(?:repeat|again|what was|what's the|password|network name|say that)\\b"
msgstr "(?:\\brépète\\w*|\\brepete\\w*|\\bencore\\b|\\bde nouveau\\b|c'était quoi|\\bmot de passe\\b|\\bnom du réseau\\b)"
